/* ── 容器 ── */
.container {
  width: 100%;
  height: 100vh;
  background: #010409;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ── 页头 ── */
.header {
  padding: 16px 16px 8px;
  flex-shrink: 0;
}
.header-title {
  font-size: 20px;
  font-weight: bold;
  color: #e6edf3;
  display: block;
}
.header-sub {
  font-size: 12px;
  color: #8b949e;
  margin-top: 4px;
}

/* ── 标签栏 ── */
.tab-bar {
  display: flex;
  margin: 8px 12px;
  border: 1px solid #21262d;
  border-radius: 8px;
  overflow: hidden;
  flex-shrink: 0;
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 0;
  background: #0d1117;
  transition: background 0.2s;
}
.tab.active {
  background: #161b22;
  border-bottom: 2px solid #58a6ff;
}
.tab-text {
  font-size: 14px;
  color: #8b949e;
}
.tab.active .tab-text {
  color: #58a6ff;
  font-weight: bold;
}
.tab-count {
  font-size: 11px;
  color: #484f58;
  background: #21262d;
  padding: 2px 8px;
  border-radius: 10px;
}
.tab.active .tab-count {
  color: #58a6ff;
  background: rgba(88, 166, 255, 0.15);
}

/* ── Bank 列表 ── */
.bank-list {
  flex: 1;
  padding: 0 12px 8px;
}

.bank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 14px;
  margin-bottom: 6px;
  background: #0d1117;
  border: 1px solid #161b22;
  border-radius: 8px;
  transition: border-color 0.15s;
}
.bank-item:active {
  border-color: #1f6feb;
}

/* 纯数据 bank */
.bank-item.pure-data {
  border-left: 3px solid #238636;
}

/* 低利用率 */
.bank-item.low-use {
  opacity: 0.65;
}

/* FIXED bank */
.bank-item.fixed-bank {
  border-left: 3px solid #d29922;
}
/* CHR bank */
.chr-item {
  border-left: 3px solid #a371f7;
}

/* ── 左侧信息 ── */
.bank-left {
  flex: 1;
  overflow: hidden;
  margin-right: 10px;
}
.bank-id {
  display: flex;
  align-items: center;
  gap: 8px;
}
.bank-type-icon {
  font-size: 16px;
}
.bank-label {
  font-size: 14px;
  font-weight: 600;
  color: #e6edf3;
}
.bank-cpu {
  font-size: 11px;
  color: #58a6ff;
  background: rgba(88, 166, 255, 0.1);
  padding: 1px 6px;
  border-radius: 4px;
  font-family: monospace;
}
.bank-desc {
  font-size: 12px;
  color: #8b949e;
  margin-top: 4px;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bank-flags {
  display: flex;
  gap: 4px;
  margin-top: 6px;
  flex-wrap: wrap;
}
.flag {
  font-size: 10px;
  color: #c9d1d9;
  background: #21262d;
  padding: 1px 6px;
  border-radius: 3px;
}

/* ── 右侧统计 ── */
.bank-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  flex-shrink: 0;
  min-width: 80px;
}
.mini-bar {
  width: 80px;
  height: 6px;
  background: #161b22;
  border-radius: 3px;
  overflow: hidden;
  display: flex;
}
.mini-seg.code {
  background: #58a6ff;
  height: 100%;
  position: relative;
}
.mini-seg.data {
  background: #3fb950;
  height: 100%;
  position: relative;
}
.mini-label {
  display: none;
}
.bank-stats {
  display: flex;
  gap: 6px;
}
.stat {
  font-size: 10px;
  font-family: monospace;
}
.code-stat { color: #58a6ff; }
.data-stat { color: #3fb950; }
.unacc-stat { color: #6e7681; }
.bank-arrow {
  font-size: 14px;
  color: #484f58;
}

/* ── CHR 预览 ── */
.chr-preview {
  padding: 4px 10px;
  background: #161b22;
  border-radius: 4px;
}
.chr-preview-num {
  font-size: 11px;
  color: #a371f7;
}

/* ── 底部 ── */
.footer {
  padding: 8px 16px;
  flex-shrink: 0;
  background: #0d1117;
  border-top: 1px solid #161b22;
}
.footer-text {
  font-size: 11px;
  color: #484f58;
  text-align: center;
  display: block;
}
