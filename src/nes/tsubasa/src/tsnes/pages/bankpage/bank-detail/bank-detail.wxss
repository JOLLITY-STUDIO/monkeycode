/* ── 容器 ── */
.container {
  width: 100%;
  height: 100vh;
  background: #010409;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ── 页头 ── */
.detail-header {
  padding: 12px 14px;
  flex-shrink: 0;
  border-bottom: 1px solid #161b22;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.bank-title {
  font-size: 18px;
  font-weight: bold;
  color: #e6edf3;
}
.bank-cpu {
  font-size: 11px;
  color: #58a6ff;
  background: rgba(88, 166, 255, 0.1);
  padding: 2px 8px;
  border-radius: 4px;
  font-family: monospace;
}
.bank-desc {
  font-size: 12px;
  color: #8b949e;
  margin-top: 4px;
  display: block;
}

/* ── 统计条 ── */
.stats-bar {
  display: flex;
  gap: 2px;
  margin-top: 10px;
  height: 20px;
  background: #161b22;
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}
.stat-item {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  min-width: 0;
}
.code-stat { background: rgba(88, 166, 255, 0.3); }
.data-stat { background: rgba(63, 185, 80, 0.3); }
.unacc-stat { background: rgba(110, 118, 129, 0.2); }
.stat-bar {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
}
.code-stat .stat-bar { background: #58a6ff; }
.data-stat .stat-bar { background: #3fb950; }
.unacc-stat .stat-bar { background: #6e7681; }
.stat-text {
  font-size: 10px;
  color: #e6edf3;
  z-index: 1;
  white-space: nowrap;
  padding: 0 6px;
  font-family: monospace;
}

/* ── 视图切换 ── */
.view-tabs {
  display: flex;
  margin: 8px 12px;
  gap: 6px;
  flex-shrink: 0;
}
.view-tab {
  padding: 6px 16px;
  font-size: 13px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.view-tab.active {
  color: #58a6ff;
  border-color: #58a6ff;
  background: rgba(88, 166, 255, 0.1);
}

/* ── 视图内容 ── */
.view-content {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ── HEX 视图 ── */
.hex-scroll {
  height: 100%;
  padding: 0 8px;
}
.hex-line {
  display: flex;
  padding: 1px 4px;
  font-family: 'Courier New', Courier, monospace;
  font-size: 11px;
  line-height: 1.6;
  color: #c9d1d9;
}
.hex-addr {
  color: #6e7681;
  margin-right: 8px;
  flex-shrink: 0;
  min-width: 44px;
}
.hex-data {
  color: #e6edf3;
  white-space: pre;
}

/* ── 柱状图 ── */
.histo-wrap {
  width: 100%;
  padding: 8px;
  box-sizing: border-box;
}
.histo-canvas {
  width: 100%;
  height: 300px;
  border-radius: 8px;
  background: #0d1117;
}
.histo-hint {
  display: block;
  text-align: center;
  font-size: 11px;
  color: #484f58;
  padding: 6px;
}

/* ── CHR 图块 ── */
.chr-wrap {
  flex: 1;
  overflow: hidden;
  min-width: 0;
  position: relative;
}
.chr-scroll {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  white-space: nowrap;
}
.chr-canvas {
  display: block;
  image-rendering: pixelated; /* 保持原始像素边缘锐利 */
}
.chr-hint {
  display: block;
  text-align: center;
  font-size: 11px;
  color: #484f58;
  padding: 6px;
  flex-shrink: 0;
}

/* ── 图块视图工具栏 ── */
.tile-toolbar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  background: #0d1117;
  border-bottom: 1px solid #161b22;
  flex-shrink: 0;
}
.tile-toolbar-label {
  font-size: 11px;
  color: #6e7681;
  flex-shrink: 0;
  font-weight: bold;
  min-width: 50px;
}

/* 模式切换按钮（查看图块 / 数据映射） */
.tile-mode-btn {
  padding: 4px 14px;
  font-size: 12px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.tile-mode-btn.active {
  color: #d29922;
  border-color: #d29922;
  background: rgba(210, 153, 34, 0.12);
  font-weight: bold;
}

/* CHR Bank 横向选择器 */
.chr-bank-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  height: 28px;
}
.chr-bank-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32px;
  height: 26px;
  margin-right: 4px;
  padding: 0 8px;
  font-size: 12px;
  font-family: monospace;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 4px;
  flex-shrink: 0;
}
.chr-bank-btn.active {
  color: #58a6ff;
  border-color: #58a6ff;
  background: rgba(88, 166, 255, 0.15);
  font-weight: bold;
}

/* PT 模式切换栏 */
.pt-mode-bar {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  background: #0d1117;
  border-bottom: 1px solid #161b22;
  flex-shrink: 0;
}
.pt-mode-btn {
  padding: 3px 10px;
  font-size: 11px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 4px;
}
.pt-mode-btn.active {
  color: #3fb950;
  border-color: #3fb950;
  background: rgba(63, 185, 80, 0.1);
  font-weight: bold;
}

/* ── 数据类型标签 ── */
.data-class-tag {
  display: inline-block;
  margin-top: 6px;
  padding: 2px 10px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: bold;
}
.class-render { color: #d29922; background: rgba(210, 153, 34, 0.12); }
.class-game { color: #3fb950; background: rgba(63, 185, 80, 0.12); }
.class-text { color: #58a6ff; background: rgba(88, 166, 255, 0.12); }
.data-class-hint {
  display: block;
  font-size: 11px;
  color: #6e7681;
  margin-top: 4px;
  line-height: 1.4;
}

/* ── 记录视图 ── */
.record-modes {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  padding: 6px 10px;
  background: #0d1117;
  border-bottom: 1px solid #161b22;
}
.rmode-tab {
  padding: 3px 10px;
  font-size: 11px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 4px;
}
.rmode-tab.active {
  color: #58a6ff;
  border-color: #58a6ff;
  background: rgba(88, 166, 255, 0.1);
}
.rmode-auto-label {
  font-size: 10px;
  color: #484f58;
  margin-left: 6px;
}

/* 统计摘要 */
.record-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 2px;
  padding: 4px 10px;
  background: #0d1117;
  border-bottom: 1px solid #161b22;
}
.rstat {
  font-size: 10px;
  color: #6e7681;
  font-family: monospace;
}

/* 渲染提示 */
.render-hint {
  padding: 6px 10px;
  background: rgba(210, 153, 34, 0.08);
  border-bottom: 1px solid rgba(210, 153, 34, 0.15);
}
.render-hint text {
  font-size: 11px;
  color: #d29922;
}

/* 记录列表 */
.record-scroll {
  flex: 1;
  height: 100%;
  padding: 4px 8px;
}
.record-item {
  margin-bottom: 8px;
  padding: 6px 8px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.rec-offset {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 2px;
}
.rec-addr {
  font-size: 11px;
  font-weight: bold;
  color: #58a6ff;
  font-family: monospace;
}
.rec-len {
  font-size: 10px;
  color: #484f58;
}
.rec-hex {
  margin: 2px 0;
}
.rec-hex text {
  font-size: 10px;
  font-family: 'Courier New', Courier, monospace;
  color: #c9d1d9;
  line-height: 1.5;
  word-break: break-all;
}
.rec-vals {
  margin-top: 2px;
  display: flex;
  align-items: flex-start;
  gap: 4px;
}
.rec-val-label {
  font-size: 10px;
  color: #484f58;
  flex-shrink: 0;
}
.rec-val-num {
  font-size: 10px;
  font-family: monospace;
  color: #7ee787;
  word-break: break-all;
}
.rec-ascii {
  margin-top: 2px;
  display: flex;
  align-items: flex-start;
  gap: 4px;
}
.rec-ascii-label {
  font-size: 10px;
  color: #484f58;
  flex-shrink: 0;
}
.rec-ascii-text {
  font-size: 10px;
  font-family: monospace;
  color: #d2a8ff;
  word-break: break-all;
}
