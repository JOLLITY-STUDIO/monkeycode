/* ── 容器 ── */
.container {
  width: 100%;
  height: 100vh;
  background: #010409;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ── 页头 ── */
.detail-header {
  padding: 12px 14px;
  flex-shrink: 0;
  border-bottom: 1px solid #161b22;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.bank-title {
  font-size: 18px;
  font-weight: bold;
  color: #e6edf3;
}
.bank-cpu {
  font-size: 11px;
  color: #58a6ff;
  background: rgba(88, 166, 255, 0.1);
  padding: 2px 8px;
  border-radius: 4px;
  font-family: monospace;
}
.bank-desc {
  font-size: 12px;
  color: #8b949e;
  margin-top: 4px;
  display: block;
}

/* ── 统计条 ── */
.stats-bar {
  display: flex;
  gap: 2px;
  margin-top: 10px;
  height: 20px;
  background: #161b22;
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}
.stat-item {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  min-width: 0;
}
.code-stat { background: rgba(88, 166, 255, 0.3); }
.data-stat { background: rgba(63, 185, 80, 0.3); }
.unacc-stat { background: rgba(110, 118, 129, 0.2); }
.stat-bar {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
}
.code-stat .stat-bar { background: #58a6ff; }
.data-stat .stat-bar { background: #3fb950; }
.unacc-stat .stat-bar { background: #6e7681; }
.stat-text {
  font-size: 10px;
  color: #e6edf3;
  z-index: 1;
  white-space: nowrap;
  padding: 0 6px;
  font-family: monospace;
}

/* ── 视图切换 ── */
.view-tabs {
  display: flex;
  margin: 8px 12px;
  gap: 6px;
  flex-shrink: 0;
}
.view-tab {
  padding: 6px 16px;
  font-size: 13px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.view-tab.active {
  color: #58a6ff;
  border-color: #58a6ff;
  background: rgba(88, 166, 255, 0.1);
}

/* ── 视图内容 ── */
.view-content {
  flex: 1;
  overflow: hidden;
}

/* ── HEX 视图 ── */
.hex-scroll {
  height: 100%;
  padding: 0 8px;
}
.hex-line {
  display: flex;
  padding: 1px 4px;
  font-family: 'Courier New', Courier, monospace;
  font-size: 11px;
  line-height: 1.6;
  color: #c9d1d9;
}
.hex-addr {
  color: #6e7681;
  margin-right: 8px;
  flex-shrink: 0;
  min-width: 44px;
}
.hex-data {
  color: #e6edf3;
  white-space: pre;
}

/* ── 柱状图 ── */
.histo-wrap {
  width: 100%;
  padding: 8px;
  box-sizing: border-box;
}
.histo-canvas {
  width: 100%;
  height: 300px;
  border-radius: 8px;
  background: #0d1117;
}
.histo-hint {
  display: block;
  text-align: center;
  font-size: 11px;
  color: #484f58;
  padding: 6px;
}

/* ── CHR 图块 ── */
.chr-wrap {
  flex: 1;
  overflow: hidden;
}
.chr-scroll {
  height: 100%;
}
.chr-canvas {
  width: 100%;
  display: block;
}
.chr-hint {
  display: block;
  text-align: center;
  font-size: 11px;
  color: #484f58;
  padding: 6px;
  flex-shrink: 0;
}
