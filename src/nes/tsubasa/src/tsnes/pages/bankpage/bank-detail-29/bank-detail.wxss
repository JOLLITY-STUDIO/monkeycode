/* ── 容器 ── */
.container {
  width: 100%;
  height: 100vh;
  background: #010409;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ── 页头 ── */
.detail-header {
  padding: 12px 14px;
  flex-shrink: 0;
  border-bottom: 1px solid #161b22;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.bank-title {
  font-size: 18px;
  font-weight: bold;
  color: #e6edf3;
  flex-shrink: 0;
}
.bank-name {
  font-size: 14px;
  font-weight: 600;
  color: #d29922;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}
.bank-cpu {
  font-size: 11px;
  color: #58a6ff;
  background: rgba(88, 166, 255, 0.1);
  padding: 2px 8px;
  border-radius: 4px;
  font-family: monospace;
  flex-shrink: 0;
}
.bank-desc {
  font-size: 12px;
  color: #8b949e;
  margin-top: 4px;
  display: block;
}

/* ── 统计条 ── */
.stats-bar {
  display: flex;
  gap: 2px;
  margin-top: 10px;
  height: 20px;
  background: #161b22;
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}
.stat-item {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  min-width: 0;
}
.code-stat { background: rgba(88, 166, 255, 0.3); }
.data-stat { background: rgba(63, 185, 80, 0.3); }
.unacc-stat { background: rgba(110, 118, 129, 0.2); }
.stat-bar {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
}
.code-stat .stat-bar { background: #58a6ff; }
.data-stat .stat-bar { background: #3fb950; }
.unacc-stat .stat-bar { background: #6e7681; }
.stat-text {
  font-size: 10px;
  color: #e6edf3;
  z-index: 1;
  white-space: nowrap;
  padding: 0 6px;
  font-family: monospace;
}

/* ── 视图切换 ── */
.view-tabs {
  display: flex;
  margin: 8px 12px;
  gap: 6px;
  flex-shrink: 0;
}
.view-tab {
  padding: 6px 16px;
  font-size: 13px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.view-tab.active {
  color: #58a6ff;
  border-color: #58a6ff;
  background: rgba(88, 166, 255, 0.1);
}

/* ── 视图内容 ── */
.view-content {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ── HEX 视图 ── */
.hex-scroll {
  height: 100%;
  padding: 0 8px;
}
.hex-line {
  display: flex;
  padding: 1px 4px;
  font-family: 'Courier New', Courier, monospace;
  font-size: 11px;
  line-height: 1.6;
  color: #c9d1d9;
}
.hex-addr {
  color: #6e7681;
  margin-right: 8px;
  flex-shrink: 0;
  min-width: 44px;
}
.hex-data {
  color: #e6edf3;
  white-space: pre;
}

/* ── 柱状图 ── */
.histo-wrap {
  width: 100%;
  padding: 8px;
  box-sizing: border-box;
}
.histo-canvas {
  width: 100%;
  height: 300px;
  border-radius: 8px;
  background: #0d1117;
}
.histo-hint {
  display: block;
  text-align: center;
  font-size: 11px;
  color: #484f58;
  padding: 6px;
}

/* ── CHR 图块 ── */
.chr-wrap {
  flex: 1;
  overflow: hidden;
  min-width: 0;
  position: relative;
}
.chr-scroll {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  white-space: nowrap;
}
.chr-canvas {
  display: block;
  image-rendering: pixelated; /* 保持原始像素边缘锐利 */
}
.chr-hint {
  display: block;
  text-align: center;
  font-size: 11px;
  color: #484f58;
  padding: 6px;
  flex-shrink: 0;
}

/* ── 图块视图工具栏 ── */
.tile-toolbar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  background: #0d1117;
  border-bottom: 1px solid #161b22;
  flex-shrink: 0;
}
.tile-toolbar-label {
  font-size: 11px;
  color: #6e7681;
  flex-shrink: 0;
  font-weight: bold;
  min-width: 50px;
}

/* 模式切换按钮（查看图块 / 数据映射） */
.tile-mode-btn {
  padding: 4px 14px;
  font-size: 12px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.tile-mode-btn.active {
  color: #d29922;
  border-color: #d29922;
  background: rgba(210, 153, 34, 0.12);
  font-weight: bold;
}

/* CHR Bank 横向选择器 */
.chr-bank-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  height: 28px;
}
.chr-bank-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32px;
  height: 26px;
  margin-right: 4px;
  padding: 0 8px;
  font-size: 12px;
  font-family: monospace;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 4px;
  flex-shrink: 0;
}
.chr-bank-btn.active {
  color: #58a6ff;
  border-color: #58a6ff;
  background: rgba(88, 166, 255, 0.15);
  font-weight: bold;
}

/* PT 模式切换栏 */
.pt-mode-bar {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  background: #0d1117;
  border-bottom: 1px solid #161b22;
  flex-shrink: 0;
}
.pt-mode-btn {
  padding: 3px 10px;
  font-size: 11px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 4px;
}
.pt-mode-btn.active {
  color: #3fb950;
  border-color: #3fb950;
  background: rgba(63, 185, 80, 0.1);
  font-weight: bold;
}

/* ── 数据类型标签 ── */
.data-class-tag {
  display: inline-block;
  margin-top: 6px;
  padding: 2px 10px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: bold;
}
.class-render { color: #d29922; background: rgba(210, 153, 34, 0.12); }
.class-game { color: #3fb950; background: rgba(63, 185, 80, 0.12); }
.class-text { color: #58a6ff; background: rgba(88, 166, 255, 0.12); }
.data-class-hint {
  display: block;
  font-size: 11px;
  color: #6e7681;
  margin-top: 4px;
  line-height: 1.4;
}

/* ── 记录视图 ── */
.record-modes {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  padding: 6px 10px;
  background: #0d1117;
  border-bottom: 1px solid #161b22;
}
.rmode-tab {
  padding: 3px 10px;
  font-size: 11px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 4px;
}
.rmode-tab.active {
  color: #58a6ff;
  border-color: #58a6ff;
  background: rgba(88, 166, 255, 0.1);
}
.rmode-auto-label {
  font-size: 10px;
  color: #484f58;
  margin-left: 6px;
}

/* 统计摘要 */
.record-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 2px;
  padding: 4px 10px;
  background: #0d1117;
  border-bottom: 1px solid #161b22;
}
.rstat {
  font-size: 10px;
  color: #6e7681;
  font-family: monospace;
}

/* 渲染提示 */
.render-hint {
  padding: 6px 10px;
  background: rgba(210, 153, 34, 0.08);
  border-bottom: 1px solid rgba(210, 153, 34, 0.15);
}
.render-hint text {
  font-size: 11px;
  color: #d29922;
}

/* 记录列表 */
.record-scroll {
  flex: 1;
  height: 100%;
  padding: 4px 8px;
}
.record-item {
  margin-bottom: 8px;
  padding: 6px 8px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.rec-offset {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 2px;
}
.rec-addr {
  font-size: 11px;
  font-weight: bold;
  color: #58a6ff;
  font-family: monospace;
}
.rec-len {
  font-size: 10px;
  color: #484f58;
}
.rec-hex {
  margin: 2px 0;
}
.rec-hex text {
  font-size: 10px;
  font-family: 'Courier New', Courier, monospace;
  color: #c9d1d9;
  line-height: 1.5;
  word-break: break-all;
}
.rec-vals {
  margin-top: 2px;
  display: flex;
  align-items: flex-start;
  gap: 4px;
}
.rec-val-label {
  font-size: 10px;
  color: #484f58;
  flex-shrink: 0;
}
.rec-val-num {
  font-size: 10px;
  font-family: monospace;
  color: #7ee787;
  word-break: break-all;
}
.rec-ascii {
  margin-top: 2px;
  display: flex;
  align-items: flex-start;
  gap: 4px;
}
.rec-ascii-label {
  font-size: 10px;
  color: #484f58;
  flex-shrink: 0;
}
.rec-ascii-text {
  font-size: 10px;
  font-family: monospace;
  color: #d2a8ff;
  word-break: break-all;
}

/* ── Bank 07 专用：记录头信息 ── */
.rec-ptr {
  font-size: 10px;
  color: #d29922;
  font-family: monospace;
  margin-left: 8px;
  font-weight: bold;
}
.rec-header-info {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 2px;
  padding: 2px 6px;
  background: rgba(210, 153, 34, 0.08);
  border-radius: 4px;
}
.rec-header-type {
  font-size: 10px;
  color: #d29922;
  font-weight: bold;
}
.rec-header-tiles {
  font-size: 10px;
  color: #8b949e;
  font-family: monospace;
}

/* 高亮 stat */
.rstat-hl {
  color: #d29922;
  font-weight: bold;
}

/* ── 场地视图 (Bank 07) ── */
.field-toolbar {
  padding: 6px 10px;
  background: #0d1117;
  border-bottom: 1px solid #161b22;
  flex-shrink: 0;
}
.field-hint {
  font-size: 11px;
  color: #6e7681;
}
.field-scroll {
  flex: 1;
  height: 100%;
}
.field-image {
  display: block;
  image-rendering: pixelated;
}
.field-loading {
  text-align: center;
  padding: 40px;
  color: #6e7681;
  font-size: 13px;
}
.field-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1px;
  height: 1px;
}

/* ── Bank 02 结构/函数/调试视图 ── */
.b02-toolbar {
  padding: 8px 12px;
  background: #0d1117;
  border-bottom: 1px solid #161b22;
  flex-shrink: 0;
}
.b02-hint {
  font-size: 11px;
  color: #6e7681;
}
.b02-scroll {
  flex: 1;
  height: 100%;
  padding: 8px 12px;
}
.b02-section {
  margin-bottom: 14px;
  padding: 10px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 8px;
}
.b02-section-title {
  display: block;
  font-size: 12px;
  font-weight: bold;
  color: #58a6ff;
  margin-bottom: 8px;
}
.b02-stats {
  display: flex;
  gap: 10px;
  margin-bottom: 8px;
}
.b02-stat {
  font-size: 11px;
  font-family: monospace;
  padding: 4px 8px;
  border-radius: 4px;
}
.b02-stat.code { color: #58a6ff; background: rgba(88,166,255,0.1); }
.b02-stat.data { color: #3fb950; background: rgba(63,185,80,0.1); }
.b02-stat.unacc { color: #8b949e; background: rgba(110,118,129,0.15); }
.b02-note {
  font-size: 10px;
  color: #8b949e;
  line-height: 1.4;
}
.struct-image {
  display: block;
  image-rendering: pixelated;
  border-radius: 6px;
  margin-top: 6px;
}

/* 函数列表 */
.func-list {
  margin-bottom: 12px;
}
.func-item {
  padding: 8px 10px;
  margin-bottom: 6px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.func-item:active { background: #1f242c; }
.func-name {
  display: block;
  font-size: 12px;
  color: #e6edf3;
  font-weight: bold;
}
.func-meta {
  display: block;
  font-size: 10px;
  color: #8b949e;
  font-family: monospace;
  margin-top: 2px;
}
.func-detail {
  display: block;
  font-size: 11px;
  color: #c9d1d9;
  font-family: monospace;
  margin-bottom: 4px;
}
.data-table-item {
  padding: 6px 0;
  border-bottom: 1px solid #21262d;
}
.data-table-name {
  font-size: 10px;
  color: #c9d1d9;
  font-family: monospace;
}

/* 调试 */
.debug-mode-bar {
  display: flex;
  gap: 6px;
}
.debug-mode {
  padding: 4px 12px;
  font-size: 12px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.debug-mode.active {
  color: #d29922;
  border-color: #d29922;
  background: rgba(210,153,34,0.12);
}
.debug-panel {
  margin-bottom: 12px;
}
.debug-row {
  display: flex;
  gap: 8px;
  margin-bottom: 8px;
}
.debug-field {
  flex: 1;
}
.debug-label {
  display: block;
  font-size: 10px;
  color: #8b949e;
  margin-bottom: 4px;
}
.debug-input {
  height: 32px;
  padding: 0 8px;
  background: #0d1117;
  border: 1px solid #21262d;
  border-radius: 4px;
  color: #e6edf3;
  font-size: 12px;
  font-family: monospace;
}
.debug-hint {
  display: block;
  font-size: 10px;
  color: #6e7681;
  margin-top: 6px;
}
.debug-run-btn {
  margin: 10px 0;
  padding: 10px;
  text-align: center;
  font-size: 13px;
  color: #fff;
  background: #238636;
  border-radius: 6px;
}
.debug-run-btn:active { background: #2ea043; }
.debug-result {
  padding: 10px;
  background: #0d1117;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.debug-result-title {
  display: block;
  font-size: 11px;
  color: #7ee787;
  margin-bottom: 6px;
  font-weight: bold;
}
.debug-result-text {
  font-size: 11px;
  color: #c9d1d9;
  font-family: monospace;
  line-height: 1.5;
  white-space: pre-wrap;
}

/* ── A72C 文档区 ── */
.debug-doc-section {
  padding: 8px 10px;
  background: rgba(210,153,34,0.08);
  border: 1px solid rgba(210,153,34,0.15);
  border-radius: 6px;
  margin-bottom: 10px;
}
.debug-doc-title {
  display: block;
  font-size: 11px;
  color: #d29922;
  font-weight: bold;
  margin-bottom: 4px;
}
.debug-doc-text {
  font-size: 10px;
  color: #8b949e;
  line-height: 1.5;
}

/* ── A72C 预设按钮 ── */
.debug-preset-bar {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}
.debug-preset-label {
  font-size: 10px;
  color: #6e7681;
  margin-right: 4px;
  flex-shrink: 0;
}
.debug-preset {
  padding: 3px 10px;
  font-size: 11px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 4px;
}
.debug-preset.active {
  color: #58a6ff;
  border-color: #58a6ff;
  background: rgba(88,166,255,0.1);
}

/* ── A72C 双输入框行 ── */
.debug-input-row {
  display: flex;
  gap: 4px;
}
.debug-input-half {
  flex: 1;
  min-width: 0;
}

/* ── A72C NT 版面可视化 ── */
.debug-canvas-section {
  margin-top: 12px;
}
.debug-section-title {
  display: block;
  font-size: 12px;
  color: #7ee787;
  font-weight: bold;
  margin-bottom: 4px;
}
.a72c-nt-image {
  display: block;
  border-radius: 6px;
  image-rendering: pixelated;
  margin-top: 4px;
}

/* 数据表选择器 */
.dtable-selector {
  max-height: 240px;
  margin: 8px 0;
  border: 1px solid #21262d;
  border-radius: 6px;
  background: #0d1117;
}
.dtable-item {
  padding: 6px 10px;
  border-bottom: 1px solid #161b22;
  display: flex;
  align-items: center;
  gap: 8px;
}
.dtable-item.active {
  background: rgba(88, 166, 255, 0.1);
  border-color: #58a6ff;
}
.dtable-idx {
  font-size: 11px;
  color: #6e7681;
  font-family: monospace;
  min-width: 24px;
}
.dtable-name {
  font-size: 11px;
  color: #c9d1d9;
  font-family: monospace;
  flex: 1;
}
.dtable-hex {
  font-size: 10px;
  line-height: 1.6;
}

/* ── 🧬 结构化数据视图 ── */
.data-schema-table {
  margin: 0 0 16px 0;
  background: #0d1117;
  border: 1px solid #21262d;
  border-radius: 8px;
  overflow: hidden;
}
.schema-header {
  padding: 10px 12px;
  background: #161b22;
  border-bottom: 1px solid #30363d;
}
.schema-name {
  font-size: 13px;
  font-weight: 600;
  color: #58a6ff;
  display: block;
}
.schema-meta {
  font-size: 10px;
  color: #6e7681;
  font-family: monospace;
  display: block;
  margin-top: 2px;
}
.schema-fields {
  padding: 8px 0;
}
.schema-field {
  display: flex;
  align-items: center;
  padding: 5px 12px;
  border-bottom: 1px solid #161b22;
  gap: 8px;
}
.schema-field:last-child { border-bottom: none; }
.sf-name {
  font-size: 11px;
  color: #ffa657;
  font-family: monospace;
  min-width: 80px;
  flex-shrink: 0;
}
.sf-desc {
  font-size: 10px;
  color: #8b949e;
  flex: 1;
}
.sf-value {
  font-size: 11px;
  color: #7ee787;
  font-family: monospace;
  text-align: right;
  flex-shrink: 0;
  max-width: 180px;
  word-break: break-all;
}

/* 记录表格 */
.schema-records {
  padding: 6px 12px 10px 12px;
  border-top: 1px solid #30363d;
}
.schema-subtitle {
  font-size: 11px;
  color: #8b949e;
  display: block;
  margin-bottom: 6px;
}
.records-scroll {
  overflow-x: auto;
  white-space: nowrap;
  background: #0d1117;
  border: 1px solid #161b22;
  border-radius: 4px;
}
.rec-row {
  display: flex;
}
.rec-row.rec-header {
  background: #161b22;
  border-bottom: 1px solid #30363d;
}
.rec-cell {
  font-size: 10px;
  font-family: monospace;
  color: #c9d1d9;
  padding: 4px 8px;
  min-width: 44px;
  text-align: center;
  border-right: 1px solid #161b22;
}
.rec-row.rec-header .rec-cell {
  color: #58a6ff;
  font-weight: 600;
}
.rec-idx {
  color: #6e7681 !important;
  min-width: 24px !important;
}

/* 原始 hex */
.schema-raw {
  padding: 8px 12px;
  border-top: 1px solid #30363d;
  background: #010409;
}
.schema-raw-text {
  font-size: 10px;
  font-family: monospace;
  color: #6e7681;
  line-height: 1.7;
  word-break: break-all;
  user-select: text;
}

/* ── Bank 12 音频播放器 ── */
.audio-player-bar {
  padding: 10px 12px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 8px;
  margin-bottom: 12px;
}
.audio-player-controls {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}
.audio-btn {
  padding: 6px 14px;
  font-size: 12px;
  color: #8b949e;
  background: #0d1117;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.audio-btn.active {
  color: #7ee787;
  border-color: #7ee787;
  background: rgba(126, 231, 135, 0.12);
}
.audio-play-btn {
  color: #3fb950;
  border-color: #3fb950;
  background: rgba(63, 185, 80, 0.1);
  font-weight: bold;
}
.audio-btn.active {
  color: #7ee787;
  border-color: #7ee787;
  background: rgba(126, 231, 135, 0.12);
}
.audio-speed-bar {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: 12px;
}
.audio-speed-label {
  font-size: 10px;
  color: #6e7681;
}
.audio-speed {
  padding: 3px 8px;
  font-size: 10px;
  color: #6e7681;
  background: #0d1117;
  border: 1px solid #21262d;
  border-radius: 4px;
  font-family: monospace;
}
.audio-speed.active {
  color: #d29922;
  border-color: #d29922;
  background: rgba(210, 153, 34, 0.12);
}
.audio-progress {
  display: flex;
  align-items: center;
  gap: 8px;
}
.audio-progress-label {
  font-size: 10px;
  color: #6e7681;
  font-family: monospace;
  min-width: 60px;
}
.audio-progress-bar {
  flex: 1;
  height: 6px;
  background: #0d1117;
  border-radius: 3px;
  overflow: hidden;
}
.audio-progress-fill {
  height: 100%;
  background: #7ee787;
  border-radius: 3px;
  transition: width 0.1s;
}

/* ── 音轨列表选中高亮 ── */
.track-selected {
  background: rgba(63, 185, 80, 0.08) !important;
  border-left: 3px solid #3fb950 !important;
}

/* ── APU 5通道状态面板 ── */
.apu-panel {
  margin-bottom: 12px;
  padding: 10px 12px;
  background: #0d1117;
  border: 1px solid #21262d;
  border-radius: 8px;
}
.apu-panel-title {
  font-size: 11px;
  font-weight: bold;
  color: #58a6ff;
  margin-bottom: 8px;
}
.apu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.apu-col {
  flex: 1;
  min-width: 90px;
  max-width: 140px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
  overflow: hidden;
}
.apu-col-header {
  padding: 4px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.apu-col-header.ch-on {
  background: rgba(63, 185, 80, 0.12);
  border-bottom: 1px solid rgba(63, 185, 80, 0.2);
}
.apu-col-header.ch-off {
  background: rgba(72, 79, 88, 0.12);
  border-bottom: 1px solid rgba(72, 79, 88, 0.2);
}
.apu-ch-name {
  font-size: 12px;
  font-weight: bold;
  color: #e6edf3;
  font-family: monospace;
}
.apu-ch-reg {
  font-size: 9px;
  color: #6e7681;
  font-family: monospace;
  margin-top: 1px;
}
.apu-rows {
  padding: 4px 6px 6px 6px;
}
.apu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 2px 0;
}
.apu-row.apu-regs {
  justify-content: flex-start;
  padding: 3px 0 4px 0;
  margin-bottom: 2px;
  border-bottom: 1px solid #21262d;
}
.apu-regs-val {
  font-size: 9px;
  letter-spacing: 0.3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.apu-label {
  font-size: 9px;
  color: #6e7681;
  flex-shrink: 0;
}
.apu-val {
  font-size: 10px;
  font-family: monospace;
  text-align: right;
  flex-shrink: 0;
}
