<view class="game-container">
  <!-- 状态栏 -->
  <view class="status-bar">
    <text class="status-tag">天使之翼2 (H5)</text>
    <text class="status-text">{{status}}</text>
    <text class="fps-text" wx:if="{{pageMode === 'game'}}">FPS: {{fps}}</text>
    <text class="nt-scroll-text" wx:if="{{pageMode === 'nt_test'}}">scrollX: {{ntScrollX}}</text>
    <navigator url="/pages/bankpage/bankpage" class="data-btn">ROM</navigator>
  </view>

  <!-- 游戏画布区 -->
  <view class="canvas-area" id="canvas-area">
    <canvas 
      type="2d" 
      id="tsubasa2-canvas" 
      class="game-canvas"
      style="width: {{canvasStyleW}}px; height: {{canvasStyleH}}px;"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      disable-scroll="true"
    ></canvas>
  </view>

  <!-- 操作按钮栏 -->
  <view class="control-bar">
    <view class="ctrl-group" wx:if="{{pageMode === 'game'}}">
      <view class="ctrl-btn" bindtap="onBtnA">A</view>
      <view class="ctrl-btn" bindtap="onBtnB">B</view>
      <view class="ctrl-btn" bindtap="onBtnStart">START</view>
    </view>
    <view class="ctrl-group">
      <view class="ctrl-btn mini" bindtap="toggleDebug">&#x2699;</view>
      <view class="ctrl-btn mini ctrl-switch" bindtap="toggleScale">{{canvasScale === 1 ? 'fit' : '1x'}}</view>
      <view class="ctrl-btn mini {{aiMode ? 'active' : ''}}" bindtap="toggleAi" wx:if="{{pageMode === 'game'}}">AI</view>
      <!-- NT 测试 / 游戏切换 -->
      <view class="ctrl-btn ctrl-switch {{pageMode === 'nt_test' ? 'active' : ''}}" bindtap="{{pageMode === 'nt_test' ? 'switchToGame' : 'switchToNtTest'}}">
        {{pageMode === 'nt_test' ? '游戏' : 'NT测试'}}
      </view>
    </view>
  </view>

  <!-- 调试面板 -->
  <view class="debug-panel" wx:if="{{showDebug}}">
    <view class="debug-row">
      <text class="debug-label">帧:</text>
      <text class="debug-val">{{debugInfo.frame}}</text>
      <text class="debug-label">状态:</text>
      <text class="debug-val">{{debugInfo.gameStateName}}</text>
    </view>
    <view class="debug-row">
      <text class="debug-label">FPS:</text>
      <text class="debug-val">{{fps}}</text>
      <text class="debug-label">AI:</text>
      <text class="debug-val">{{aiMode ? 'ON' : 'OFF'}}</text>
    </view>
    <view class="debug-row" wx:if="{{pageMode === 'nt_test'}}">
      <text class="debug-label">NT0:</text>
      <text class="debug-val" style="color:#00aa00">绿色</text>
      <text class="debug-label">NT1:</text>
      <text class="debug-val" style="color:#0066ff">蓝色</text>
      <text class="debug-label">scrollX:</text>
      <text class="debug-val">{{ntScrollX}}</text>
    </view>
  </view>
</view>
