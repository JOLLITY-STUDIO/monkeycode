<view class="container">
  <!-- 标题 -->
  <view class="header">
    <text class="title">天使之翼II — BGM + SE 混合测试</text>
    <text class="subtitle">多 Tsubasa2AudioPlayer 实例 · 独立 PAPU · 加法混合</text>
  </view>

  <!-- 主按钮区 -->
  <view class="btn-grid" wx:if="{{ready}}">
    <view class="big-btn btn-bgm {{playing && playingLabel === 'BGM only' ? 'btn-active' : ''}}" bindtap="playBgm">
      <text class="big-btn-icon">🎵</text>
      <text class="big-btn-label">BGM</text>
      <text class="big-btn-desc">纯音乐播放</text>
    </view>

    <view class="big-btn btn-se {{playing && playingLabel === 'SE only' ? 'btn-active' : ''}}" bindtap="playSe">
      <text class="big-btn-icon">🔊</text>
      <text class="big-btn-label">SE</text>
      <text class="big-btn-desc">SQ2+NOISE 音效</text>
    </view>

    <view class="big-btn btn-both {{playing && playingLabel === 'BGM + SE' ? 'btn-active' : ''}}" bindtap="playBoth">
      <text class="big-btn-icon">🎶</text>
      <text class="big-btn-label">BGM+SE</text>
      <text class="big-btn-desc">两实例同时渲染</text>
    </view>
  </view>

  <!-- 停止按钮 -->
  <view class="stop-bar" wx:if="{{playing}}">
    <button class="btn-stop" bindtap="stopAudio">⏹ 停止</button>
  </view>

  <!-- 状态 -->
  <view class="status-card">
    <text class="status-text">{{status}}</text>
    <view class="info-row" wx:if="{{ready}}">
      <text class="info-text">BGM: {{bgmLen}} 采样 (~{{Math.round(bgmLen / 48000)}}s)</text>
      <text class="info-text">SE: {{seLen}} 采样 (~{{Math.round(seLen / 48000)}}s)</text>
    </view>
  </view>
</view>
