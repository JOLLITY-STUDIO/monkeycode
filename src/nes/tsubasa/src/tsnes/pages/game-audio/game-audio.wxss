.container {
  display: flex;
  flex-direction: column;
  padding: 16px;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(135deg, #0f0f23 0%, #1a1a3e 50%, #0d0d1f 100%);
}

.header {
  text-align: center;
  margin: 20px 0 16px;
}

.title {
  display: block;
  font-size: 18px;
  font-weight: 700;
  color: #e0e0ff;
  margin-bottom: 6px;
}

.subtitle {
  display: block;
  font-size: 12px;
  color: #8888aa;
}

.engine-card {
  width: 100%;
  background: rgba(255,255,255,0.06);
  border-radius: 10px;
  padding: 14px;
  margin: 8px 0;
  border: 1px solid rgba(255,255,255,0.08);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
}

.card-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 7px;
}

.emu-dot {
  background: #ffcc44;
  box-shadow: 0 0 4px #ffcc44;
}

.seq-dot {
  background: #44ccff;
  box-shadow: 0 0 4px #44ccff;
}

.card-title {
  font-size: 15px;
  font-weight: 700;
  color: #e0e0ff;
}

.card-desc {
  display: block;
  font-size: 11px;
  color: #8888aa;
  margin-bottom: 10px;
  line-height: 1.5;
}

.status-card {
  width: 100%;
  background: rgba(0,0,0,0.15);
  border-radius: 6px;
  padding: 12px;
  margin: 4px 0 10px;
  box-sizing: border-box;
}

.status-text {
  display: block;
  font-size: 15px;
  font-weight: 600;
  color: #ffcc44;
  margin-bottom: 5px;
}

.engine-card:nth-child(4) .status-text {
  color: #44ccff;
}

.info-text {
  display: block;
  font-size: 12px;
  color: #9999bb;
  line-height: 1.6;
}

.controls {
  display: flex;
  gap: 10px;
  margin: 4px 0 0;
}

.btn {
  flex: 1;
  height: 40px;
  line-height: 40px;
  text-align: center;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 600;
  border: none;
  padding: 0;
}

.btn-play {
  background: linear-gradient(135deg, #44bb66, #33aa55);
  color: #fff;
}

.btn-stop {
  background: linear-gradient(135deg, #ff6644, #dd5533);
  color: #fff;
}

.btn-restart {
  background: linear-gradient(135deg, #4488cc, #3377bb);
  color: #fff;
}

.tip {
  margin: 16px 0 32px;
  text-align: center;
}

.tip text {
  display: block;
  font-size: 11px;
  color: #666688;
  line-height: 1.8;
}
