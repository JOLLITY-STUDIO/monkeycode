.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #0f0f23 0%, #1a1a3e 50%, #0d0d1f 100%);
}

.header {
  text-align: center;
  margin: 40rpx 0 32rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #e0e0ff;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #8888aa;
}

.status-card {
  width: 660rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx 0;
  border: 1rpx solid rgba(255,255,255,0.08);
}

.status-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffcc44;
  margin-bottom: 12rpx;
}

.info-text {
  display: block;
  font-size: 24rpx;
  color: #9999bb;
  line-height: 1.6;
}

.controls {
  display: flex;
  gap: 20rpx;
  margin: 32rpx 0;
}

.btn {
  width: 220rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-play {
  background: linear-gradient(135deg, #44bb66, #33aa55);
  color: #fff;
}

.btn-stop {
  background: linear-gradient(135deg, #ff6644, #dd5533);
  color: #fff;
}

.btn-restart {
  background: linear-gradient(135deg, #4488cc, #3377bb);
  color: #fff;
}

.tip {
  margin-top: 48rpx;
  text-align: center;
}

.tip text {
  display: block;
  font-size: 22rpx;
  color: #666688;
  line-height: 1.8;
}
