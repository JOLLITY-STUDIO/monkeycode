<view class="container">
  <!-- 标题 -->
  <view class="header">
    <text class="title">天使之翼II — A/B APU 写入对比</text>
    <text class="subtitle">NES 模拟器 4500帧 vs TS 引擎 · 自动同步偏移 F{{syncOffset}}</text>
  </view>

  <!-- 对比结果 -->
  <view class="cmp-card" wx:if="{{cmpReady}}">
    <view class="cmp-header">
      <text class="cmp-title">APU 写入对比结果</text>
      <text class="cmp-score">匹配 {{matchFrames}} / {{matchFrames + diffFrames}} 帧</text>
    </view>
    <view class="cmp-stats">
      <view class="cmp-stat good">✓ 匹配: {{matchFrames}}</view>
      <view class="cmp-stat bad">✗ 差异: {{diffFrames}}</view>
    </view>
    <scroll-view scroll-y class="cmp-detail" wx:if="{{cmpResult}}">
      <text class="cmp-text">{{cmpResult}}</text>
    </scroll-view>
  </view>

  <!-- A/B 切换 -->
  <view class="mode-bar">
    <view class="mode-btn {{compareMode === 'ab' ? 'mode-active' : ''}}" bindtap="setCompareMode" data-mode="ab">
      混合 AB
    </view>
    <view class="mode-btn {{compareMode === 'a' ? 'mode-active' : ''}}" bindtap="setCompareMode" data-mode="a">
      仅 A
    </view>
    <view class="mode-btn {{compareMode === 'b' ? 'mode-active' : ''}}" bindtap="setCompareMode" data-mode="b">
      仅 B
    </view>
  </view>

  <!-- A 侧: NES 模拟器 -->
  <view class="side-card side-a">
    <view class="side-header">
      <view class="side-dot side-dot-a"></view>
      <text class="side-label">A: NES 模拟器 (CPU全仿真)</text>
      <text class="side-badge">{{emuTotalWrites}} APU写入</text>
    </view>
    <view class="wave-box">
      <canvas type="2d" id="waveA" class="wave-canvas" style="width:{{canvasWidth}}px; height:{{canvasHeight}}px;"></canvas>
    </view>
  </view>

  <!-- 分割线 -->
  <view class="divider">
    <view class="divider-line"></view>
    <text class="divider-text">VS</text>
    <view class="divider-line"></view>
  </view>

  <!-- B 侧: TS 引擎 -->
  <view class="side-card side-b">
    <view class="side-header">
      <view class="side-dot side-dot-b"></view>
      <text class="side-label">B: TS 引擎 (无CPU依赖)</text>
      <text class="side-badge editable">{{playerTotalWrites}} APU写入</text>
    </view>
    <view class="wave-box">
      <canvas type="2d" id="waveB" class="wave-canvas" style="width:{{canvasWidth}}px; height:{{canvasHeight}}px;"></canvas>
    </view>
    <view class="ch-row">
      <view class="ch-item ch-toggle-btn {{chB_SQ1 ? 'ch-on' : 'ch-off'}}" bindtap="toggleChannelB" data-ch="SQ1">
        <view class="ch-dot-c ch-dot-sq1"></view><text class="ch-txt">SQ1</text>
      </view>
      <view class="ch-item ch-toggle-btn {{chB_SQ2 ? 'ch-on' : 'ch-off'}}" bindtap="toggleChannelB" data-ch="SQ2">
        <view class="ch-dot-c ch-dot-sq2"></view><text class="ch-txt">SQ2</text>
      </view>
      <view class="ch-item ch-toggle-btn {{chB_TRI ? 'ch-on' : 'ch-off'}}" bindtap="toggleChannelB" data-ch="TRI">
        <view class="ch-dot-c ch-dot-tri"></view><text class="ch-txt">TRI</text>
      </view>
      <view class="ch-item ch-toggle-btn {{chB_NOISE ? 'ch-on' : 'ch-off'}}" bindtap="toggleChannelB" data-ch="NOISE">
        <view class="ch-dot-c ch-dot-noise"></view><text class="ch-txt">NOISE</text>
      </view>
    </view>
  </view>

  <!-- 状态 & 进度 -->
  <view class="status-card">
    <text class="status-text">{{status}}</text>
    <view class="progress-bar" wx:if="{{!ready}}">
      <view class="progress-fill" style="width:{{progress / totalFrames * 100}}%;"></view>
    </view>
    <text class="info-text" wx:if="{{ready}}">帧: {{elapsedFrames}} | 时间: {{elapsedTime}}</text>
  </view>

  <!-- 播放控件 -->
  <view class="play-controls">
    <button class="btn {{playing ? 'btn-pause' : 'btn-play'}}" bindtap="togglePlay" disabled="{{!ready}}">
      {{playing ? '⏸ 暂停' : '▶ 播放对比'}}
    </button>
    <button class="btn btn-stop" bindtap="_stop" disabled="{{!ready}}">⏹ 停止</button>
  </view>
</view>
