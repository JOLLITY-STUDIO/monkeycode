<!-- Bank 03 对话脚本查看器 -->
<view class="page">
  <!-- 顶部栏 -->
  <view class="toolbar">
    <view class="toolbar-title">Bank 03 · 对话脚本</view>
    <view class="toolbar-stats">
      <text>段:{{stats.total}}</text>
      <text class="sep">|</text>
      <text>文本:{{stats.text}}</text>
      <text class="sep">|</text>
      <text>控制:{{stats.control}}</text>
    </view>
    <view class="toolbar-mode-left">
      <text class="mode-btn {{mode==='auto'?'active':''}}" bindtap="switchMode" data-mode="auto">自动</text>
      <text class="mode-btn {{mode==='raw'?'active':''}}" bindtap="switchMode" data-mode="raw">原始</text>
    </view>
    <view class="toolbar-search">
      <input placeholder="搜索偏移/tile..." value="{{searchText}}" bindinput="onSearchInput" />
    </view>
  </view>

  <!-- 脚本内容 -->
  <scroll-view scroll-y="true" class="script-body" enhanced="true" show-scrollbar="true"
    scroll-into-view="{{scrollToId}}">
    <block wx:for="{{lines}}" wx:key="id" wx:for-index="idx">
      <!-- 文本行 -->
      <view
        wx:if="{{item.type === 'text'}}"
        class="line-text {{playingBlockId === item.dialogBlockId ? 'line-playing' : ''}}"
        id="line-{{idx}}"
        bindtap="onLineTap"
        data-block="{{item.dialogBlockId}}"
        data-idx="{{idx}}"
      >
        <text class="line-offset">[{{item.offset}}]</text>
        <text class="line-content">{{item.text}}</text>
        <text class="line-play-btn" wx:if="{{item.dialogBlockId >= 0}}">▶</text>
      </view>
      <!-- 控制行：FC 换行 -->
      <view wx:elif="{{item.ctrlHex === 'FC'}}" class="line-break"></view>
      <!-- 控制行：DC 新对话框 -->
      <view wx:elif="{{item.ctrlHex === 'DC'}}" class="line-bubble-break">
        <text class="ctrl-label">{{item.ctrlLabel}}</text>
      </view>
      <!-- 控制行：其他 -->
      <view wx:else class="line-control">
        <text class="line-offset ctrl-offset">[{{item.offset}}]</text>
        <text class="ctrl-hex">{{item.ctrlHex}}</text>
        <text class="ctrl-label" wx:if="{{item.ctrlLabel}}">{{item.ctrlLabel}}</text>
      </view>
    </block>
    <!-- 底部占位 -->
    <view style="height: 90px;"></view>
  </scroll-view>

  <!-- 对话框 Canvas -->
  <view class="dialog-panel">
    <view class="dialog-controls">
      <text class="dialog-status">
        <block wx:if="{{playingBlockId >= 0}}">▶ 播放 Block {{playingBlockId}}</block>
        <block wx:else>点击脚本行开始</block>
      </text>
      <text class="dialog-page" wx:if="{{playingBlockId >= 0}}">
        {{playingBlockId + 1}}/{{dialogBlocksCount}}
      </text>
    </view>
    <canvas type="2d" id="dialogCanvas" class="dialog-canvas"></canvas>
  </view>

  <!-- 浮动回到顶部 -->
  <view class="float-top" bindtap="scrollToTop">
    <text>⬆ 顶部</text>
  </view>
</view>
