<!--
  ROM 数据可视化页面
  直接消费 data-extractor.ts 的输出，无需污染 game 核心逻辑
-->
<scroll-view scroll-y="true" enhanced="true" show-scrollbar="true" class="container">
  <!-- 页面说明 -->
  <view class="page-intro">
    <view class="intro-title">ROM 数据浏览器</view>
    <view class="intro-desc">
      直接读取 PRG Bank 中的静态游戏数据（球员属性、球队、场景配置、曲线、矩阵、动画序列），
      无需运行游戏引擎。点击下方 Tab 切换查看各类数据，支持搜索过滤。
    </view>
    <view class="quick-links">
      <navigator url="/pages/tools/script-viewer/script-viewer" class="quick-link-btn">
        📜 Bank 03 对话脚本 →
      </navigator>
    </view>
  </view>

  <!-- Tab 导航 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab==='attr'?'active':''}}" bindtap="switchTab" data-tab="attr">
      球员属性
    </view>
    <view class="tab-item {{activeTab==='name'?'active':''}}" bindtap="switchTab" data-tab="name">
      球员名称
    </view>
    <view class="tab-item {{activeTab==='team'?'active':''}}" bindtap="switchTab" data-tab="team">
      球队数据
    </view>
    <view class="tab-item {{activeTab==='form'?'active':''}}" bindtap="switchTab" data-tab="form">
      场景配置
    </view>
    <view class="tab-item {{activeTab==='curve'?'active':''}}" bindtap="switchTab" data-tab="curve">
      数值曲线
    </view>
    <view class="tab-item {{activeTab==='matrix'?'active':''}}" bindtap="switchTab" data-tab="matrix">
      数值矩阵
    </view>
    <view class="tab-item {{activeTab==='anim'?'active':''}}" bindtap="switchTab" data-tab="anim">
      动画序列
    </view>
  </view>

  <!-- 统计概览 -->
  <view class="stats">
    <view class="stat-card">
      <view class="val">{{stats.players}}</view>
      <view class="label">球员</view>
    </view>
    <view class="stat-card">
      <view class="val">{{stats.attrs}}</view>
      <view class="label">属性记录</view>
    </view>
    <view class="stat-card">
      <view class="val">{{stats.teams}}</view>
      <view class="label">球队</view>
    </view>
    <view class="stat-card">
      <view class="val">{{stats.formations}}</view>
      <view class="label">场景配置</view>
    </view>
    <view class="stat-card">
      <view class="val">{{stats.curveLen}}</view>
      <view class="label">曲线条目</view>
    </view>
    <view class="stat-card">
      <view class="val">{{stats.valueRows}}</view>
      <view class="label">矩阵行</view>
    </view>
  </view>

  <!-- ══════ 球员属性 ══════ -->
  <view wx:if="{{activeTab==='attr'}}">
    <view class="section-title">球员属性记录 (Bank 28: $9616-$9E4D)</view>
    <view class="section-subtitle">{{attrRecords.length}} 条, 每记录 12 字节, {{uniquePids}} 个唯一 playerId</view>

    <view class="filter-bar">
      <input placeholder="搜索 playerId…" value="{{attrFilter}}" bindinput="onAttrFilter" />
    </view>

    <view class="attr-list" wx:if="{{filteredAttrs.length}}">
      <view class="attr-card" wx:for="{{filteredAttrs}}" wx:key="idx">
        <view class="attr-header">
          <text class="attr-idx">#{{item.idx}}</text>
          <text class="attr-pid">playerId={{item.pid}}</text>
        </view>
        <view class="attr-grid">
          <view class="attr-cell"><text class="attr-k">attrA</text><text class="attr-v hex">{{item.a}}</text></view>
          <view class="attr-cell"><text class="attr-k">STM</text><text class="attr-v hex">{{item.stm}}</text></view>
          <view class="attr-cell"><text class="attr-k">DEF</text><text class="attr-v hex">{{item.def}}</text></view>
          <view class="attr-cell"><text class="attr-k">CHG</text><text class="attr-v hex">{{item.chg}}</text></view>
          <view class="attr-cell"><text class="attr-k">TKL+</text><text class="attr-v hex">{{item.tkl}}</text></view>
          <view class="attr-cell"><text class="attr-k">SKL</text><text class="attr-v hex">{{item.skl}}</text></view>
          <view class="attr-cell"><text class="attr-k">MUP</text><text class="attr-v hex">{{item.mup}}</text></view>
          <view class="attr-cell"><text class="attr-k">SPD</text><text class="attr-v hex">{{item.spd}}</text></view>
          <view class="attr-cell"><text class="attr-k">STAM</text><text class="attr-v hex">{{item.stam}}</text></view>
          <view class="attr-cell"><text class="attr-k">TECH</text><text class="attr-v hex">{{item.tech}}</text></view>
          <view class="attr-cell"><text class="attr-k">LVL</text><text class="attr-v hex">{{item.lvl}}</text></view>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!filteredAttrs.length}}">无匹配记录</view>
  </view>

  <!-- ══════ 球员名称 ══════ -->
  <view wx:if="{{activeTab==='name'}}">
    <view class="section-title">球员名称表 (Bank 27)</view>
    <view class="section-subtitle">基于 CHR Bank 0 字体映射解码，〈0xNN〉 为未识别 tile</view>
    <view wx:for="{{teamPlayerNames}}" wx:key="teamId" wx:for-item="team" class="name-team">
      <view class="name-team-title">队伍 {{team.teamId}} — {{team.names.length}} 名球员</view>
      <view class="name-list">
        <view class="name-item" wx:for="{{team.names}}" wx:key="idx" wx:for-item="n">
          <text class="name-idx">#{{n.idx}}</text>
          <text class="name-text">{{n.text}}</text>
          <text class="name-hex">{{n.hex}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ══════ 球队数据 ══════ -->
  <view wx:if="{{activeTab==='team'}}">
    <view class="section-title">球队记录 (Bank 27)</view>
    <view wx:for="{{teamRecords}}" wx:key="teamId" wx:for-item="team" class="team-card">
      <view class="team-name">
        <text class="team-name-text">{{team.nameText}}</text>
        <text class="team-name-hex">{{team.nameHex}}</text>
      </view>
      <view class="team-players">
        <text class="team-label">球员 ID:</text>
        <text class="team-ids">{{team.playerIds}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!teamRecords.length}}">暂无</view>
  </view>

  <!-- ══════ 场景配置 (阵型) ══════ -->
  <view wx:if="{{activeTab==='form'}}">
    <view class="section-title">场景球员配置 (Bank 28: $9460-$95A7)</view>
    <view class="section-subtitle">
      由 ram_043B 索引 (0-6 游戏场景, 7-9 共享默认) | 
      {{sceneConfigs.length}} 个入口
    </view>

    <view class="scene-legend">
      <view class="legend-line">
        <text class="legend-k">槽ID:</text>
        <text class="legend-v">该球员在队伍名单中的序号</text>
      </view>
      <view class="legend-line">
        <text class="legend-k">能力偏移:</text>
        <text class="legend-v">指向能力值曲线的偏移</text>
      </view>
      <view class="legend-line">
        <text class="legend-k">属性:</text>
        <text class="legend-v">额外属性字节</text>
      </view>
      <view class="legend-line">
        <text class="legend-k">flags:</text>
        <text class="legend-v">低2位=位置(GK/DF/MF/FW), 高5位=场景标志</text>
      </view>
    </view>

    <view wx:for="{{sceneConfigs}}" wx:key="idx" wx:for-item="sc" class="scene-card">
      <view class="scene-header">
        <text class="scene-title">Scene {{sc.idx}}</text>
        <text class="scene-meta">{{sc.slots.length}} 人 · ${{sc.ptr}} · ram_043B={{sc.idx}}</text>
        <text class="scene-tag" wx:if="{{sc.shared}}">共享/默认</text>
      </view>

      <view class="slot-list" wx:if="{{sc.slots.length}}">
        <view class="slot-row slot-header">
          <text class="col-slot">#</text>
          <text class="col-slot">槽ID</text>
          <text class="col-curve">能力偏移</text>
          <text class="col-attr">属性</text>
          <text class="col-flags">flags</text>
          <text class="col-pos">位置</text>
          <text class="col-fhi">标志</text>
        </view>
        <view class="slot-row" wx:for="{{sc.slots}}" wx:key="sid" wx:for-item="s">
          <text class="col-slot num">{{s.sid}}</text>
          <text class="col-slot hex">{{s.slot}}</text>
          <text class="col-curve hex">{{s.curveOff}}</text>
          <text class="col-attr hex">{{s.attr}}</text>
          <text class="col-flags hex">{{s.flags}}</text>
          <text class="col-pos pos-{{s.pos}}">{{s.pos}}</text>
          <text class="col-fhi num">{{s.fHi}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{!sc.slots.length}}">(空配置)</view>
    </view>
  </view>

  <!-- ══════ 数值曲线 ══════ -->
  <view wx:if="{{activeTab==='curve'}}">
    <view class="section-title">能力值曲线 (Bank 28: $9E4E-$9F0D)</view>
    <view class="section-subtitle">基础 129 + 高位 63 = {{curveData.length}} 条目 | 索引 → 实际值</view>
    
    <view class="chart-wrap">
      <canvas canvas-id="curveChart" id="curveChart" style="width:100%;height:180px"></canvas>
    </view>

    <scroll-view scroll-x class="table-wrap">
      <table>
        <tr>
          <th wx:for="{{curveCols}}" wx:key="*this">{{item}}</th>
        </tr>
        <tr wx:for="{{curveRows}}" wx:key="row">
          <td class="hex" wx:for="{{item}}" wx:key="idx" wx:for-item="c">
            {{c}}
          </td>
        </tr>
      </table>
    </scroll-view>
  </view>

  <!-- ══════ 数值矩阵 ══════ -->
  <view wx:if="{{activeTab==='matrix'}}">
    <view class="section-title">球员数值矩阵 (Bank 29)</view>
    <view class="section-subtitle">{{matrixRows.length}} 行, marker 范围: {{matrixMarkerRange}}</view>

    <view class="filter-bar">
      <input placeholder="搜索 marker (hex)…" value="{{matrixFilter}}" bindinput="onMatrixFilter" />
    </view>

    <view wx:for="{{filteredMatrix}}" wx:key="rowId" wx:for-item="row" class="matrix-row">
      <view class="matrix-marker">{{row.marker}}</view>
      <view wx:for="{{row.bytes}}" wx:key="idx" wx:for-item="b" 
            class="matrix-byte {{b.z?'z':(b.mirror?'mirror':'')}}">
        {{b.hex}}
      </view>
    </view>
    <view class="empty" wx:if="{{!filteredMatrix.length}}">无匹配行</view>
  </view>

  <!-- ══════ 动画序列 ══════ -->
  <view wx:if="{{activeTab==='anim'}}">
    <view class="section-title">动画序列 (Bank 27: $8292-$8429)</view>
    <view class="section-subtitle">{{animSeqs.length}} 个序列, 共 {{animTotalFrames}} 帧</view>
    <view class="anim-grid">
      <view class="anim-card" wx:for="{{animSeqs}}" wx:key="seqId">
        <view class="seq-title">Seq {{item.seqId}} ({{item.frames.length}} 帧)</view>
        <view class="frame-row" wx:for="{{item.frames}}" wx:key="fid" wx:for-item="f">
          <text class="frame-dur">{{f.duration}}t</text>
          <text class="frame-tile">${{f.tile}}</text>
        </view>
      </view>
    </view>
  </view>

</scroll-view>
