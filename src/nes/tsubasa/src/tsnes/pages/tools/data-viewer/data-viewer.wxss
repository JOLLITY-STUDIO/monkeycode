/* ═══════════════════════════════════════════
   ROM Data Viewer — 暗色主题风格
   ═══════════════════════════════════════════ */
page {
  background: #0d1117;
  color: #c9d1d9;
  font-size: 13px;
  height: 100vh;
  box-sizing: border-box;
}

.container {
  height: 100vh;
  padding: 10px;
  padding-bottom: 60px;
  box-sizing: border-box;
}

/* ── 页面说明 ── */
.page-intro {
  padding: 12px 14px;
  margin-bottom: 10px;
  background: linear-gradient(135deg, #1a1f2e 0%, #161b22 100%);
  border: 1px solid #30363d;
  border-radius: 6px;
}
.intro-title {
  font-size: 16px;
  font-weight: 700;
  color: #58a6ff;
  margin-bottom: 4px;
}
.intro-desc {
  font-size: 12px;
  color: #8b949e;
  line-height: 1.5;
}

/* ── Tab 导航 ── */
.tab-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 8px 0;
  border-bottom: 1px solid #21262d;
  margin-bottom: 12px;
}
.tab-item {
  padding: 5px 12px;
  border-radius: 4px;
  font-size: 12px;
  color: #8b949e;
  background: #161b22;
  border: 1px solid #30363d;
}
.tab-item.active {
  color: #58a6ff;
  background: #1f2937;
  border-color: #1f6feb;
}

/* ── 统计面板 ── */
.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}
.stat-card {
  flex: 1;
  min-width: 80px;
  padding: 10px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 5px;
  text-align: center;
}
.stat-card .val {
  font-size: 20px;
  font-weight: bold;
  color: #58a6ff;
}
.stat-card .label {
  font-size: 11px;
  color: #8b949e;
  margin-top: 3px;
}

/* ── 表格 ── */
.section-title {
  font-size: 15px;
  font-weight: bold;
  color: #f0f6fc;
  margin: 12px 0 6px;
  padding-left: 6px;
  border-left: 3px solid #58a6ff;
}
.section-subtitle {
  font-size: 12px;
  color: #8b949e;
  margin-bottom: 6px;
}

.table-wrap {
  overflow-x: auto;
  margin-bottom: 10px;
  border: 1px solid #21262d;
  border-radius: 4px;
}
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
}
th, td {
  padding: 4px 7px;
  border: 1px solid #21262d;
  text-align: left;
  white-space: nowrap;
}
th {
  background: #161b22;
  color: #58a6ff;
  font-weight: 600;
  position: sticky;
  top: 0;
  z-index: 2;
}
td {
  background: #0d1117;
  color: #c9d1d9;
}
tr:nth-child(even) td {
  background: #161b22;
}
td.num {
  color: #79c0ff;
  font-family: monospace;
}
td.hex {
  color: #7ee787;
  font-family: monospace;
}
td.high {
  color: #f0883e;
  font-weight: bold;
}
td.pos-GK { color: #f778ba; }
td.pos-DF { color: #58a6ff; }
td.pos-MF { color: #3fb950; }
td.pos-FW { color: #f0883e; }

/* ── 曲线图表 (Canvas) ── */
.chart-wrap {
  margin-bottom: 12px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 5px;
  padding: 8px;
}
.chart-wrap canvas {
  width: 100%;
  display: block;
}

/* ── 动画序列卡片 ── */
.anim-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.anim-card {
  flex: 1;
  min-width: 140px;
  max-width: 180px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 5px;
  padding: 8px;
}
.anim-card .seq-title {
  color: #58a6ff;
  font-size: 12px;
  font-weight: bold;
  margin-bottom: 4px;
}
.anim-card .frame-row {
  display: flex;
  gap: 5px;
  align-items: center;
  padding: 2px 0;
  font-size: 11px;
}
.anim-card .frame-dur {
  color: #8b949e;
  width: 30px;
}
.anim-card .frame-tile {
  color: #79c0ff;
  font-family: monospace;
}

/* ── 值曲线色块 ── */
.curve-bar {
  display: flex;
  align-items: flex-end;
  height: 150px;
  gap: 1px;
  padding: 5px 0;
  overflow-x: auto;
}
.curve-col {
  flex-shrink: 0;
  width: 4px;
  background: linear-gradient(to top, #3fb950, #58a6ff);
  border-radius: 1px 1px 0 0;
}

/* ── 矩阵行 ── */
.matrix-row {
  display: flex;
  padding: 2px 0;
  border-bottom: 1px solid #161b22;
  font-family: monospace;
  font-size: 10px;
}
.matrix-marker {
  width: 25px;
  color: #f0883e;
  font-weight: bold;
}
.matrix-byte {
  width: 22px;
  color: #79c0ff;
  text-align: center;
}
.matrix-byte.mirror {
  color: #7ee787;
}
.matrix-byte.z {
  color: #484f58;
}

/* ── 搜索/过滤 ── */
.filter-bar {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-bottom: 8px;
}
.filter-bar input {
  flex: 1;
  padding: 5px 8px;
  background: #161b22;
  border: 1px solid #30363d;
  border-radius: 4px;
  color: #c9d1d9;
  font-size: 12px;
}
.filter-bar picker {
  padding: 5px 8px;
  background: #161b22;
  border: 1px solid #30363d;
  border-radius: 4px;
  color: #c9d1d9;
  font-size: 12px;
}

.empty {
  text-align: center;
  padding: 20px;
  color: #484f58;
  font-size: 13px;
}

/* ── 球员名称列表 ── */
.name-team {
  margin-bottom: 16px;
}
.name-team-title {
  font-size: 14px;
  font-weight: 600;
  color: #58a6ff;
  margin: 12px 0 8px;
  padding-left: 6px;
  border-left: 3px solid #58a6ff;
}
.name-list {
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
  overflow: hidden;
}
.name-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border-bottom: 1px solid #21262d;
  font-size: 13px;
}
.name-item:last-child {
  border-bottom: none;
}
.name-idx {
  width: 32px;
  color: #8b949e;
  font-family: monospace;
  flex-shrink: 0;
}
.name-text {
  flex: 1;
  color: #f0f6fc;
  font-weight: 500;
}
.name-hex {
  color: #79c0ff;
  font-family: monospace;
  font-size: 11px;
}

/* ── 球队卡片 ── */
.team-card {
  margin-bottom: 12px;
  padding: 12px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.team-name {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 6px;
}
.team-name-text {
  font-size: 16px;
  font-weight: bold;
  color: #f0f6fc;
}
.team-name-hex {
  font-size: 11px;
  color: #79c0ff;
  font-family: monospace;
}
.team-players {
  font-size: 12px;
  color: #8b949e;
  line-height: 1.5;
}
.team-label {
  color: #58a6ff;
  margin-right: 6px;
}
.team-ids {
  color: #c9d1d9;
}

/* ── 球员属性卡片 ── */
.attr-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.attr-card {
  padding: 12px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
}
.attr-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid #21262d;
}
.attr-idx {
  font-size: 12px;
  color: #8b949e;
  font-family: monospace;
}
.attr-pid {
  font-size: 14px;
  font-weight: bold;
  color: #f0883e;
}
.attr-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.attr-cell {
  display: flex;
  flex-direction: column;
  width: 58px;
}
.attr-k {
  font-size: 10px;
  color: #8b949e;
  margin-bottom: 2px;
}
.attr-v {
  font-size: 13px;
  font-weight: 600;
}

/* ── 场景配置卡片 ── */
.scene-legend {
  padding: 10px 12px;
  margin-bottom: 12px;
  background: #161b22;
  border: 1px solid #30363d;
  border-radius: 6px;
}
.legend-line {
  display: flex;
  margin: 4px 0;
  font-size: 11px;
  line-height: 1.4;
}
.legend-k {
  width: 70px;
  flex-shrink: 0;
  color: #58a6ff;
  font-weight: 600;
}
.legend-v {
  color: #8b949e;
}

.scene-card {
  margin-bottom: 16px;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 8px;
  overflow: hidden;
}
.scene-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: #0d1117;
  border-bottom: 1px solid #21262d;
}
.scene-title {
  font-size: 14px;
  font-weight: bold;
  color: #f0f6fc;
}
.scene-meta {
  font-size: 11px;
  color: #8b949e;
}
.scene-tag {
  margin-left: auto;
  padding: 2px 6px;
  font-size: 10px;
  color: #f0883e;
  background: rgba(240, 136, 62, 0.12);
  border: 1px solid rgba(240, 136, 62, 0.3);
  border-radius: 3px;
}

.slot-list {
  padding: 6px 0;
}
.slot-row {
  display: flex;
  align-items: center;
  padding: 6px 12px;
  font-size: 12px;
  border-bottom: 1px solid #21262d;
}
.slot-row:last-child {
  border-bottom: none;
}
.slot-header {
  font-weight: 600;
  color: #58a6ff;
  background: #0d1117;
  border-bottom: 1px solid #30363d;
}
.slot-row .col-slot { width: 42px; }
.slot-row .col-curve { width: 60px; }
.slot-row .col-attr { width: 45px; }
.slot-row .col-flags { width: 45px; }
.slot-row .col-pos { width: 36px; font-weight: 600; }
.slot-row .col-fhi { width: 36px; }
