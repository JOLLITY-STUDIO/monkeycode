.game-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0a18;
  overflow: hidden;
  position: relative;
}

.game-canvas {
  flex: 1;
  width: 100%;
  background: #000;
  image-rendering: pixelated;
}

.status-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 16rpx;
  background: rgba(0, 0, 0, 0.7);
  z-index: 10;
  pointer-events: none;
}

.status-tag {
  color: #0ff;
  font-size: 18rpx;
  font-weight: bold;
  background: rgba(0, 255, 255, 0.15);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.status-text {
  color: #8f8;
  font-size: 18rpx;
}

.fps-text {
  color: #ff8;
  font-size: 18rpx;
}

.control-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(15, 15, 35, 0.95);
  gap: 16rpx;
  min-height: 240rpx;
  flex-shrink: 0;
}

.dpad {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.dpad-btn {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #888;
  user-select: none;
  -webkit-user-select: none;
  transition: background 0.08s;
}

.dpad-btn:active {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
}

.dpad-btn.up    { top: 0;    left: 50%; transform: translateX(-50%); }
.dpad-btn.down  { bottom: 0; left: 50%; transform: translateX(-50%); }
.dpad-btn.left  { left: 0;   top: 50%; transform: translateY(-50%); }
.dpad-btn.right { right: 0;  top: 50%; transform: translateY(-50%); }

.middle-btns {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.middle-btns .ctrl-btn {
  width: 140rpx;
  height: 64rpx;
  font-size: 20rpx;
  border-radius: 40rpx;
}

.action-btns {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
  padding-right: 12rpx;
}

.action-btns .ctrl-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
}

.ctrl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  color: #888;
  user-select: none;
  -webkit-user-select: none;
  transition: background 0.08s, transform 0.08s;
}

.ctrl-btn:active {
  transform: scale(0.92);
}

.a-btn {
  background: rgba(220, 50, 50, 0.25);
  border-color: rgba(220, 50, 50, 0.5);
  color: #e04040;
}
.a-btn:active {
  background: rgba(220, 50, 50, 0.5);
  color: #ff6060;
}

.b-btn {
  background: rgba(220, 180, 30, 0.25);
  border-color: rgba(220, 180, 30, 0.5);
  color: #ddb020;
}
.b-btn:active {
  background: rgba(220, 180, 30, 0.5);
  color: #ffd030;
}

.select-btn:active, .start-btn:active {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}
