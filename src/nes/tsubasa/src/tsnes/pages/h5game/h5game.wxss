.game-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0a18;
  overflow: hidden;
}

/* ── 状态栏 ── */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 12px;
  background: rgba(0, 0, 0, 0.75);
  flex-shrink: 0;
  min-height: 28px;
}

.status-tag {
  color: #0ff;
  font-size: 11px;
  font-weight: bold;
  background: rgba(0, 255, 255, 0.15);
  padding: 2px 8px;
  border-radius: 4px;
}

.status-text {
  color: #8f8;
  font-size: 11px;
}

.fps-text {
  color: #ff8;
  font-size: 11px;
}

/* ── 主行: 游戏 + Debug 左右双栏 ── */
.main-row {
  flex: 1;
  display: flex;
  flex-direction: row;
  min-height: 0;
  overflow: hidden;
}

/* ── 左栏：游戏区域 ── */
.game-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: hidden;
  min-height: 0;
  min-width: 0;
}

/* ── 右栏：Debug 区（始终可见，toolbar 常驻） ── */
.debug-column {
  display: flex;
  flex-direction: column;
  min-height: 0;
  min-width: 0;
  overflow: hidden;
  background: #0d0d22;
  flex-shrink: 0;
  flex: 0 0 auto;            /* 无 tab 时只占 toolbar 自身宽度 */
}

.debug-column.expanded {
  flex: 1 1 0;               /* 有 tab 时与游戏各半 */
}

.canvas-pair {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 0;
  background: #000;
}

.canvas-label {
  font-size: 10px;
  color: #aaa;
  padding: 2px 0;
  letter-spacing: 1px;
  flex-shrink: 0;
  width: 100%;
  text-align: center;
}

.label-cpu {
  color: #f0a500;
  background: rgba(240, 165, 0, 0.08);
}

.label-bank {
  color: #0ff;
  background: rgba(0, 255, 255, 0.08);
}

.game-canvas {
  width: 100%;
  flex: 1;
  min-height: 0;
  background: #000;
}

/* ── Debug 面板 ── */
.debug-panel {
  display: none;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.debug-panel.visible {
  display: flex;
}

/* ── Debug 工具栏 ── */
.debug-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 2px;
  padding: 3px 4px;
  background: rgba(15, 15, 35, 0.95);
  flex-shrink: 0;
}

.debug-tab {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: #666;
  padding: 5px 2px;
  border-radius: 6px;
  user-select: none;
  -webkit-user-select: none;
}

.debug-tab.active {
  color: #0ff;
  background: rgba(0, 255, 255, 0.12);
  font-weight: bold;
}

.debug-tab:active {
  background: rgba(0, 255, 255, 0.2);
}

/* ── Debug 画布查看器 ── */
.debug-canvas-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #0d0d22;
  min-height: 0;
}

.debug-canvas {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

/* ── 反汇编文本区 ── */
.disasm-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}

.disasm-scroll {
  flex: 1;
  height: 0; /* flex 下强制收缩以支持滚动 */
  background: #0d0d22;
  padding: 6px 10px;
}

.disasm-text {
  font-size: 12px;
  font-family: 'Courier New', monospace;
  color: #8f8;
  white-space: pre;
  line-height: 1.4;
}

/* ── 控制面板 ── */
.control-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 8px;
  padding-bottom: calc(6px + env(safe-area-inset-bottom));
  background: rgba(15, 15, 35, 0.95);
  gap: 4px;
  min-height: 120px;
  flex-shrink: 0;
}

/* ── 方向键 ── */
.dpad {
  position: relative;
  width: 130px;
  height: 130px;
  flex-shrink: 0;
}

.dpad-btn {
  position: absolute;
  width: 42px;
  height: 42px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #888;
  user-select: none;
  -webkit-user-select: none;
}

.dpad-btn:active {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
}

.dpad-btn.up    { top: 0;    left: 50%; transform: translateX(-50%); }
.dpad-btn.down  { bottom: 0; left: 50%; transform: translateX(-50%); }
.dpad-btn.left  { left: 0;   top: 50%; transform: translateY(-50%); }
.dpad-btn.right { right: 0;  top: 50%; transform: translateY(-50%); }

/* ── 中间按钮 ── */
.middle-btns {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.middle-btns .ctrl-btn {
  width: 80px;
  height: 36px;
  font-size: 13px;
  border-radius: 30px;
}

/* ── AB 动作按钮 ── */
.action-btns {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
  padding-right: 6px;
}

.action-btns .ctrl-btn {
  width: 62px;
  height: 62px;
  border-radius: 50%;
  font-size: 20px;
  font-weight: bold;
}

/* ── 通用按钮 ── */
.ctrl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #888;
  user-select: none;
  -webkit-user-select: none;
}

.ctrl-btn:active {
  transform: scale(0.92);
}

.a-btn {
  background: rgba(220, 50, 50, 0.25);
  border-color: rgba(220, 50, 50, 0.5);
  color: #e04040;
}
.a-btn:active {
  background: rgba(220, 50, 50, 0.5);
  color: #ff6060;
}

.b-btn {
  background: rgba(220, 180, 30, 0.25);
  border-color: rgba(220, 180, 30, 0.5);
  color: #ddb020;
}
.b-btn:active {
  background: rgba(220, 180, 30, 0.5);
  color: #ffd030;
}

.select-btn:active, .start-btn:active {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}
