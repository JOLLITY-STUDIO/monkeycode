.game-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0a18;
  overflow: hidden;
}

/* ── 隐藏的导出 canvas ── */
.export-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 256px;
  height: 256px;
}

/* ── 状态栏 ── */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 12px;
  background: rgba(0, 0, 0, 0.75);
  flex-shrink: 0;
  min-height: 28px;
}

.data-btn {
  font-size: 12px;
  color: #58a6ff;
  padding: 2px 10px;
  border: 1rpx solid #1f6feb;
  border-radius: 4px;
  background: rgba(31, 111, 235, 0.15);
}

.status-tag {
  color: #0ff;
  font-size: 11px;
  font-weight: bold;
  background: rgba(0, 255, 255, 0.15);
  padding: 2px 8px;
  border-radius: 4px;
}

.status-text {
  color: #8f8;
  font-size: 11px;
}

.fps-text {
  color: #ff8;
  font-size: 11px;
}

/* ── 主行: 游戏 + Debug 左右双栏 ── */
.main-row {
  flex: 1;
  display: flex;
  flex-direction: row;
  min-height: 0;
  overflow: hidden;
}

/* ── 左栏：游戏区域 ── */
.game-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: hidden;
  min-height: 0;
  min-width: 0;
}

/* ── 右栏：Debug 区（始终可见，toolbar 常驻） ── */
.debug-column {
  display: flex;
  flex-direction: column;
  min-height: 0;
  min-width: 0;
  overflow: hidden;
  background: #0d0d22;
  flex-shrink: 0;
  flex: 0 0 auto;            /* 无 tab 时只占 toolbar 自身宽度 */
}

.debug-column.expanded {
  flex: 1 1 0;               /* 有 tab 时与游戏各半 */
}

.canvas-pair {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 0;
  background: #000;
}

.canvas-label {
  font-size: 10px;
  color: #aaa;
  padding: 2px 0;
  letter-spacing: 1px;
  flex-shrink: 0;
  width: 100%;
  text-align: center;
}

.label-cpu {
  color: #f0a500;
  background: rgba(240, 165, 0, 0.08);
}

.label-bank {
  color: #0ff;
  background: rgba(0, 255, 255, 0.08);
}

.game-canvas {
  width: 100%;
  flex: 1;
  min-height: 0;
  background: #000;
}

/* ── Debug 面板 ── */
.debug-panel {
  display: none;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.debug-panel.visible {
  display: flex;
}

/* ── Debug 工具栏 ── */
.debug-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 2px;
  padding: 3px 4px;
  background: rgba(15, 15, 35, 0.95);
  flex-shrink: 0;
}

.debug-tab {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: #666;
  padding: 5px 2px;
  border-radius: 6px;
  user-select: none;
  -webkit-user-select: none;
}

.debug-tab.active {
  color: #0ff;
  background: rgba(0, 255, 255, 0.12);
  font-weight: bold;
}

.debug-tab:active {
  background: rgba(0, 255, 255, 0.2);
}

/* ── Debug 画布查看器 ── */
.debug-canvas-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #0d0d22;
  min-height: 0;
}

.debug-canvas {
  display: block;
  max-width: 100%;
  max-height: 100%;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

/* ── 反汇编文本区 ── */
.disasm-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}

.disasm-scroll {
  flex: 1;
  height: 0; /* flex 下强制收缩以支持滚动 */
  background: #0d0d22;
  padding: 6px 10px;
}

.disasm-text {
  font-size: 12px;
  font-family: 'Courier New', monospace;
  color: #8f8;
  white-space: pre;
  line-height: 1.4;
}

/* ── NT 数据区（canvas 渲染 + 下方可滚动可复制文字，6:4 分配）── */
.nt-canvas-wrap {
  flex: 0 0 60%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0d0d22;
  overflow: hidden;
  min-height: 0;
}

.nt-data-wrap {
  flex: 0 0 40%;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  border-top: 1px solid rgba(0, 255, 255, 0.12);
}

.nt-data-scroll {
  flex: 1;
  height: 0;
  background: #0d0d22;
  padding: 4px 8px;
}

.nt-data-text {
  font-size: 10px;
  font-family: 'Courier New', monospace;
  color: #0cf;
  white-space: pre;
  line-height: 1.3;
}

/* ── PT 数据区（canvas + CHR bank 映射文字，6:4 分配）── */
.pt-canvas-wrap {
  flex: 0 0 60%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0d0d22;
  overflow: hidden;
  min-height: 0;
}

.pt-data-wrap {
  flex: 0 0 40%;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  border-top: 1px solid rgba(0, 255, 0, 0.12);
}

.pt-data-scroll {
  flex: 1;
  height: 0;
  background: #0d0d22;
  padding: 4px 8px;
}

.pt-data-text {
  font-size: 10px;
  font-family: 'Courier New', monospace;
  color: #0f8;
  white-space: pre;
  line-height: 1.3;
}

/* ── SPR 工具栏 ── */
.spr-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 3px 8px;
  background: #111130;
  border-bottom: 1px solid rgba(0, 255, 255, 0.1);
  flex-shrink: 0;
}

.spr-toolbar-label {
  font-size: 11px;
  color: #6af;
  font-weight: 600;
}

.spr-export-btn {
  font-size: 11px;
  color: #0ff;
  background: rgba(0, 255, 255, 0.08);
  border: 1px solid rgba(0, 255, 255, 0.25);
  border-radius: 4px;
  padding: 2px 10px;
  cursor: pointer;
}

.spr-export-btn:active {
  background: rgba(0, 255, 255, 0.2);
}

.spr-record-btn {
  font-size: 11px;
  color: #f88;
  background: rgba(255, 88, 88, 0.1);
  border: 1px solid rgba(255, 88, 88, 0.3);
  border-radius: 4px;
  padding: 2px 10px;
  cursor: pointer;
}

.spr-stop-btn {
  font-size: 11px;
  color: #fff;
  background: rgba(255, 0, 0, 0.3);
  border: 1px solid rgba(255, 0, 0, 0.5);
  border-radius: 4px;
  padding: 2px 10px;
  cursor: pointer;
  animation: pulse 0.8s ease-in-out infinite alternate;
}

@keyframes pulse {
  from { background: rgba(255, 0, 0, 0.3); }
  to   { background: rgba(255, 0, 0, 0.55); }
}

.spr-dur-wrap {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  background: #111130;
  border-bottom: 1px solid rgba(0, 255, 255, 0.08);
  flex-shrink: 0;
}

.spr-dur-label {
  font-size: 10px;
  color: #888;
  flex-shrink: 0;
}

.spr-dur-input {
  font-size: 11px;
  color: #0cf;
  background: rgba(0, 255, 255, 0.06);
  border: 1px solid rgba(0, 255, 255, 0.2);
  border-radius: 4px;
  padding: 2px 6px;
  width: 60px;
  text-align: center;
}

/* ── SPT 数据区（SPR panel: canvas + 下方可滚动可复制文字，6:4 分配）── */
.spt-canvas-wrap {
  flex: 0 0 60%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0d0d22;
  overflow: hidden;
  min-height: 0;
}

.spt-data-wrap {
  flex: 0 0 40%;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  border-top: 1px solid rgba(0, 255, 255, 0.12);
}

.spt-data-scroll {
  flex: 1;
  height: 0;
  background: #0d0d22;
  padding: 4px 8px;
}

.spt-data-text {
  font-size: 10px;
  font-family: 'Courier New', monospace;
  color: #0cf;
  white-space: pre;
  line-height: 1.3;
}

/* ── 数据区通用工具栏（复制按钮）── */
.data-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 3px 8px;
  background: #111130;
  border-bottom: 1px solid rgba(0, 255, 255, 0.08);
  flex-shrink: 0;
}

.data-toolbar-label {
  font-size: 10px;
  color: #6af;
  font-weight: 600;
}

.data-copy-btn {
  font-size: 10px;
  color: #0cf;
  background: rgba(0, 255, 255, 0.06);
  border: 1px solid rgba(0, 255, 255, 0.2);
  border-radius: 4px;
  padding: 2px 8px;
  cursor: pointer;
}

.data-copy-btn:active {
  background: rgba(0, 255, 255, 0.18);
  color: #0ff;
}

/* ── 调色板色条容器（嵌入 NT/PT/SPR 视图顶部）── */
.palette-strips {
  display: flex;
  flex-direction: row;
  gap: 2px;
  flex-shrink: 0;
  overflow: hidden;
  border-bottom: 1px solid rgba(0, 255, 255, 0.1);
}

.palette-strip {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 2px;
  padding: 2px 4px;
  background: #0d0d22;
  overflow: hidden;
}

.palette-label {
  font-size: 8px;
  color: #f0a500;
  font-weight: 600;
  flex-shrink: 0;
  width: 36px;
  text-align: center;
  line-height: 10px;
}

.palette-group {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: row;
  gap: 1px;
  justify-content: space-evenly;
}

.palette-swatch-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
  flex: 0 0 auto;
  min-width: 10px;
}

.palette-addr {
  font-size: 5px;
  color: #666;
  line-height: 6px;
  height: 6px;
  text-align: center;
  width: 100%;
  font-family: 'Courier New', monospace;
}

.palette-color-idx {
  font-size: 6px;
  color: #f0a500;
  line-height: 7px;
  height: 7px;
  text-align: center;
  width: 100%;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

.palette-swatch {
  width: 8px;
  height: 8px;
  border-radius: 1px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  flex-shrink: 0;
}

/* ── 控制面板 ── */
.control-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 8px;
  padding-bottom: calc(6px + env(safe-area-inset-bottom));
  background: rgba(15, 15, 35, 0.95);
  gap: 4px;
  min-height: 120px;
  flex-shrink: 0;
}

/* ── 方向键 ── */
.dpad {
  position: relative;
  width: 130px;
  height: 130px;
  flex-shrink: 0;
}

.dpad-btn {
  position: absolute;
  width: 42px;
  height: 42px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #888;
  user-select: none;
  -webkit-user-select: none;
}

.dpad-btn:active {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
}

.dpad-btn.up    { top: 0;    left: 50%; transform: translateX(-50%); }
.dpad-btn.down  { bottom: 0; left: 50%; transform: translateX(-50%); }
.dpad-btn.left  { left: 0;   top: 50%; transform: translateY(-50%); }
.dpad-btn.right { right: 0;  top: 50%; transform: translateY(-50%); }

/* ── 中间按钮 ── */
.middle-btns {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}

.middle-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4px;
}

.middle-row .ctrl-btn {
  width: 44px;
  height: 26px;
  font-size: 10px;
  border-radius: 6px;
}

/* ── AB 动作按钮 ── */
.action-btns {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
  padding-right: 6px;
}

.action-btns .ctrl-btn {
  width: 62px;
  height: 62px;
  border-radius: 50%;
  font-size: 20px;
  font-weight: bold;
}

/* ── 通用按钮 ── */
.ctrl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #888;
  user-select: none;
  -webkit-user-select: none;
}

.ctrl-btn:active {
  transform: scale(0.92);
}

.a-btn {
  background: rgba(220, 50, 50, 0.25);
  border-color: rgba(220, 50, 50, 0.5);
  color: #e04040;
}
.a-btn:active {
  background: rgba(220, 50, 50, 0.5);
  color: #ff6060;
}

.b-btn {
  background: rgba(220, 180, 30, 0.25);
  border-color: rgba(220, 180, 30, 0.5);
  color: #ddb020;
}
.b-btn:active {
  background: rgba(220, 180, 30, 0.5);
  color: #ffd030;
}

.select-btn:active, .start-btn:active {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

/* ── 调试辅助按钮（暂停/加速/重置）── */
.pause-btn2 {
  background: rgba(0, 255, 255, 0.1);
  border-color: rgba(0, 255, 255, 0.3);
  color: #0ff;
}
.pause-btn2.paused {
  background: rgba(0, 255, 0, 0.15);
  border-color: rgba(0, 255, 0, 0.4);
  color: #0f0;
}

.turbo-btn {
  background: rgba(0, 200, 100, 0.1);
  border-color: rgba(0, 200, 100, 0.3);
  color: #0c6;
}
.turbo-btn.lv1 {
  background: rgba(255, 180, 0, 0.15);
  border-color: rgba(255, 180, 0, 0.4);
  color: #fb0;
}
.turbo-btn.lv2 {
  background: rgba(255, 60, 0, 0.15);
  border-color: rgba(255, 60, 0, 0.4);
  color: #f60;
}

.fps-btn {
  background: rgba(150, 150, 255, 0.1);
  border-color: rgba(150, 150, 255, 0.3);
  color: #99f;
}

.reset-btn {
  background: rgba(255, 60, 60, 0.1);
  border-color: rgba(255, 60, 60, 0.3);
  color: #f44;
}
.reset-btn:active {
  background: rgba(255, 60, 60, 0.35);
  color: #f88;
}
