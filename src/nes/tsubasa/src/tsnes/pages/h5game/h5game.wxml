<template name="paletteStrips">
  <view class="palette-strips">
    <block wx:for="{{strips}}" wx:for-item="strip" wx:key="type">
      <view class="palette-strip">
        <text class="palette-label">{{strip.tableAddr ? strip.type + ' ' + strip.tableAddr : strip.type}}</text>
        <block wx:for="{{strip.groups}}" wx:for-item="group" wx:key="*this">
          <view class="palette-group">
            <block wx:for="{{group}}" wx:for-item="item" wx:key="addr">
              <view class="palette-swatch-box">
                <text class="palette-addr">{{item.addr}}</text>
                <view class="palette-swatch" style="background:{{item.color}}"></view>
                <text class="palette-color-idx">#{{item.colorIdx}}</text>
              </view>
            </block>
          </view>
        </block>
      </view>
    </block>
  </view>
</template>

<view class="game-container">
  <!-- 隐藏的导出 canvas（off-screen） -->
  <canvas type="2d" id="exportCanvas" class="export-canvas"></canvas>
  <!-- 状态栏（置顶） -->
  <view class="status-bar">
    <text class="status-tag">{{debugTab ? 'Debug: ' + debugTabs[debugTab] : '双引擎'}}</text>
    <text class="status-text">{{status}}</text>
    <text class="fps-text">FPS: {{fps}}</text>
    <navigator url="/pages/tools/data-viewer/data-viewer" class="data-btn">数据</navigator>
  </view>

  <!-- 游戏 + Debug 左右双栏布局 (PC 宽屏) -->
  <view class="main-row">
    <!-- 左栏：游戏画布区 -->
    <view class="game-area">
      <view class="canvas-pair">
        <text class="canvas-label label-cpu">CPU 模拟器</text>
        <canvas type="2d" id="h5canvas" class="game-canvas" disable-scroll="true"></canvas>
      </view>
      <view class="canvas-pair">
        <text class="canvas-label label-bank">Bank 翻译</text>
        <canvas type="2d" id="h5canvas2" class="game-canvas" disable-scroll="true"></canvas>
      </view>
    </view>

    <!-- 右栏：Debug 区（始终可见） -->
    <view class="debug-column {{debugTab ? 'expanded' : ''}}">
      <!-- Debug 工具栏（始终可见） -->
      <view class="debug-toolbar">
        <view class="debug-tab {{!debugTab ? 'active' : ''}}" bindtap="onDebugTab" data-tab="">GAME</view>
        <view class="debug-tab {{debugTab === 'nametable' ? 'active' : ''}}" bindtap="onDebugTab" data-tab="nametable">NT</view>
        <view class="debug-tab {{debugTab === 'patterntable' ? 'active' : ''}}" bindtap="onDebugTab" data-tab="patterntable">PT</view>
        <view class="debug-tab {{debugTab === 'sprite' ? 'active' : ''}}" bindtap="onDebugTab" data-tab="sprite">SPR</view>
        <view class="debug-tab {{debugTab === 'disasm' ? 'active' : ''}}" bindtap="onDebugTab" data-tab="disasm">ASM</view>
      </view>

      <!-- Debug 面板（有 tab 时展开） -->
      <view class="debug-panel {{debugTab ? 'visible' : ''}}">
        <!-- 画布类查看器（其他不含文字的） -->
        <!-- NT 特殊：canvas + 可复制文字数据 -->
        <block wx:if="{{debugTab === 'nametable'}}">
          <template is="paletteStrips" data="{{strips: paletteStrips}}"/>
          <view class="nt-canvas-wrap">
            <canvas type="2d" id="debugCanvas" class="debug-canvas" style="{{debugCanvasStyle}}"></canvas>
          </view>
          <view class="nt-data-wrap">
            <view class="data-toolbar">
              <text class="data-toolbar-label">NT Data</text>
              <view class="data-copy-btn" bindtap="onCopyNTData">[ 复制 ]</view>
            </view>
            <scroll-view class="nt-data-scroll" scroll-y="true" enhanced="true" show-scrollbar="true">
              <text class="nt-data-text">{{ntDataText}}</text>
            </scroll-view>
          </view>
        </block>
        <!-- PT 特殊：canvas + CHR bank 可复制文字数据 -->
        <block wx:if="{{debugTab === 'patterntable'}}">
          <template is="paletteStrips" data="{{strips: paletteStrips}}"/>
          <view class="pt-canvas-wrap">
            <canvas type="2d" id="debugCanvas" class="debug-canvas" style="{{debugCanvasStyle}}"></canvas>
          </view>
          <view class="pt-data-wrap">
            <view class="data-toolbar">
              <text class="data-toolbar-label">PT Data</text>
              <view class="data-copy-btn" bindtap="onCopyPTData">[ 复制 ]</view>
            </view>
            <scroll-view class="pt-data-scroll" scroll-y="true" enhanced="true" show-scrollbar="true">
              <text class="pt-data-text">{{ptDataText}}</text>
            </scroll-view>
          </view>
        </block>
        <!-- SPR 特殊：canvas + 可复制 SPT 文字数据 -->
        <block wx:if="{{debugTab === 'sprite'}}">
          <template is="paletteStrips" data="{{strips: paletteStrips}}"/>
          <view class="spr-toolbar">
            <text class="spr-toolbar-label">SPR Viewer</text>
            <view class="data-copy-btn" bindtap="onCopySPRData">[ 复制 ]</view>
            <view class="spr-export-btn" bindtap="onExportSprite">[ 导出图片 ]</view>
            <block wx:if="{{!sprRecording}}">
              <view class="spr-record-btn" bindtap="onStartRecord">[ 录制 ]</view>
            </block>
            <block wx:else>
              <view class="spr-stop-btn" bindtap="onStopRecord">[ 停止 {{sprRecordCount}}帧 ]</view>
            </block>
          </view>
          <view class="spr-dur-wrap" wx:if="{{!sprRecording}}">
            <text class="spr-dur-label">时长(秒):</text>
            <input class="spr-dur-input" type="number" value="{{sprRecordDur}}" bindinput="onRecordDurInput" placeholder="手动"/>
          </view>
          <view class="spt-canvas-wrap">
            <canvas type="2d" id="debugCanvas" class="debug-canvas" style="{{debugCanvasStyle}}"></canvas>
          </view>
          <view class="spt-data-wrap">
            <scroll-view class="spt-data-scroll" scroll-y="true" enhanced="true" show-scrollbar="true">
              <text class="spt-data-text">{{sptDataText}}</text>
            </scroll-view>
          </view>
        </block>
        <!-- 汇编文本 -->
        <view class="disasm-wrap" wx:if="{{debugTab === 'disasm'}}">
          <scroll-view class="disasm-scroll" scroll-y="true" enhanced="true" show-scrollbar="true">
            <text class="disasm-text">{{debugLines}}</text>
          </scroll-view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部控制面板 -->
  <view class="control-panel">
    <view class="dpad">
      <view class="dpad-btn up"    catchtouchstart="onBtnDown" catchtouchend="onBtnUp" data-btn="up">▲</view>
      <view class="dpad-btn left"  catchtouchstart="onBtnDown" catchtouchend="onBtnUp" data-btn="left">◄</view>
      <view class="dpad-btn right" catchtouchstart="onBtnDown" catchtouchend="onBtnUp" data-btn="right">►</view>
      <view class="dpad-btn down"  catchtouchstart="onBtnDown" catchtouchend="onBtnUp" data-btn="down">▼</view>
    </view>
    <view class="middle-btns">
      <view class="middle-row">
        <view class="ctrl-btn select-btn" catchtouchstart="onBtnDown" catchtouchend="onBtnUp" data-btn="select">SELECT</view>
        <view class="ctrl-btn start-btn"  catchtouchstart="onBtnDown" catchtouchend="onBtnUp" data-btn="start">START</view>
      </view>
      <view class="middle-row">
        <view class="ctrl-btn pause-btn2 {{paused ? 'paused' : ''}}" bindtap="onPause">{{paused ? '▶' : '⏸'}}</view>
        <view class="ctrl-btn turbo-btn lv{{turboLevel}}" bindtap="onTurboToggle">{{turboLevel === 0 ? '1×' : turboLevel === 1 ? '2×' : '4×'}}</view>
        <view class="ctrl-btn fps-btn" bindtap="onFpsTap">{{showFpsBtn ? fps : 'FPS'}}</view>
        <view class="ctrl-btn reset-btn" bindtap="onReset">RST</view>
      </view>
    </view>
    <view class="action-btns">
      <view class="ctrl-btn b-btn" catchtouchstart="onBtnDown" catchtouchend="onBtnUp" data-btn="b">B</view>
      <view class="ctrl-btn a-btn" catchtouchstart="onBtnDown" catchtouchend="onBtnUp" data-btn="a">A</view>
    </view>
  </view>
</view>
