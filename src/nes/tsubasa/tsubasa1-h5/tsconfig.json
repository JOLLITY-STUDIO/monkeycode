{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "lib": ["ES2015"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": false,
    "removeComments": false
  },
  "include": [
    "src/**/*.ts",
    "pages/**/*.ts",
    "app.ts"
  ],
  "exclude": [
    "_tmp_disasm_out",
    "temp",
    "node_modules",
    "scripts"
  ]
}
