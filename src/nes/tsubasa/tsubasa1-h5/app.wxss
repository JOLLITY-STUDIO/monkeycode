/* 天使之翼1 — 全局样式 */
page {
  background-color: #000000;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.canvas-container {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}

canvas {
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}
