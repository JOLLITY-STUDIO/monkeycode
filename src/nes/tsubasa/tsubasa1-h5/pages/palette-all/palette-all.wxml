<!-- Palette All - 完整的 NES 调色板数据展示 -->
<view class="pal-container">
  <view class="header">
    <text class="title">Palette 调色板 (NES 64 色)</text>
    <text class="subtitle">来源: FCEUX 存档提取 (tsubasanes.pal) — NES NTSC 主调色板 + 游戏 PPU 调色板 RAM</text>
  </view>

  <!-- NES 64 色主调色板 -->
  <view class="section">
    <text class="section-title">NES 主调色板 (64 色, 索引 0x00-0x3F)</text>
    <text class="section-desc">NES 硬件色盘, 分为 4 行 × 16 列。每行: 灰色系 → 彩色系 → 黑色/灰色/白色强调色</text>
    
    <view class="master-palette">
      <view wx:for="{{masterPaletteRows}}" wx:key="rowIdx" class="pal-row">
        <text class="row-label">行 {{item.rowIdx}}</text>
        <view wx:for="{{item.colors}}" wx:for-item="color" wx:key="index" class="color-cell"
          style="background:{{color.hex}};" bindtap="onColorTap" data-index="{{color.index}}">
          <text class="color-index">{{color.indexHex}}</text>
          <text class="color-hex">{{color.hex}}</text>
          <text class="color-rgb">R{{color.r}} G{{color.g}} B{{color.b}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- PPU 调色板 RAM ($3F00-$3F1F) -->
  <view class="section">
    <text class="section-title">PPU 调色板 RAM ($3F00-$3F1F, 32 字节)</text>
    <text class="section-desc">NES PPU 内部调色板存储器: 8 组 × 4 色 (BG 调色板 0-3 + Sprite 调色板 0-3)</text>

    <view class="ppu-palette">
      <view wx:for="{{ppuPalettes}}" wx:key="index" class="ppu-pal-group">
        <text class="ppu-group-name">{{item.name}}</text>
        <text class="ppu-group-addr">$3F{{item.addr}}</text>
        <view class="ppu-colors">
          <view wx:for="{{item.colors}}" wx:for-item="c" wx:key="subIdx" class="ppu-color"
            style="background:{{c.displayHex}};">
            <text class="ppu-nes-idx">N{{c.nesHex}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 调色板镜像说明 -->
  <view class="section">
    <text class="section-title">调色板内存映射 (地址镜像)</text>
    <view class="mirror-info">
      <text class="mirror-line">$3F00 = 背景色 (镜像到 $3F10)</text>
      <text class="mirror-line">$3F04/$3F08/$3F0C 镜像到 $3F14/$3F18/$3F1C</text>
      <text class="mirror-line">实际可用: 13 个独立 BG 颜色 (1 通用背景 + 3×4) + 12 个 Sprite 颜色 (3×4) = 25 个独立色</text>
      <text class="mirror-line">0x0D 和 0x1D 不使用 (通常为黑色)</text>
    </view>
  </view>

  <!-- 选中颜色详情 -->
  <view class="section" wx:if="{{selectedColor}}">
    <text class="section-title">选中颜色详情</text>
    <view class="selected-info">
      <view class="selected-swatch" style="background:{{selectedColor.hex}};"></view>
      <view class="selected-details">
        <text>索引: ${{selectedColor.indexHex}} ({{selectedColor.index}})</text>
        <text>HEX: {{selectedColor.hex}}</text>
        <text>RGB: ({{selectedColor.r}}, {{selectedColor.g}}, {{selectedColor.b}})</text>
        <text>行: {{selectedColor.row}}, 列: {{selectedColor.col}} ({{selectedColor.emphasis}})</text>
      </view>
    </view>
  </view>
</view>
