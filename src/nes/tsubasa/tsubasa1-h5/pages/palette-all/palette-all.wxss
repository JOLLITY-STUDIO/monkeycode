/* Palette All 页面样式 */
page { background: #1a1a2e; color: #eee; }

.pal-container { padding: 16px; }

.header {
  background: rgba(255,255,255,0.05);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  border: 1px solid rgba(255,255,255,0.1);
}

.title { display: block; font-size: 28px; font-weight: bold; }
.subtitle { font-size: 18px; color: #888; margin-top: 4px; }

.section {
  background: rgba(255,255,255,0.03);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  border: 1px solid rgba(255,255,255,0.08);
}

.section-title { display: block; font-size: 24px; font-weight: bold; margin-bottom: 4px; }
.section-desc { display: block; font-size: 16px; color: #888; margin-bottom: 12px; }

/* 主调色板 64 色 */
.master-palette { display: flex; flex-direction: column; gap: 8px; }

.pal-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.row-label {
  font-size: 14px;
  font-family: monospace;
  color: #888;
  min-width: 40px;
}

.color-cell {
  width: 72px;
  height: 72px;
  border-radius: 6px;
  border: 2px solid rgba(255,255,255,0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: border-color 0.15s;
}

.color-cell:active { border-color: #fff; }

.color-index {
  font-size: 16px;
  font-weight: bold;
  font-family: monospace;
  text-shadow: 0 0 4px rgba(0,0,0,0.8);
}

.color-hex {
  font-size: 11px;
  font-family: monospace;
  text-shadow: 0 0 4px rgba(0,0,0,0.8);
}

.color-rgb {
  font-size: 10px;
  font-family: monospace;
  text-shadow: 0 0 4px rgba(0,0,0,0.8);
}

/* PPU 调色板 */
.ppu-palette {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.ppu-pal-group {
  background: rgba(0,0,0,0.3);
  border-radius: 8px;
  padding: 10px;
  min-width: 160px;
}

.ppu-group-name {
  display: block;
  font-size: 18px;
  font-weight: bold;
}

.ppu-group-addr {
  display: block;
  font-size: 14px;
  font-family: monospace;
  color: #888;
  margin-bottom: 6px;
}

.ppu-colors {
  display: flex;
  gap: 4px;
}

.ppu-color {
  width: 56px;
  height: 56px;
  border-radius: 6px;
  border: 2px solid rgba(255,255,255,0.2);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.ppu-nes-idx {
  font-size: 12px;
  font-family: monospace;
  color: rgba(255,255,255,0.8);
  background: rgba(0,0,0,0.5);
  padding: 1px 4px;
  border-radius: 3px;
  margin-bottom: 2px;
}

/* 镜像说明 */
.mirror-info { margin-top: 8px; }

.mirror-line {
  display: block;
  font-size: 16px;
  color: #aaa;
  margin: 4px 0;
  font-family: monospace;
}

/* 选中颜色 */
.selected-info {
  display: flex;
  align-items: center;
  gap: 16px;
}

.selected-swatch {
  width: 80px;
  height: 80px;
  border-radius: 12px;
  border: 3px solid #fff;
}

.selected-details {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 20px;
  font-family: monospace;
  color: #ccc;
}
