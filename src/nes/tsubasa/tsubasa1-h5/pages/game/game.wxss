/* 游戏页面样式 */
.game-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  background: #111;
  position: relative;
  overflow: hidden;
}

.game-canvas {
  /* 使用固定像素宽度确保 canvas 缓冲区不被 CSS 二次缩放
   * NES 256×240 × 2倍缩放 = 512×480
   * 在小屏幕设备上会被截断但不会变糊 */
  width: 512px;
  height: 480px;
  margin-top: 20rpx;
  border: 4rpx solid #555;
  /* 关键: 在小屏幕上允许 canvas 溢出而非缩小 */
  flex-shrink: 0;
}

.controls {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 40rpx;
}

.dpad {
  display: grid;
  grid-template-columns: 80rpx 80rpx 80rpx;
  grid-template-rows: 80rpx 80rpx 80rpx;
  gap: 4rpx;
}

.dpad-up    { grid-column: 2; grid-row: 1; }
.dpad-left  { grid-column: 1; grid-row: 2; }
.dpad-right { grid-column: 3; grid-row: 2; }
.dpad-down  { grid-column: 2; grid-row: 3; }

.action-btns {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn:active {
  background: rgba(255, 255, 255, 0.4);
}

.btn-a     { background: rgba(255, 0, 0, 0.25); border-color: rgba(255, 0, 0, 0.5); }
.btn-b     { background: rgba(255, 255, 0, 0.25); border-color: rgba(255, 255, 0, 0.5); }
.btn-start { font-size: 22rpx; }
