/* 游戏页面样式 */
.game-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  background: #111;
  position: relative;
  overflow: hidden;
}

.game-canvas {
  /* Canvas 缓冲区恒�?256×240，CSS 控制视觉显示尺寸 */
  width: 256px;
  height: 240px;
  margin-top: 12px;
  border: 4px solid #555;
  flex-shrink: 0;
}

/* ── 状态信息栏 ── */
.info-bar {
  position: fixed;
  top: 20px;
  right: 20px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
  z-index: 100;
}

.fps-text {
  color: #0f0;
  font-size: 20px;
  font-family: monospace;
  background: rgba(0, 0, 0, 0.6);
  padding: 4px 12px;
  border-radius: 8px;
}

.auto-btn {
  width: 100px;
  height: 50px;
  border-radius: 25px;
  background: rgba(100, 100, 100, 0.5);
  border: 2px solid rgba(255, 255, 255, 0.3);
  color: #ccc;
  font-size: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.auto-btn.auto-active {
  background: rgba(0, 200, 100, 0.6);
  border-color: rgba(0, 255, 100, 0.7);
  color: #fff;
  font-weight: bold;
}

/* ── 自动播放日志 ── */
.auto-log {
  position: fixed;
  bottom: 200px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.75);
  color: #0f0;
  font-size: 22px;
  font-family: monospace;
  padding: 8px 24px;
  border-radius: 16px;
  z-index: 99;
  max-width: 80vw;
  text-align: center;
}

.controls {
  position: fixed;
  bottom: 60px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 40px;
}

.dpad {
  display: grid;
  grid-template-columns: 80px 80px 80px;
  grid-template-rows: 80px 80px 80px;
  gap: 4px;
}

.dpad-up    { grid-column: 2; grid-row: 1; }
.dpad-left  { grid-column: 1; grid-row: 2; }
.dpad-right { grid-column: 3; grid-row: 2; }
.dpad-down  { grid-column: 2; grid-row: 3; }

.action-btns {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
}

.btn {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 3px solid rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn:active {
  background: rgba(255, 255, 255, 0.4);
}

.btn-a     { background: rgba(255, 0, 0, 0.25); border-color: rgba(255, 0, 0, 0.5); }
.btn-b     { background: rgba(255, 255, 0, 0.25); border-color: rgba(255, 255, 0, 0.5); }
.btn-start { font-size: 22px; }
