/* 天使之翼1 — 游戏主页面样式 */

.game-page {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #1a1a2e;
  padding-top: 20rpx;
  box-sizing: border-box;
}

/* NES画布区域: 原始256x240 */
.canvas-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #000;
  border: 2px solid #333;
  border-radius: 4px;
  overflow: hidden;
}

.game-canvas {
  display: block;
  width: 256px;
  height: 240px;
  image-rendering: pixelated;
}

/* 控制面板 (画布下方) */
.control-panel {
  width: 256px;
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 实时数据面板 */
.debug-panel {
  background: rgba(0, 0, 0, 0.8);
  padding: 12rpx 16rpx;
  border-radius: 4px;
  border: 1px solid #333;
}

.debug-text {
  display: flex;
  flex-direction: column;
  color: #0f0;
  font-size: 22rpx;
  font-family: monospace;
  line-height: 1.8;
}

/* 比赛实时信息 */
.match-info {
  margin-top: 12rpx;
  padding: 12rpx;
  background: rgba(255, 255, 0, 0.05);
  border: 1px dashed #555;
  border-radius: 4rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.match-score {
  color: #ff0;
  font-size: 36rpx;
  font-weight: bold;
  font-family: monospace;
  text-align: center;
}

.match-timer {
  color: #0af;
  font-size: 22rpx;
  font-family: monospace;
}

.match-phase {
  color: #f80;
  font-size: 20rpx;
  font-family: monospace;
}

.match-events {
  color: #aaa;
  font-size: 18rpx;
  font-family: monospace;
}

/* AI模式指示器 */
.ai-indicator {
  background: rgba(255, 165, 0, 0.85);
  padding: 8rpx 16rpx;
  border-radius: 4px;
}

.ai-indicator text {
  color: #fff;
  font-size: 22rpx;
}

/* 按钮行 */
.btn-row {
  display: flex;
  gap: 16rpx;
}

.ctrl-btn {
  color: #fff;
  background-color: #444;
  border: none;
  font-size: 22rpx;
}

/* 数据查看器链接 */
.debug-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 8rpx 0;
}

.debug-link {
  color: #8af;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 4rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
  text-decoration: none;
}
