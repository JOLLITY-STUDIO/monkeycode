/* 游戏页面样式 */
.game-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  background: #111;
  position: relative;
  overflow: hidden;
}

.game-canvas {
  /* NES 原始分辨率 256×240 */
  width: 256px;
  height: 240px;
  margin-top: 12rpx;
  border: 4rpx solid #555;
  flex-shrink: 0;
}

/* ── 状态信息栏 ── */
.info-bar {
  position: fixed;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  z-index: 100;
}

.fps-text {
  color: #0f0;
  font-size: 20rpx;
  font-family: monospace;
  background: rgba(0, 0, 0, 0.6);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.auto-btn {
  width: 100rpx;
  height: 50rpx;
  border-radius: 25rpx;
  background: rgba(100, 100, 100, 0.5);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  color: #ccc;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.auto-btn.auto-active {
  background: rgba(0, 200, 100, 0.6);
  border-color: rgba(0, 255, 100, 0.7);
  color: #fff;
  font-weight: bold;
}

/* ── 自动播放日志 ── */
.auto-log {
  position: fixed;
  bottom: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.75);
  color: #0f0;
  font-size: 22rpx;
  font-family: monospace;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  z-index: 99;
  max-width: 80vw;
  text-align: center;
}

.controls {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 40rpx;
}

.dpad {
  display: grid;
  grid-template-columns: 80rpx 80rpx 80rpx;
  grid-template-rows: 80rpx 80rpx 80rpx;
  gap: 4rpx;
}

.dpad-up    { grid-column: 2; grid-row: 1; }
.dpad-left  { grid-column: 1; grid-row: 2; }
.dpad-right { grid-column: 3; grid-row: 2; }
.dpad-down  { grid-column: 2; grid-row: 3; }

.action-btns {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn:active {
  background: rgba(255, 255, 255, 0.4);
}

.btn-a     { background: rgba(255, 0, 0, 0.25); border-color: rgba(255, 0, 0, 0.5); }
.btn-b     { background: rgba(255, 255, 0, 0.25); border-color: rgba(255, 255, 0, 0.5); }
.btn-start { font-size: 22rpx; }
