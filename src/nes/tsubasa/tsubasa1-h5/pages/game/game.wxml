<!-- 天使之翼1 — 游戏主页面 -->
<view class="game-page">
  <!-- NES游戏画布 256x240 原始分辨率 -->
  <view class="canvas-wrapper">
    <canvas 
      type="2d" 
      id="game-canvas" 
      class="game-canvas"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    ></canvas>
  </view>
  
  <!-- 控制面板 (画布下方) -->
  <view class="control-panel">
    <!-- 实时数据面板 -->
    <view class="debug-panel" wx:if="{{showDebug}}">
      <view class="debug-text">
        <text>帧: {{debugInfo.frame}} | 状态: {{debugInfo.gameStateName}}</text>
        <text>比分: {{debugInfo.scoreA}} - {{debugInfo.scoreB}}</text>
        <text>阶段: {{debugInfo.matchPhase}} | FPS: {{fps}}</text>
      </view>
      <!-- 比赛专用信息 -->
      <view class="match-info" wx:if="{{debugInfo.gameStateName === 'MATCH_LOOP' || debugInfo.gameStateName === 'MATCH_INIT'}}">
        <text class="match-score">⚽ {{debugInfo.scoreA}} - {{debugInfo.scoreB}}</text>
        <text class="match-timer">⏱ {{matchDebug.time}}</text>
        <text class="match-phase">{{matchDebug.phaseText}}</text>
        <text class="match-events" wx:for="{{matchDebug.events}}" wx:key="index">{{item}}</text>
      </view>
    </view>

    <!-- AI模式指示器 -->
    <view class="ai-indicator" wx:if="{{aiMode}}">
      <text>🤖 AI自动模式</text>
    </view>

    <!-- 按钮区 -->
    <view class="btn-row">
      <button class="ctrl-btn" size="mini" bind:tap="toggleDebug">📊 数据</button>
      <button class="ctrl-btn" size="mini" bind:tap="toggleAi">AI</button>
    </view>
    
    <!-- 数据查看器链接 -->
    <view class="debug-links" wx:if="{{showDebug}}">
      <navigator url="/pages/database/render-viewer/render-viewer" class="debug-link">🎬 渲染管线</navigator>
      <navigator url="/pages/database/nametable-all/nametable-all" class="debug-link">🗺️ NT表</navigator>
      <navigator url="/pages/database/sprite-all/sprite-all" class="debug-link">👻 精灵</navigator>
      <navigator url="/pages/database/palette-all/palette-all" class="debug-link">🎨 调色板</navigator>
      <navigator url="/pages/database/chr-all/chr-all" class="debug-link">🖼️ CHR</navigator>
      <navigator url="/pages/database/pattern-table-all/pattern-table-all" class="debug-link">📊 图案表</navigator>
      <navigator url="/pages/database/data-api/data-api" class="debug-link">📋 数据API</navigator>
    </view>
  </view>
</view>
