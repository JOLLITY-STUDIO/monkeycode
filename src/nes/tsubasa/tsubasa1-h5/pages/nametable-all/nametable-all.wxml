<!-- Nametable All - 名称表结构与属性表 -->
<view class="nt-container">
  <view class="header">
    <text class="title">Nametable 名称表 (NES VRAM 结构)</text>
    <text class="subtitle">4 个名称表 (32×30 tiles) + 属性表 (8×8 blocks) + 调色板</text>
    
    <view class="params">
      <view class="param-row">
        <text class="param-label">CHR Bank:</text>
        <input class="param-input" type="number" value="{{chrBank}}" bindinput="onChrBankInput" />
        <text class="param-hint">(0-31)</text>
      </view>
      <view class="param-row">
        <text class="param-label">名称表:</text>
        <view class="nt-tabs">
          <view wx:for="{{ntTabs}}" wx:key="nt"
            class="nt-tab {{currentNT === item.nt ? 'active' : ''}}"
            bindtap="onNTSelect" data-nt="{{item.nt}}"
          >{{item.label}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 名称表可视化绘制 -->
  <view class="nt-display">
    <text class="section-label">名称表 NT{{currentNT}} (tile 索引)</text>
    <canvas type="2d" id="nt-canvas" class="nt-canvas" style="width:{{ntW}}px;height:{{ntH}}px;"></canvas>
    <text class="hint-text">Zoom: {{zoom}}x - 显示 tile 索引 0x00-0xFF</text>
  </view>

  <!-- 属性表可视化 -->
  <view class="attr-display">
    <text class="section-label">属性表 AT{{currentNT}} (调色板分组, 16×15 blocks)</text>
    <canvas type="2d" id="attr-canvas" class="attr-canvas" style="width:{{attrW}}px;height:{{attrH}}px;"></canvas>
  </view>

  <!-- 调色板 -->
  <view class="palette-section">
    <text class="section-label">调色板 (32 字节, $3F00-$3F1F)</text>
    <view class="palette-grid">
      <view wx:for="{{paletteGroups}}" wx:key="index" class="pal-group">
        <text class="pal-group-label">{{item.name}}</text>
        <view class="pal-colors">
          <view wx:for="{{item.colors}}" wx:for-item="c" wx:key="*this" 
            class="pal-color" style="background:{{c.hex}};">
            <text class="pal-idx">{{c.idxHex}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 名称表 Tile 数据表格 -->
  <view class="nt-data-table">
    <text class="section-label">名称表 NT{{currentNT}} 原始数据 (前16行 × 32列)</text>
    <scroll-view scroll-x class="table-scroll">
      <view class="data-grid">
        <view wx:for="{{ntDataRows}}" wx:key="*this" class="data-row">
          <view wx:for="{{item}}" wx:for-item="v" wx:key="hex" class="data-cell {{v.val === 0 ? 'empty' : ''}}">
            {{v.hex}}
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
