.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #1a1a2e;
  color: #e0e0e0;
}
.toolbar {
  padding: 8px 12px;
  background: #16213e;
  flex-shrink: 0;
}
.title {
  font-size: 15px;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 6px;
}
.controls {
  display: flex;
  align-items: center;
  gap: 8px;
}
.bank-label {
  font-size: 13px;
  color: #aaa;
  min-width: 40px;
  text-align: center;
}
.stats-bar {
  padding: 4px 12px;
  background: rgba(0,0,0,0.3);
  font-size: 11px;
  color: #8af;
  font-family: monospace;
  flex-shrink: 0;
}
.sprite-list {
  flex: 1;
  overflow-y: auto;
  padding: 4px;
}
.sprite-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  justify-content: center;
}
.sprite-card {
  width: 80px;
  background: #0d1117;
  border: 1px solid #333;
  border-radius: 4px;
  padding: 2px;
  text-align: center;
}
.sprite-card.active {
  border-color: #4a9eff;
}
.sprite-card.inactive {
  opacity: 0.4;
}
.spr-canvas {
  width: 64px;
  height: 64px;
  display: block;
  margin: 0 auto;
}
.spr-info {
  font-size: 9px;
  line-height: 1.1;
  margin-top: 2px;
}
.spr-idx { color: #ffd700; }
.spr-coord { color: #8cf; }
.spr-tile { color: #8f8; }
.spr-attr { color: #f8a; }
