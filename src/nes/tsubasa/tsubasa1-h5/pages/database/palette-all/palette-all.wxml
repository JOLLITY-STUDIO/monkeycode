<!-- 调色板数据库查看器 -->
<view class="container">
  <view class="toolbar">
    <view class="title">🎨 调色板数据库 (ROM静态数据)</view>
    <view class="subtitle">{{dbStatus}}</view>
  </view>

  <scroll-view class="content" scroll-y>
    <!-- 系统调色板 (64色) -->
    <view class="section">
      <view class="section-title">NES 系统调色板 (64色) — 硬件定义，永不改变</view>
      <view class="color-grid">
        <view 
          class="color-cell"
          wx:for="{{systemPalette}}" wx:key="index"
          style="background: rgb({{item.r}},{{item.g}},{{item.b}})"
          data-index="{{item.index}}"
          bindtap="onColorTap"
        >
          <text class="color-label">{{item.hex}}</text>
        </view>
      </view>
    </view>

    <!-- 场景调色板 (每组来自ROM) -->
    <view class="section" wx:for="{{scenePalettes}}" wx:key="id" wx:for-item="scene">
      <view class="section-title">
        📋 场景: {{scene.entry.scene}} 
        <text class="source-tag">(Bank {{scene.entry.bankId}} @ ${{scene.entry.offset.toString(16).toUpperCase()}})</text>
      </view>

      <!-- 背景调色板 -->
      <view class="sub-title">背景调色板 (4组×4色)</view>
      <view class="palette-row" wx:for="{{scene.bgGroups}}" wx:key="index" wx:for-item="pal" wx:for-index="pi">
        <text class="pal-label">BG{{pi}}</text>
        <view 
          class="color-swatch"
          wx:for="{{pal}}" wx:key="cidx" wx:for-item="c"
          style="background: rgb({{c.r}},{{c.g}},{{c.b}})"
        >
          <text class="swatch-label">{{c.hex}}</text>
        </view>
      </view>

      <!-- 精灵调色板 -->
      <view class="sub-title">精灵调色板 (4组×4色)</view>
      <view class="palette-row" wx:for="{{scene.sprGroups}}" wx:key="index" wx:for-item="pal" wx:for-index="pi">
        <text class="pal-label">SPR{{pi}}</text>
        <view 
          class="color-swatch"
          wx:for="{{pal}}" wx:key="cidx" wx:for-item="c"
          style="background: rgb({{c.r}},{{c.g}},{{c.b}})"
        >
          <text class="swatch-label">{{c.hex}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
