.container {
  min-height: 100vh;
  background: #1a1a2e;
  color: #e0e0e0;
  padding-bottom: 20px;
}
.toolbar {
  padding: 10px 12px;
  background: #16213e;
}
.title { font-size: 16px; font-weight: bold; color: #ffd700; }
.subtitle { font-size: 11px; color: #888; margin-top: 4px; }
.section { padding: 8px 12px; }
.section-title {
  font-size: 13px;
  color: #8cf;
  border-bottom: 1px solid #333;
  padding-bottom: 4px;
  margin-bottom: 8px;
}
.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
}
.color-cell {
  width: 40px;
  height: 32px;
  border-radius: 3px;
  border: 1px solid #444;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  cursor: pointer;
}
.color-label {
  font-size: 7px;
  color: rgba(255,255,255,0.7);
  background: rgba(0,0,0,0.5);
  padding: 1px 3px;
  border-radius: 2px;
}
.palette-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 8px;
}
.pal-label {
  font-size: 11px;
  color: #aaa;
  min-width: 30px;
}
.color-swatch {
  width: 48px;
  height: 36px;
  border-radius: 4px;
  border: 1px solid #555;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.swatch-label {
  font-size: 7px;
  color: rgba(255,255,255,0.7);
  background: rgba(0,0,0,0.5);
  padding: 1px 2px;
  border-radius: 2px;
}
.pal-preview {
  margin-left: 8px;
}
.preview-canvas {
  width: 64px;
  height: 24px;
  border: 1px solid #333;
}
