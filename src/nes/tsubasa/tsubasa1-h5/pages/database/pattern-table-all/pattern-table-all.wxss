.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #1a1a2e;
  color: #e0e0e0;
}
.toolbar {
  padding: 8px 12px;
  background: #16213e;
  flex-shrink: 0;
  border-bottom: 1px solid #333;
}
.title { font-size: 16px; font-weight: bold; color: #ffd700; margin-bottom: 4px; }
.controls { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.label { font-size: 11px; color: #aaa; }
.bank-num { font-size: 13px; color: #fff; min-width: 24px; text-align: center; }
.sep { color: #555; }
.subtitle { font-size: 10px; color: #666; margin-top: 4px; }
.content { flex: 1; overflow-y: auto; padding: 8px; }
.table-section { margin-bottom: 12px; }
.table-title {
  font-size: 13px; color: #8cf;
  padding: 4px 0; margin-bottom: 4px;
}
.pt-canvas {
  width: 100%;
  max-width: 384px;
  border: 1px solid #333;
  display: block;
  margin: 0 auto;
}
