<!-- Pattern Table 数据查看器 -->
<view class="container">
  <view class="toolbar">
    <view class="title">Pattern Table 查看</view>
    <view class="controls">
      <text class="label">CHR Bank 0 ($0000-$0FFF):</text>
      <button size="mini" bindtap="onPrevChr0">◀</button>
      <text class="bank-num">{{chrBank0}}</text>
      <button size="mini" bindtap="onNextChr0">▶</button>
      <text class="sep">|</text>
      <text class="label">CHR Bank 1 ($1000-$1FFF):</text>
      <button size="mini" bindtap="onPrevChr1">◀</button>
      <text class="bank-num">{{chrBank1}}</text>
      <button size="mini" bindtap="onNextChr1">▶</button>
    </view>
    <view class="subtitle">每个 Bank: 256 tiles (16×16 grid), 每 tile 8×8 像素</view>
  </view>

  <scroll-view class="content" scroll-y>
    <view class="table-section" wx:if="{{showChr0}}">
      <view class="table-title">Pattern Table 0 — CHR Bank {{chrBank0}}</view>
      <canvas type="2d" id="pt0-canvas" class="pt-canvas"></canvas>
    </view>
    <view class="table-section" wx:if="{{showChr1}}">
      <view class="table-title">Pattern Table 1 — CHR Bank {{chrBank1}}</view>
      <canvas type="2d" id="pt1-canvas" class="pt-canvas"></canvas>
    </view>
  </scroll-view>
</view>
