.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #1a1a2e;
  color: #e0e0e0;
}
.toolbar {
  padding: 10px 12px;
  background: #16213e;
  flex-shrink: 0;
  border-bottom: 1px solid #333;
}
.title { font-size: 16px; font-weight: bold; color: #ffd700; }
.subtitle { font-size: 11px; color: #888; margin-top: 4px; }
.content {
  flex: 1;
  overflow-y: auto;
  padding: 8px;
}
.endpoint {
  background: #0d1117;
  border: 1px solid #2a2a3a;
  border-radius: 6px;
  padding: 10px 12px;
  margin-bottom: 8px;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 8px;
}
.method {
  padding: 2px 8px;
  border-radius: 3px;
  font-size: 11px;
  font-weight: bold;
  min-width: 40px;
  text-align: center;
}
.method.get { background: #1a5c1a; color: #4f8; }
.method.post { background: #1a3a5c; color: #8cf; }
.path {
  font-family: monospace;
  font-size: 13px;
  color: #4a9eff;
  min-width: 140px;
}
.desc {
  font-size: 12px;
  color: #aaa;
}
.detail {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding-left: 12px;
  font-size: 11px;
  color: #666;
}
.status-done { color: #4f8; }
.status-pending { color: #f84; }
.footer {
  padding: 8px 12px;
  background: #16213e;
  font-size: 11px;
  color: #666;
  flex-shrink: 0;
  border-top: 1px solid #333;
  text-align: center;
}
