<!-- 数据API查看器 (Swagger风格) -->
<view class="container">
  <view class="toolbar">
    <view class="title">📊 数据 API 查看器 (Swagger 风格)</view>
    <view class="subtitle">查看 ROM 数据访问层接口和数据表</view>
  </view>

  <scroll-view class="content" scroll-y>
    <!-- 球员表 -->
    <view class="endpoint">
      <view class="method get">GET</view>
      <text class="path">/api/players</text>
      <text class="desc">球员数据表</text>
      <view class="detail">
        <text>字段: id, name, position, shoot, pass, dribble, tackle, speed, stamina, specialMoves[]</text>
        <text class="status-pending">状态: 🔲 待提取 (Bank 3)</text>
      </view>
    </view>

    <!-- 球队表 -->
    <view class="endpoint">
      <view class="method get">GET</view>
      <text class="path">/api/teams</text>
      <text class="desc">球队数据表</text>
      <view class="detail">
        <text>字段: id, name, playerIds[], formation, style</text>
        <text class="status-pending">状态: 🔲 待提取 (Bank 3)</text>
      </view>
    </view>

    <!-- 事件脚本表 -->
    <view class="endpoint">
      <view class="method get">GET</view>
      <text class="path">/api/events</text>
      <text class="desc">事件脚本表 (剧情/文本)</text>
      <view class="detail">
        <text>字段: id, data[] (脚本字节码)</text>
        <text class="status-pending">状态: 🔲 待提取 (Bank 7)</text>
      </view>
    </view>

    <!-- 文本表 -->
    <view class="endpoint">
      <view class="method get">GET</view>
      <text class="path">/api/texts</text>
      <text class="desc">文本数据表</text>
      <view class="detail">
        <text>字段: id, tiles[] (tile索引序列)</text>
        <text class="status-pending">状态: 🔲 待提取 (Bank 7)</text>
      </view>
    </view>

    <!-- 比赛配置表 -->
    <view class="endpoint">
      <view class="method get">GET</view>
      <text class="path">/api/matches</text>
      <text class="desc">比赛配置表 (赛程/对阵)</text>
      <view class="detail">
        <text>字段: id, teamA, teamB, stage, events[]</text>
        <text class="status-pending">状态: 🔲 待提取 (Bank 7)</text>
      </view>
    </view>

    <!-- CHR资源 -->
    <view class="endpoint">
      <view class="method get">GET</view>
      <text class="path">/api/chr/:bankId</text>
      <text class="desc">CHR Bank 数据 (32 Banks, 各4KB)</text>
      <view class="detail">
        <text>字段: bankId (0-31), data (Uint8Array[4096])</text>
        <text class="status-done">状态: ✅ 已加载</text>
      </view>
    </view>

    <!-- PRG资源 -->
    <view class="endpoint">
      <view class="method get">GET</view>
      <text class="path">/api/prg/:bankId</text>
      <text class="desc">PRG Bank 数据 (8 Banks, 各16KB)</text>
      <view class="detail">
        <text>字段: bankId (0-7), data (Uint8Array[16384])</text>
        <text class="status-done">状态: ✅ 已加载 (prg_bulk.json)</text>
      </view>
    </view>
  </scroll-view>

  <view class="footer">
    <text>Tip: 在游戏运行中可实时查看 DataStore 状态</text>
  </view>
</view>
