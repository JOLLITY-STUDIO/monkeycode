.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #1a1a2e;
  color: #e0e0e0;
  overflow: hidden;
}

/* ===== 工具栏 ===== */
.toolbar {
  padding: 8px 12px;
  background: #16213e;
  flex-shrink: 0;
}
.title {
  font-size: 15px;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 4px;
}
.tab-bar {
  display: flex;
  margin-bottom: 4px;
  border-radius: 6px;
  overflow: hidden;
}
.tab {
  padding: 5px 16px;
  font-size: 13px;
  background: #2a2a4a;
  color: #aaa;
  cursor: pointer;
  transition: 0.15s;
}
.tab.active {
  background: #ffd700;
  color: #1a1a2e;
  font-weight: bold;
}
.source-hint {
  font-size: 10px;
  color: #888;
}

/* ===== 数据视图 ===== */
.data-scroll {
  flex: 1;
  overflow: auto;
  padding: 8px;
}

.nt-section {
  margin-bottom: 24px;
  border: 1px solid #333;
  border-radius: 6px;
  overflow: hidden;
}

.nt-section-title {
  font-size: 12px;
  font-weight: bold;
  color: #ffd700;
  background: #16213e;
  padding: 6px 10px;
  position: sticky;
  top: 0;
  z-index: 1;
}

/* Tile 数据表格 */
.data-table {
  overflow-x: auto;
  padding: 4px;
}

.tile-row {
  display: flex;
  white-space: nowrap;
}

.header-row {
  position: sticky;
  top: 28px;
  z-index: 1;
}

.tile-cell {
  display: inline-block;
  width: 26px;
  height: 16px;
  line-height: 16px;
  font-size: 9px;
  font-family: 'Courier New', monospace;
  text-align: center;
  color: #ccc;
  border-right: 1px solid rgba(255,255,255,0.04);
  border-bottom: 1px solid rgba(255,255,255,0.04);
}

.header-cell {
  color: #888;
  font-weight: bold;
  background: #1e1e38;
  font-size: 8px;
}

.corner-cell {
  width: 22px;
  background: #1e1e38;
}

.row-label {
  width: 22px;
  color: #888;
  font-weight: bold;
  background: #1e1e38;
  font-size: 8px;
}

/* Attribute 表 */
.attr-section {
  margin-top: 12px;
}

.attr-table {
  display: flex;
  flex-direction: column;
  padding: 6px;
  gap: 2px;
}

.attr-row {
  display: flex;
  gap: 4px;
}

.attr-cell {
  display: inline-block;
  width: 34px;
  height: 20px;
  line-height: 20px;
  font-size: 11px;
  font-family: 'Courier New', monospace;
  text-align: center;
  background: #1e1e38;
  color: #aaa;
  border: 1px solid #333;
  border-radius: 3px;
}

/* ===== 可视化视图 ===== */
.canvas-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 4px;
}

.canvas-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 8px;
}

.nt-row-label {
  font-size: 11px;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 2px;
  text-align: center;
  width: 100%;
  background: #16213e;
  padding: 2px 0;
}

.nt-canvas {
  border: 1px solid #333;
  display: block;
}

/* ===== 底部信息栏 ===== */
.info-bar {
  padding: 4px 12px;
  background: #16213e;
  font-size: 11px;
  color: #888;
  flex-shrink: 0;
  display: flex;
  gap: 12px;
}
