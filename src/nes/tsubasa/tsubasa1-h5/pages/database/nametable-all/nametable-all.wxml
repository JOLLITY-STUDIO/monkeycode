<!-- Nametable 数据库查看器 — ROM静态数据 -->
<view class="container">
  <view class="toolbar">
    <view class="title">🗺 Nametable 数据库 (ROM静态模板)</view>
    <view class="subtitle">{{dbStatus}}</view>
  </view>

  <scroll-view class="content" scroll-y>
    <!-- 模板列表 -->
    <view class="section">
      <view class="section-title">Nametable 模板列表 ({{templates.length}} 个)</view>
      
      <view 
        class="template-item {{selectedIdx === index ? 'active' : ''}}"
        wx:for="{{templates}}" wx:key="id" wx:for-index="index"
        data-index="{{index}}"
        bindtap="onSelectTemplate"
      >
        <view class="template-info">
          <text class="template-name">{{item.scene}}</text>
          <text class="template-id">{{item.id}}</text>
        </view>
        <view class="template-meta">
          <text class="meta-item">Bank {{item.bankId}}</text>
          <text class="meta-item">${{item.offset.toString(16).toUpperCase()}}</text>
          <text class="meta-item">{{item.rleCompressed ? 'RLE压缩' : '原始'}}</text>
          <text class="meta-item {{item.loaded ? 'loaded' : 'pending'}}">{{item.loaded ? '✅' : '🔲'}}</text>
        </view>
      </view>
    </view>

    <!-- 可视化区域 (选中模板后显示) -->
    <view class="section" wx:if="{{selectedIdx >= 0}}">
      <view class="section-title">
        可视化: {{templates[selectedIdx].scene}} 
        <text class="source-tag">(Bank {{templates[selectedIdx].bankId}})</text>
      </view>
      <view class="canvas-wrapper">
        <canvas type="2d" id="nt-db-canvas" class="nt-canvas"></canvas>
      </view>
    </view>

    <!-- Tile 网格数据 (选中后显示) -->
    <view class="section" wx:if="{{selectedIdx >= 0 && tileGrid.length > 0}}">
      <view class="section-title">Tile 索引数据 (HEX, 32×30)</view>
      <scroll-view class="data-scroll" scroll-x scroll-y enhanced show-scrollbar>
        <view class="data-table">
          <!-- 列头 -->
          <view class="tile-row header-row">
            <text class="tile-cell header-cell">R\C</text>
            <text class="tile-cell header-cell" wx:for="{{colHeaders}}" wx:key="*this">{{item}}</text>
          </view>
          <!-- 数据行 -->
          <view class="tile-row" wx:for="{{tileGrid}}" wx:key="*this" wx:for-index="r">
            <text class="tile-cell header-cell">{{rowLabels[r]}}</text>
            <text class="tile-cell" wx:for="{{item}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 未选中提示 -->
    <view class="empty-hint" wx:if="{{selectedIdx < 0}}">
      <text>👆 点击上方模板查看详情</text>
      <text class="hint-sub">RLE压缩数据需Bank 1解压引擎实现后才能解码</text>
    </view>
  </scroll-view>
</view>
