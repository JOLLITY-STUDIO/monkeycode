.container {
  min-height: 100vh;
  background: #1a1a2e;
  color: #e0e0e0;
  padding-bottom: 20px;
}
.toolbar {
  padding: 10px 12px;
  background: #16213e;
}
.title { font-size: 16px; font-weight: bold; color: #ffd700; }
.subtitle { font-size: 11px; color: #888; margin-top: 4px; }
.section { padding: 8px 12px; }
.section-title {
  font-size: 13px;
  color: #8cf;
  border-bottom: 1px solid #333;
  padding-bottom: 4px;
  margin-bottom: 8px;
}
.track-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.track-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 8px;
  background: #0d1117;
  border-radius: 4px;
}
.track-id { color: #ffd700; font-size: 12px; min-width: 30px; }
.track-name { flex: 1; font-size: 13px; }
.track-size { color: #888; font-size: 11px; }
.track-status { font-size: 12px; }
.loaded { color: #4f8; }
.pending { color: #f84; }
.notice {
  margin: 16px 12px;
  padding: 10px;
  background: #2a1a1a;
  border-radius: 6px;
  font-size: 12px;
  color: #f88;
}
