<!-- 音频资源数据库查看器 — ROM静态数据 -->
<view class="container">
  <view class="toolbar">
    <view class="title">🎵 音频资源数据库 (ROM静态数据)</view>
    <view class="subtitle">{{dbStatus}}</view>
  </view>
  
  <!-- BGM列表 -->
  <view class="section">
    <view class="section-title">BGM 背景音乐 ({{loadedBgm}}/{{totalBgm}} 已提取)</view>
    <view class="track-list">
      <view class="track-item" wx:for="{{bgmList}}" wx:key="id" data-index="{{index}}" data-type="bgm" bindtap="onAudioTap">
        <text class="track-id">BGM{{item.id}}</text>
        <text class="track-name">{{item.name}}</text>
        <text class="track-source">Bank {{item.bankId}}</text>
        <text class="track-status {{item.loaded ? 'loaded' : 'pending'}}">
          {{item.loaded ? '✅ 已提取' : '🔲 待提取'}}
        </text>
      </view>
    </view>
  </view>

  <!-- SFX列表 -->
  <view class="section">
    <view class="section-title">SFX 音效 ({{loadedSfx}}/{{totalSfx}} 已提取)</view>
    <view class="track-list">
      <view class="track-item" wx:for="{{sfxList}}" wx:key="id" data-index="{{index}}" data-type="sfx" bindtap="onAudioTap">
        <text class="track-id">SFX{{item.id}}</text>
        <text class="track-name">{{item.name}}</text>
        <text class="track-source">Bank {{item.bankId}}</text>
        <text class="track-status {{item.loaded ? 'loaded' : 'pending'}}">
          {{item.loaded ? '✅ 已提取' : '🔲 待提取'}}
        </text>
      </view>
    </view>
  </view>

  <view class="notice">
    <text>⚠️ 音频引擎尚未实现 — Bank 5 APU数据待从ROM提取和解析</text>
  </view>
</view>
