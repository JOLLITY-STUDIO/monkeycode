/* 渲染管线数据查看器样式 */
.render-viewer-page {
  width: 100%;
  min-height: 100vh;
  background: #0a0a1a;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 20rpx;
}

.mode-bar {
  display: flex;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  width: 100%;
  box-sizing: border-box;
  background: rgba(255,255,255,0.03);
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
  flex-wrap: wrap;
  justify-content: center;
}

.mode-btn {
  font-size: 22rpx !important;
  padding: 6rpx 16rpx !important;
  background: rgba(255,255,255,0.08) !important;
  color: #888 !important;
  border: 1rpx solid rgba(255,255,255,0.1) !important;
  border-radius: 6rpx !important;
}

.mode-btn.active {
  background: rgba(0, 180, 100, 0.25) !important;
  color: #4f4 !important;
  border-color: rgba(0, 255, 100, 0.3) !important;
}

.canvas-container {
  position: relative;
  margin-top: 8rpx;
  width: 512px;
  height: 480px;
}

.render-canvas {
  width: 512px;
  height: 480px;
  display: block;
}

.overlay-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 512px;
  height: 480px;
  pointer-events: none;
}

.info-panel {
  width: 512px;
  margin-top: 8rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 4rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 22rpx;
  color: #888;
  font-family: monospace;
}

.info-value {
  font-size: 22rpx;
  color: #ccc;
  font-family: monospace;
  text-align: right;
}
