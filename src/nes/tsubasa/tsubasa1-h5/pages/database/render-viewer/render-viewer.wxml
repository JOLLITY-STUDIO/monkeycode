<!-- 渲染管线数据查看器 -->
<view class="render-viewer-page">
  <!-- 视图模式切换 -->
  <view class="mode-bar">
    <button 
      class="mode-btn {{viewMode === 'render' ? 'active' : ''}}" 
      size="mini"
      data-mode="render"
      bind:tap="onSwitchMode"
    >渲染输出</button>
    <button 
      class="mode-btn {{viewMode === 'mask' ? 'active' : ''}}" 
      size="mini"
      data-mode="mask"
      bind:tap="onSwitchMode"
    >色彩标记</button>
    <button 
      class="mode-btn {{viewMode === 'ntmap' ? 'active' : ''}}" 
      size="mini"
      data-mode="ntmap"
      bind:tap="onSwitchMode"
    >NT映射</button>
    <button 
      class="mode-btn {{viewMode === 'sprites' ? 'active' : ''}}" 
      size="mini"
      data-mode="sprites"
      bind:tap="onSwitchMode"
    >精灵分布</button>
  </view>

  <!-- 画布区域 -->
  <view class="canvas-container">
    <canvas 
      type="2d"
      id="render-canvas"
      class="render-canvas"
    ></canvas>
    <canvas 
      type="2d"
      id="overlay-canvas"
      class="overlay-canvas"
    ></canvas>
  </view>

  <!-- 信息面板 -->
  <view class="info-panel">
    <view class="info-row">
      <text class="info-label">滚动</text>
      <text class="info-value">({{scrollX}}, {{scrollY}})</text>
    </view>
    <view class="info-row">
      <text class="info-label">镜像</text>
      <text class="info-value">{{mirroring}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">PPU</text>
      <text class="info-value">BG={{bgEnabled}} SPR={{sprEnabled}} L8={{bgLeft8}}/{{sprLeft8}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">精灵</text>
      <text class="info-value">活跃:{{spriteCount}} 后景:{{behindBgCount}} FPS:{{fps}}</text>
    </view>
    <view class="info-row" wx:if="{{ntRegions.length > 0}}">
      <text class="info-label">NT区域</text>
      <text class="info-value">
        <text wx:for="{{ntRegions}}" wx:key="ntIndex">
          NT{{item.ntIndex}}{{index < ntRegions.length - 1 ? ', ' : ''}}
        </text>
      </text>
    </view>
  </view>
</view>
