/* Sprite All 页面样式 */
page { background: #1a1a2e; color: #eee; }

.spr-container { padding: 16px; }

.header {
  background: rgba(255,255,255,0.05);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  border: 1px solid rgba(255,255,255,0.1);
}

.title { display: block; font-size: 28px; font-weight: bold; }
.subtitle { font-size: 18px; color: #888; margin: 4px 0 12px; }

.info-box {
  background: rgba(0,0,0,0.3);
  border-radius: 8px;
  padding: 10px 14px;
  margin: 8px 0 12px;
}

.info-title { display: block; font-size: 18px; font-weight: bold; margin-bottom: 4px; color: #aaa; }
.info-line { display: block; font-size: 15px; color: #777; margin: 2px 0; font-family: monospace; }

.controls {
  display: flex;
  gap: 16px;
  align-items: center;
  flex-wrap: wrap;
}

.param-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.param-label { font-size: 20px; color: #aaa; }

.param-input {
  width: 70px;
  height: 36px;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 6px;
  color: #fff;
  font-size: 20px;
  text-align: center;
}

.sprite-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
}

.sprite-card {
  background: rgba(255,255,255,0.03);
  border-radius: 6px;
  padding: 6px;
  border: 1px solid rgba(255,255,255,0.08);
  min-width: 80px;
  text-align: center;
}

.sprite-card.hidden-sprite {
  opacity: 0.3;
  border-style: dashed;
}

.sprite-visual {
  display: flex;
  justify-content: center;
  margin-bottom: 4px;
}

.spr-canvas {
  display: block;
  image-rendering: pixelated;
  border: 1px solid rgba(255,255,255,0.1);
  background: #000;
}

.sprite-info { color: #ccc; }

.spr-id {
  display: block;
  font-size: 14px;
  font-weight: bold;
  color: #4af;
  margin-bottom: 2px;
}

.spr-detail {
  display: block;
  font-size: 12px;
  font-family: monospace;
  color: #999;
}

.spr-flags {
  display: block;
  font-size: 11px;
  font-family: monospace;
  color: #4a4;
  margin-top: 2px;
}
