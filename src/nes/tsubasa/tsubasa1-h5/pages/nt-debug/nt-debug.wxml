<view class="container">
  <!-- 工具栏 -->
  <view class="toolbar">
    <view class="toolbar-row">
      <text class="label">BG Bank:</text>
      <view class="btn-group">
        <view class="btn {{bankSelect === 0 ? 'active' : ''}}" data-bank="0" catchtap="onBankSelect">31 (0x1F)</view>
        <view class="btn {{bankSelect === 1 ? 'active' : ''}}" data-bank="1" catchtap="onBankSelect">30 (0x1E)</view>
      </view>
    </view>
    <view class="toolbar-row">
      <text class="label">SP Bank:</text>
      <view class="btn-group">
        <view class="btn {{spriteBank === 0 ? 'active' : ''}}" data-bank="0" catchtap="onSpriteBankSelect">0</view>
        <view class="btn {{spriteBank === 1 ? 'active' : ''}}" data-bank="1" catchtap="onSpriteBankSelect">1</view>
        <view class="btn {{spriteBank === 28 ? 'active' : ''}}" data-bank="28" catchtap="onSpriteBankSelect">28</view>
        <view class="btn {{spriteBank === 29 ? 'active' : ''}}" data-bank="29" catchtap="onSpriteBankSelect">29</view>
        <view class="btn {{spriteBank === 30 ? 'active' : ''}}" data-bank="30" catchtap="onSpriteBankSelect">30</view>
        <view class="btn {{spriteBank === 31 ? 'active' : ''}}" data-bank="31" catchtap="onSpriteBankSelect">31</view>
      </view>
    </view>
    <view class="toolbar-row">
      <text class="label">Page:</text>
      <view class="btn-group">
        <view class="btn {{pageSelect === 0 ? 'active' : ''}}" data-page="0" catchtap="onPageSelect">P0</view>
        <view class="btn {{pageSelect === 1 ? 'active' : ''}}" data-page="1" catchtap="onPageSelect">P1</view>
        <view class="btn {{pageSelect === 2 ? 'active' : ''}}" data-page="2" catchtap="onPageSelect">P2</view>
        <view class="btn {{pageSelect === 3 ? 'active' : ''}}" data-page="3" catchtap="onPageSelect">P3</view>
      </view>
      <view class="btn {{showBg ? 'active' : ''}}" catchtap="onToggleBg">BG</view>
      <view class="btn {{showSprites ? 'active' : ''}}" catchtap="onToggleSprites">Spr</view>
      <view class="btn {{showGrid ? 'active' : ''}}" catchtap="onToggleGrid" style="margin-left:auto;">Grid</view>
    </view>
    <view class="toolbar-row">
      <text class="label">SP Y:</text>
      <view class="btn-group">
        <view class="btn {{spriteYOffset === -1 ? 'active' : ''}}" data-y="-1" catchtap="onYOffset">-1</view>
        <view class="btn {{spriteYOffset === 0 ? 'active' : ''}}" data-y="0" catchtap="onYOffset">0</view>
        <view class="btn {{spriteYOffset === 1 ? 'active' : ''}}" data-y="1" catchtap="onYOffset">+1</view>
      </view>
      <view class="btn {{swapOamYX ? 'active' : ''}}" catchtap="onSwapOamYX">YX</view>
      <view class="btn {{globalVFlip ? 'active' : ''}}" catchtap="onGlobalVFlip">VFlip</view>
      <view class="btn {{globalHFlip ? 'active' : ''}}" catchtap="onGlobalHFlip">HFlip</view>
    </view>
  </view>

  <!-- Canvas -->
  <view class="canvas-wrap">
    <canvas type="2d" id="nt-canvas" class="nt-canvas"></canvas>
  </view>

  <!-- 状态 -->
  <view class="status">
    <text>{{statusText}}</text>
    <text class="stats">{{stats}}</text>
  </view>
</view>
