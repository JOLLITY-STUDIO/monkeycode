.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0a0a1e;
  color: #ccc;
  font-size: 24rpx;
}

/* 工具栏 */
.toolbar {
  padding: 12rpx 16rpx;
  background: #12122a;
  border-bottom: 2rpx solid #1f1f4f;
  flex-shrink: 0;
}

.toolbar-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.toolbar-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #888;
  margin-right: 12rpx;
  min-width: 100rpx;
}

.btn-group {
  display: flex;
  gap: 8rpx;
}

.btn {
  padding: 6rpx 16rpx;
  background: #1a1a3e;
  color: #aaa;
  border: 2rpx solid #2a2a5e;
  border-radius: 8rpx;
  font-size: 22rpx;
  transition: all 0.15s;
}

.btn.active {
  background: #2a3a6e;
  color: #6cf;
  border-color: #6cf;
  box-shadow: 0 0 12rpx rgba(102, 204, 255, 0.3);
}

/* Canvas */
.canvas-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  overflow: hidden;
}

.nt-canvas {
  width: 512rpx;
  height: 480rpx;
  border: 1rpx solid #1f1f4f;
  image-rendering: pixelated;
}

/* 状态栏 */
.status {
  padding: 10rpx 16rpx;
  background: #12122a;
  border-top: 2rpx solid #1f1f4f;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}

.stats {
  color: #666;
  font-size: 20rpx;
}
