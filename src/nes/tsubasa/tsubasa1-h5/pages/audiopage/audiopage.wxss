/* 音频测试页面样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background: #1a1a2e;
  color: #eee;
  padding: 20px 16px;
  box-sizing: border-box;
  font-family: monospace;
}

.header {
  text-align: center;
  margin-bottom: 24px;
  padding: 16px;
  background: linear-gradient(135deg, #16213e, #0f3460);
  border-radius: 12px;
}

.title {
  display: block;
  font-size: 28px;
  font-weight: bold;
  color: #4CAF50;
}

.subtitle {
  display: block;
  font-size: 16px;
  color: #888;
  margin-top: 6px;
}

.section {
  margin-bottom: 20px;
  background: rgba(255,255,255,0.05);
  border-radius: 10px;
  padding: 14px;
}

.section-title {
  font-size: 20px;
  font-weight: bold;
  color: #64b5f6;
  display: block;
  margin-bottom: 10px;
}

.value-text {
  color: #888;
  font-size: 16px;
  display: block;
  text-align: center;
  margin-top: 4px;
}

/* 曲目列表 */
.track-list {
  max-height: 240px;
}

.track-item {
  padding: 12px;
  margin: 4px 0;
  background: rgba(255,255,255,0.08);
  border-radius: 8px;
  border: 2px solid transparent;
  transition: all 0.2s;
}

.track-item.active {
  background: rgba(76, 175, 80, 0.2);
  border-color: #4CAF50;
}

.track-name {
  display: block;
  font-size: 18px;
  color: #eee;
}

.track-desc {
  display: block;
  font-size: 14px;
  color: #888;
  margin-top: 2px;
}

/* 控制按钮 */
.controls {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
  justify-content: center;
}

.btn {
  flex: 1;
  max-width: 120px;
  height: 48px;
  border-radius: 24px;
  font-size: 18px;
  font-weight: bold;
  border: none;
  background: rgba(255,255,255,0.1);
  color: #ccc;
}

.btn-play  { background: #4CAF50; color: #fff; }
.btn-pause { background: #FF9800; color: #fff; }
.btn-stop  { background: #f44336; color: #fff; }
.btn:disabled { opacity: 0.4; }

/* 通道状态 */
.channels {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.channel {
  display: flex;
  align-items: center;
  gap: 8px;
}

.ch-label {
  width: 70px;
  font-size: 14px;
  color: #aaa;
}

.ch-bar-bg {
  flex: 1;
  height: 12px;
  background: rgba(255,255,255,0.1);
  border-radius: 6px;
  overflow: hidden;
}

.ch-bar {
  height: 100%;
  background: #666;
  border-radius: 6px;
  transition: width 0.1s;
}

.ch-bar.bar-active {
  background: #4CAF50;
}

.ch-freq {
  width: 70px;
  font-size: 12px;
  color: #666;
  text-align: right;
}

/* 音效按钮网格 */
.sfx-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.btn-sfx {
  flex: 1;
  min-width: 80px;
  height: 40px;
  border-radius: 8px;
  font-size: 16px;
  background: rgba(33, 150, 243, 0.3);
  border: 1px solid rgba(33, 150, 243, 0.5);
  color: #fff;
}

.btn-sfx::after { border: none; }

/* 日志 */
.log-box {
  max-height: 160px;
  background: rgba(0,0,0,0.3);
  border-radius: 8px;
  padding: 10px;
}

.log-line {
  display: block;
  font-size: 14px;
  color: #aaa;
  line-height: 1.6;
  word-break: break-all;
}

slider {
  width: 100%;
}
