<!-- CHR All - 全部 32 个 Bank 的 Tile 图形查看 -->
<view class="chr-container">
  <!-- 顶部信息栏 -->
  <view class="info-bar">
    <text class="title">CHR 图形数据 ({{bankCount}} Banks × 256 Tiles)</text>
    <text class="subtitle">每个 Bank = 4KB, 256 tiles × 8×8px</text>
    <view class="palette-selector">
      <text class="label">调色板: </text>
      <view 
        wx:for="{{palettePresets}}" 
        wx:key="index"
        class="palette-preset {{currentPalette === index ? 'active' : ''}}"
        bindtap="onPaletteSelect"
        data-index="{{index}}"
      >
        <view class="color-swatch" wx:for="{{item}}" wx:for-item="c" wx:key="*this" style="background:{{c}};"></view>
      </view>
    </view>
  </view>

  <!-- Bank 列表 -->
  <view class="bank-list">
    <view 
      wx:for="{{bankInfos}}" 
      wx:key="index"
      class="bank-card {{currentBank === item.index ? 'active' : ''}}"
      bindtap="onBankSelect"
      data-index="{{item.index}}"
    >
      <canvas 
        type="2d" 
        id="bank-canvas-{{item.index}}"
        class="bank-canvas"
        style="width:{{bankCanvasSize}}px;height:{{bankCanvasSize}}px;"
      ></canvas>
      <view class="bank-label">
        <text>Bank {{item.hexLabel}}</text>
        <text class="bank-stats">{{item.nonEmptyTiles}} tiles</text>
      </view>
    </view>
  </view>
</view>
