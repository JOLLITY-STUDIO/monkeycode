<!-- CHR All - 调色板 dock 固定在下方，YY-CHR 风格 -->
<view class="page-root">

  <!-- 顶部信息 -->
  <view class="info-bar">
    <text class="title">CHR 图形数据 ({{bankCount}} Banks × 256 Tiles)</text>
    <text class="subtitle">每个 Bank = 4KB, 256 tiles × 8×8px</text>
  </view>

  <!-- Bank 列表 -->
  <view class="bank-list">
    <view
      wx:for="{{bankInfos}}"
      wx:key="index"
      class="bank-card"
      bindtap="onBankSelect"
      data-index="{{item.index}}"
    >
      <canvas
        type="2d"
        id="bank-canvas-{{item.index}}"
        class="bank-canvas"
        data-bank-index="{{item.index}}"
      ></canvas>
      <view class="bank-info">
        <text class="bank-label">Bank {{item.hexLabel}}</text>
        <text class="bank-stats">{{item.nonEmptyTiles}} / 256 tiles</text>
        <text class="bank-checksum">checksum: 0x{{item.checksumHex}}</text>
      </view>
    </view>
  </view>

  <!-- 底部固定 dock: 调色板 -->
  <view class="palette-dock">

    <!-- PAL_SET: 4 个预设调色板 -->
    <view class="dock-section">
      <view class="section-header">
        <text class="section-title">PAL_SET 预设调色板</text>
        <text wx:if="{{editing}}" class="edit-hint">编辑中: 选 PAL{{editing.preset}} slot{{editing.slot}}, 点击下方 NES 色修改</text>
      </view>
      <view class="pal-set">
        <view
          wx:for="{{presetList}}"
          wx:key="index"
          wx:for-item="preset"
          wx:for-index="presetIdx"
          class="pal-preset {{currentPreset === presetIdx ? 'active' : ''}}"
          data-preset="{{presetIdx}}"
          bindtap="onPresetSelect"
        >
          <text class="preset-label">P{{presetIdx}}</text>
          <view class="preset-colors">
            <view
              wx:for="{{preset}}"
              wx:for-item="c"
              wx:key="slot"
              class="pal-color {{editing && editing.preset === presetIdx && editing.slot === c.slot ? 'editing' : ''}}"
              data-preset="{{presetIdx}}"
              data-slot="{{c.slot}}"
              catchtap="onSlotColorTap"
              style="position:relative; background:{{c.rgb}}; border-color:{{c.rgb}};"
            >
              <text class="pal-color-idx">{{c.nesIdx.toString(16).toUpperCase()}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- PAL: 64 NES 色 -->
    <view class="dock-section">
      <view class="section-header">
        <text class="section-title">PAL NES 64 色</text>
        <text wx:if="{{!editing}}" class="hint">点击上方 PAL_SET 色块进入编辑</text>
      </view>
      <view class="nes-pal">
        <view
          wx:for="{{nesColors}}"
          wx:key="index"
          wx:for-index="idx"
          class="nes-color {{selectedNesIdx === idx ? 'selected' : ''}}"
          data-idx="{{idx}}"
          bindtap="onNesColorTap"
          style="position:relative; background:{{item}};"
        >
          <text class="nes-idx">{{idx}}</text>
        </view>
      </view>
    </view>

  </view>
</view>
