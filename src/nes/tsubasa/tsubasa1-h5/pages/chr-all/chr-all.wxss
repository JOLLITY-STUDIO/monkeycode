/* CHR All - YY-CHR 风格底部 dock */

.page-root {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #1a1a2e;
  padding-bottom: 480rpx; /* 给底部 dock 留空间 */
  box-sizing: border-box;
}

/* 顶部信息 */
.info-bar {
  background: linear-gradient(135deg, #2a2a4e 0%, #3a3a6e 100%);
  padding: 24rpx 32rpx;
  margin: 20rpx 20rpx 0 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #8a8aa8;
}

/* Bank 列表 */
.bank-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx 20rpx 0 20rpx;
}

.bank-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #252544 0%, #2a2a4e 100%);
  padding: 24rpx 16rpx 20rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.bank-canvas {
  display: block;
  width: 710rpx;
  height: 710rpx;
  max-width: 100%;
  max-height: 710rpx;
  background: #000;
  border: 2rpx solid #3a3a6e;
  border-radius: 8rpx;
  image-rendering: pixelated;
  image-rendering: -moz-crisp-edges;
  image-rendering: crisp-edges;
}

.bank-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-top: 16rpx;
  padding: 0 16rpx;
}

.bank-label {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  font-family: 'Courier New', monospace;
}

.bank-stats {
  font-size: 24rpx;
  color: #c0c0e0;
}

.bank-checksum {
  font-size: 20rpx;
  color: #8a8aa8;
  font-family: 'Courier New', monospace;
}

/* ========================================================== */
/* 底部固定 dock: PAL_SET + PAL NES 64 色                       */
/* ========================================================== */

.palette-dock {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #14142a;
  border-top: 2rpx solid #3a3a6e;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.5);
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom, 0);
  max-height: 50vh;
  overflow-y: auto;
}

.dock-section {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 24rpx;
  color: #6cf;
  font-weight: bold;
  font-family: 'Courier New', monospace;
  letter-spacing: 2rpx;
}

.edit-hint {
  font-size: 22rpx;
  color: #ff6;
  font-family: 'Courier New', monospace;
}

.hint {
  font-size: 20rpx;
  color: #6a6a8a;
}

/* PAL_SET: 4 个预设并排 */
.pal-set {
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
}

.pal-preset {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #1a1a2e;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
  border: 4rpx solid transparent;
  transition: border-color 0.15s;
}

.pal-preset.active {
  border-color: #6cf;
  background: #1f3f6f;
  box-shadow: 0 0 24rpx rgba(102, 204, 255, 0.6), inset 0 0 12rpx rgba(102, 204, 255, 0.2);
}

.preset-label {
  font-size: 22rpx;
  color: #c0c0e0;
  font-family: 'Courier New', monospace;
  margin-bottom: 8rpx;
  font-weight: bold;
}

.pal-preset.active .preset-label {
  color: #6cf;
}

.preset-colors {
  display: flex;
  gap: 6rpx;
  width: 100%;
  justify-content: center;
}

.pal-color {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pal-color.editing {
  border: 4rpx solid #ff6;
  box-shadow: 0 0 16rpx rgba(255, 255, 102, 0.6);
  transform: scale(1.1);
}

.pal-color-idx {
  font-size: 18rpx;
  color: white;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  pointer-events: none;
  /* 双层描边：在深色和浅色背景上都能看见 */
  text-shadow:
    -1rpx -1rpx 0 #000,
     1rpx -1rpx 0 #000,
    -1rpx  1rpx 0 #000,
     1rpx  1rpx 0 #000,
     0      0    6rpx #000;
}

/* PAL: NES 64 色 - 16列 × 4 行 (更紧凑) */
.nes-pal {
  display: grid;
  grid-template-columns: repeat(16, 1fr);
  gap: 4rpx;
}

.nes-color {
  width: 100%;
  height: 64rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 0;
}

.nes-color.selected {
  border: 4rpx solid #6cf;
  box-shadow: 0 0 12rpx rgba(102, 204, 255, 0.6);
}

.nes-idx {
  font-size: 18rpx;
  color: white;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  /* 双层描边：白字 + 黑边，深浅色背景都可见 */
  text-shadow:
    -1rpx -1rpx 0 #000,
     1rpx -1rpx 0 #000,
    -1rpx  1rpx 0 #000,
     1rpx  1rpx 0 #000,
     0      0    6rpx #000;
}
