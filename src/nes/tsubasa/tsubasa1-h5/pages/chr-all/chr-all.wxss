/* CHR All 页面样式 */
page { background: #1a1a2e; color: #eee; }

.chr-container {
  padding: 16px;
  min-height: 100vh;
}

.info-bar {
  background: rgba(255,255,255,0.05);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  border: 1px solid rgba(255,255,255,0.1);
}

.title {
  display: block;
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 4px;
}

.subtitle {
  font-size: 22px;
  color: #888;
  margin-bottom: 12px;
}

.palette-selector {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.palette-selector .label {
  font-size: 22px;
  color: #aaa;
  margin-right: 8px;
}

.palette-preset {
  display: flex;
  gap: 2px;
  padding: 6px 10px;
  border-radius: 8px;
  border: 2px solid rgba(255,255,255,0.15);
  background: rgba(0,0,0,0.3);
}

.palette-preset.active {
  border-color: #0f0;
  background: rgba(0,255,0,0.1);
}

.color-swatch {
  width: 24px;
  height: 24px;
  border-radius: 4px;
  border: 1px solid rgba(255,255,255,0.2);
}

.bank-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: center;
}

.bank-card {
  background: rgba(255,255,255,0.03);
  border-radius: 8px;
  padding: 8px;
  border: 2px solid rgba(255,255,255,0.08);
  transition: all 0.2s;
}

.bank-card.active {
  border-color: #4af;
  background: rgba(68,170,255,0.08);
}

.bank-canvas {
  display: block;
  image-rendering: pixelated;
}

.bank-label {
  margin-top: 6px;
  text-align: center;
  font-size: 20px;
}

.bank-stats {
  display: block;
  font-size: 16px;
  color: #888;
}
