<!-- Pattern Table All - NES 风格的图案表查看 -->
<view class="pt-container">
  <view class="header">
    <text class="title">Pattern Table 图案表 (NES 风格)</text>
    <text class="subtitle">CHR Bank 0-31, 每个 Bank 显示为 Pattern Table</text>
    <view class="controls">
      <view class="bank-nav">
        <button class="nav-btn" bindtap="onPrevBank">◀</button>
        <text class="bank-label">Bank {{currentBankHex}}</text>
        <button class="nav-btn" bindtap="onNextBank">▶</button>
      </view>
      <view class="palette-control">
        <text class="label">调色板:</text>
        <view 
          wx:for="{{palettePresets}}" 
          wx:key="index"
          class="palette-preset {{currentPalette === index ? 'active' : ''}}"
          bindtap="onPaletteSelect"
          data-index="{{index}}"
        >
          <view class="color-swatch" wx:for="{{item}}" wx:for-item="c" wx:key="*this" style="background:{{c}};"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="pt-grid">
    <!-- 左 Pattern Table ($0000) -->
    <view class="pt-panel">
      <text class="pt-label">$0000 (Tiles 0-255)</text>
      <canvas type="2d" id="pt-left-canvas" class="pt-canvas" style="width:{{ptSize}}px;height:{{ptSize}}px;"></canvas>
    </view>

    <!-- 右 Pattern Table ($1000) -->
    <view class="pt-panel">
      <text class="pt-label">$1000 (Tiles 256-511)</text>
      <canvas type="2d" id="pt-right-canvas" class="pt-canvas" style="width:{{ptSize}}px;height:{{ptSize}}px;"></canvas>
    </view>
  </view>

  <!-- Bank 索引总览 -->
  <view class="bank-index">
    <text class="section-title">CHR Bank 索引 (点击切换)</text>
    <view class="bank-grid">
      <view 
        wx:for="{{bankInfos}}" 
        wx:key="index"
        class="bank-item {{currentBank === item.index ? 'active' : ''}}"
        bindtap="onBankJump"
        data-index="{{item.index}}"
      >
        <text class="bank-idx">{{item.hexLabel}}</text>
        <text class="bank-tiles">{{item.nonEmptyTiles}}t</text>
      </view>
    </view>
  </view>
</view>
