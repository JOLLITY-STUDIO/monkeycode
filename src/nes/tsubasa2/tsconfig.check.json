{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "noImplicitAny": false
  },
  "include": [
    "src/**/*.ts",
    "../rom-data/**/*.ts"
  ]
}
