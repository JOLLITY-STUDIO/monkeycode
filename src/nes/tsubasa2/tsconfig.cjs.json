{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "./dist-cjs2",
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/game/**/*.ts", "src/core/**/*.ts", "src/index.ts", "typings/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "dist-cjs", "dist-cjs2"]
}
