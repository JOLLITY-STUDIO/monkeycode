/* game-bgmse — BGM+SE 混合测试 */
page {
  background: #0a0a1a;
  color: #e0e0f0;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

.container {
  padding: 16px;
  max-width: 500px;
  margin: 0 auto;
}

/* 标题 */
.header {
  text-align: center;
  margin-bottom: 20px;
}
.title {
  display: block;
  font-size: 18px;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 4px;
}
.subtitle {
  display: block;
  font-size: 11px;
  color: #8888aa;
}

/* 按钮网格 */
.btn-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
  margin-bottom: 16px;
}

/* 大按钮 */
.big-btn {
  background: #151528;
  border: 2px solid #252540;
  border-radius: 12px;
  padding: 20px 10px;
  text-align: center;
  transition: all 0.15s ease;
}
.big-btn:active {
  transform: scale(0.95);
}
.big-btn-icon {
  display: block;
  font-size: 36px;
  margin-bottom: 6px;
}
.big-btn-label {
  display: block;
  font-size: 16px;
  font-weight: bold;
  color: #ccccdd;
  margin-bottom: 4px;
}
.big-btn-desc {
  display: block;
  font-size: 9px;
  color: #555577;
}

/* 按钮颜色主题 */
.btn-bgm {
  border-color: #2a4a6a;
  background: #0d1a2a;
}
.btn-bgm .big-btn-label { color: #6bb5ff; }

.btn-se {
  border-color: #4a2a2a;
  background: #1a0d0d;
}
.btn-se .big-btn-label { color: #ff6b6b; }

.btn-both {
  border-color: #4a4a2a;
  background: #1a1a0d;
}
.btn-both .big-btn-label { color: #ffd700; }

/* 活动状态光晕 */
.btn-active {
  box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
  border-color: #ffd700;
}

/* 停止按钮 */
.stop-bar {
  display: flex;
  justify-content: center;
  margin-bottom: 12px;
}
.btn-stop {
  width: 140px;
  height: 36px;
  line-height: 36px;
  font-size: 14px;
  border-radius: 8px;
  border: none;
  text-align: center;
  background: #6b1a1a;
  color: #fff;
  padding: 0;
}
.btn-stop::after { border: none; }

/* 状态卡片 */
.status-card {
  background: #151528;
  border-radius: 10px;
  padding: 12px 16px;
  border: 1px solid #252540;
}
.status-text {
  display: block;
  font-size: 14px;
  color: #aaccff;
  margin-bottom: 6px;
}
.info-row {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.info-text {
  display: block;
  font-size: 11px;
  color: #555577;
}
