          <text style="font-size:9px;color:#8b949e;display:block;">{{item.desc}}</text>
          <text wx:if="{{item.example}}" style="font-size:9px;color:#3fb950;font-family:monospace;display:block;">  eg: {{item.example}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ── Bank 12 音频引擎 函数视图 ── -->
  <view class="view-content" wx:if="{{viewMode === 'functions' && bankId === 12}}">
    <view class="b02-toolbar">
      <text class="b02-hint">Bank 12 音频子系统: {{b12Subroutines.length}} 个子程序 · 点击查看详情</text>
    </view>
    <scroll-view class="b02-scroll" scroll-y="true" enhanced="true">
      <view class="func-list">
        <view wx:if="{{!b12Subroutines.length}}" style="padding:10px 0;text-align:center;">
          <text style="font-size:10px;color:#484f58;">暂无子程序</text>
        </view>
        <view class="func-item" wx:for="{{b12Subroutines}}" wx:key="bankAddr" data-idx="{{index}}" bindtap="onB12SelectFunction">
          <text class="func-name">{{item.name}}</text>
          <text class="func-meta">{{item.bankAddr}} · {{item.length}} · asm L{{item.asmLine}}</text>
          <text style="display:block;font-size:10px;color:#8b949e;margin-top:2px;">{{item.desc}}</text>
        </view>
      </view>
      <view class="b02-section" wx:if="{{b12SelectedFunc}}">
        <text class="b02-section-title">选中函数详情</text>
        <text class="func-detail" style="font-weight:bold;color:#d29922;">{{b12SelectedFunc.name}}</text>
        <text class="func-detail">Bank 地址: {{b12SelectedFunc.bankAddr}}</text>
        <text class="func-detail">长度: {{b12SelectedFunc.length}}</text>
        <text class="func-detail">说明: {{b12SelectedFunc.desc}}</text>
        <text class="func-detail" wx:if="{{b12SelectedFunc.note}}" style="color:#58a6ff;">备注: {{b12SelectedFunc.note}}</text>
        <view wx:if="{{b12SelectedFunc.commands}}" style="margin-top:6px;">
          <text style="font-size:10px;color:#f0883e;">音频命令分发:</text>
          <view wx:for="{{b12SelectedFunc.commands}}" wx:key="code" style="padding:2px 8px;">
            <text style="font-size:10px;font-family:monospace;color:#58a6ff;">${{item.code}}:</text>
            <text style="font-size:10px;color:#8b949e;"> {{item.desc}}</text>
          </view>
        </view>
        <view wx:if="{{b12SelectedFunc.crossRefs}}" style="margin-top:6px;">
          <text style="font-size:10px;color:#7ee787;">调用者:</text>
          <view wx:for="{{b12SelectedFunc.crossRefs}}" wx:key="from" style="padding:2px 8px;">
            <text style="font-size:10px;color:#8b949e;">← {{item.from}}: {{item.desc}}</text>
          </view>
        </view>
        
      </view>
      <view class="b02-section">
        <text class="b02-section-title">每帧调用流程</text>
        <view wx:if="{{!b12CallFlow.length}}" style="padding:10px 0;text-align:center;">
          <text style="font-size:10px;color:#484f58;">无调用流程数据</text>
        </view>
        <view wx:for="{{b12CallFlow}}" wx:key="step" style="padding:2px 0;border-bottom:1px solid #161b22;">
          <text style="font-size:10px;color:#d29922;font-family:monospace;">{{item.step}}. {{item.addr}}</text>
          <text style="font-size:10px;color:#8b949e;"> → {{item.action}}</text>
        </view>
      </view>
      <view class="b02-section">
        <text class="b02-section-title">音符频率表 ($8725)</text>
        <text class="b02-note">64音符时长查找表。通过 AND #$3F 索引 → 返回每音符的持续帧数(通常 1-30帧)</text>
      </view>
    </scroll-view>
  </view>

  <!-- ── Bank 12 音频播放器视图 ── -->
  <view class="view-content" wx:if="{{viewMode === 'music' && bankId === 12}}">
    <view class="b02-toolbar">
      <text class="b02-hint">🎵 音频引擎播放器 — 浏览音效/音乐数据</text>
    </view>
    <scroll-view class="b02-scroll" scroll-y="true" enhanced="true">
      <!-- 播放控制栏 -->
      <view class="audio-player-bar">
        <view class="audio-player-controls">
          <view class="audio-btn audio-prev-btn" bindtap="onB12PrevTrack">
            <text>⏮ 上一首</text>
          </view>
          <view class="audio-btn audio-play-btn" bindtap="onB12PlayTrack">
            <text>▶ 播放</text>
          </view>
          <view class="audio-btn" bindtap="onB12StopTrack">
            <text>⏹ 停止</text>
          </view>
          <view class="audio-btn audio-next-btn" bindtap="onB12NextTrack">
            <text>⏭ 下一首</text>
          </view>
        </view>
        <text class="audio-note" style="display:block;font-size:9px;color:#6e7681;margin-top:4px;">实时管道 — NES APU (PAPU) + Bank 12 音序器 → WebAudio 实时输出</text>
      </view>

      <!-- APU 5 通道实时状态面板 (常驻，播放时始终可见) -->
      <view class="apu-panel">
        <view class="apu-panel-title">
          <text>NES APU 通道</text>
          <text wx:if="{{b12Progress}}" style="font-size:10px;color:#6e7681;margin-left:12px;">
            {{b12Progress.seconds}}s · {{b12Progress.frameCount}}帧 · {{b12Progress.activeChannels}}ch活跃
          </text>
        </view>
        <!-- 进度条 -->
        <view wx:if="{{b12Progress}}" style="height:3px;background:#161b22;border-radius:2px;margin:4px 0 8px 0;overflow:hidden;">
          <view style="height:100%;background:#3fb950;width:{{b12Progress.seconds > 0 ? (b12Progress.seconds % 60) / 60 * 100 : 2}}%;transition:width 0.2s;"></view>
        </view>
        <view class="apu-grid" wx:if="{{b12ApuChannels.length > 0}}">
          <view class="apu-col" wx:for="{{b12ApuChannels}}" wx:key="name">
            <view class="apu-col-header {{item.enabled ? 'ch-on' : 'ch-off'}}">
              <text class="apu-ch-name">{{item.name}}</text>
              <text class="apu-ch-reg">{{item.regBase}}</text>
            </view>
            <view class="apu-rows">
              <view class="apu-row apu-regs">
                <text class="apu-val apu-regs-val" style="color:{{item.enabled ? '#c9d1d9' : '#484f58'}};">{{item.regs}}</text>
              </view>
              <view class="apu-row">
                <text class="apu-label">状态</text>
                <text class="apu-val" style="color:{{item.enabled ? '#3fb950' : '#484f58'}};">{{item.enabled ? 'ON' : 'OFF'}}</text>
              </view>
              <view class="apu-row">
                <text class="apu-label">音量</text>
                <text class="apu-val" style="color:{{item.enabled ? '#7ee787' : '#484f58'}};">{{item.volumeHex}}</text>
              </view>
              <view class="apu-row">
                <text class="apu-label">周期</text>
                <text class="apu-val" style="color:{{item.enabled ? '#58a6ff' : '#484f58'}};">{{item.freqHex}}</text>
              </view>
              <view class="apu-row" wx:if="{{item.freqHz > 0}}">
                <text class="apu-label">频率</text>
                <text class="apu-val" style="color:{{item.enabled ? '#d29922' : '#484f58'}};">{{item.freqHz}}Hz</text>
              </view>
              <view class="apu-row" wx:if="{{item.freqHz === 0}}">
                <text class="apu-label">频率</text>
                <text class="apu-val" style="color:#484f58;">—</text>
              </view>
              <view class="apu-row" wx:if="{{item.duty >= 0}}">
                <text class="apu-label">Duty</text>
                <text class="apu-val" style="color:{{item.enabled ? '#a5d6ff' : '#484f58'}};">{{item.duty}}</text>
              </view>
              <view class="apu-row">
                <text class="apu-label">Len</text>
                <text class="apu-val" style="color:{{item.enabled ? '#d2a8ff' : '#484f58'}};">{{item.lengthCounter}}</text>
              </view>
              <view class="apu-row" wx:if="{{item.extra}}">
                <text class="apu-label">附加</text>
                <text class="apu-val" style="color:#f0883e;">{{item.extra}}</text>
              </view>
            </view>
          </view>
        </view>
        
      </view>

      <!-- 音效/音乐列表 -->
      <view class="b02-section">
        <text class="b02-section-title">🎶 音效/音乐列表</text>
        <text class="b02-note" style="display:block;margin-bottom:6px;">从 $8BD9 音效映射表读取。切换 Bank 0D/0E/0F 加载不同音乐数据。点击查看音轨hex。</text>
        <view wx:if="{{!b12SoundEffectMap.length}}" style="padding:10px 0;text-align:center;">
          <text style="font-size:10px;color:#484f58;">无音效数据</text>
        </view>
        <view class="data-table-item {{b12MusicTrackIdx === index ? 'track-selected' : ''}}" wx:for="{{b12SoundEffectMap}}" wx:key="seId" data-idx="{{index}}" bindtap="onB12SelectMusic" style="padding:6px 8px;border-bottom:1px solid #161b22;">
          <view style="display:flex;align-items:center;gap:8px;">
            <text style="font-size:11px;color:#d29922;font-family:monospace;min-width:30px;">#{{index}}</text>
            <text style="font-size:10px;color:#58a6ff;font-family:monospace;min-width:30px;">$0{{item.seId}}</text>
            <text style="font-size:10px;color:#8b949e;flex:1;">{{item.desc}}</text>
            <text style="font-size:9px;color:#6e7681;font-family:monospace;">Bank {{item.bank}}</text>
          </view>
        </view>
      </view>

      <!-- 选中的音轨 hex -->
      <view class="b02-section" wx:if="{{b12TrackHex}}">
        <text class="b02-section-title">音轨数据 (hex)</text>
        <view style="background:#0d1117;border:1px solid #21262d;border-radius:6px;padding:10px;">
          <text style="font-size:10px;color:#c9d1d9;font-family:monospace;line-height:1.6;white-space:pre-wrap;" selectable="true">{{b12TrackHex}}</text>
        </view>
        <view style="margin-top:4px;display:flex;gap:10px;flex-wrap:wrap;">
          <text style="font-size:9px;color:#f0883e;">[XX] = 命令($E0-$EF)</text>
          <text style="font-size:9px;color:#58a6ff;">(XX) = 音符($A0-$DF)</text>
          <text style="font-size:9px;color:#6e7681;">&lt;XX&gt; = 休止/结束</text>
          <text style="font-size:9px;color:#da3633;">!XX! = $FF 序列尾</text>
        </view>
      </view>
      <view class="b02-section" wx:else>
        <view style="padding:10px 0;text-align:center;">
          <text style="font-size:10px;color:#484f58;">点击上方列表查看音轨 hex 数据</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ── Bank 12 音频引擎 调试视图 ── -->
  <view class="view-content" wx:if="{{viewMode === 'debug' && bankId === 12}}">
    <view class="b02-toolbar">
      <text class="b02-hint">Bank 12 调试 — MMC3 Bank 映射 · 音效ID路由 · 音符频率表</text>
    </view>
    <scroll-view class="b02-scroll" scroll-y="true" enhanced="true">
      <view class="b02-section">
        <text class="b02-section-title">MMC3 Bank 映射 (R7)</text>
        <text class="b02-note" style="display:block;">音频引擎通过 MMC3 寄存器 7 切换 $A000-$BFFF 窗口</text>
        <text class="b02-note" style="display:block;">写 $8000=$07(选R7) → 写 $8001=bank号 → $A000 窗口立即切换</text>
        <text class="b02-note" style="display:block;">Bank $0D: 音效/音乐数据 (seId $32-$43)</text>
        <text class="b02-note" style="display:block;">Bank $0E: 音效/音乐数据 (seId $44-$50)</text>
        <text class="b02-note" style="display:block;">Bank $0F: 音效/音乐数据 (seId $51-$5B)</text>
        <text class="b02-note" style="display:block;color:#6e7681;">ram_07FC: 上次写入的 bank 号缓存(去重优化)</text>
      </view>
      <view class="b02-section">
        <text class="b02-section-title">DMC 采样 (3种模式)</text>
        <text class="b02-note" style="display:block;">$8699: $4012=$00 → 基址 $C000×$00 + $0300 = $C000 (12×16+1=193B)</text>
        <text class="b02-note" style="display:block;">$86B8: $4012=$03 → 基址 $C000 + $0300×$20? (32×16+1=513B)</text>
        <text class="b02-note" style="display:block;">$86D7: $4012=$0B → 基址 $C000 + $0B00×$13? (19×16+1=305B)</text>
      </view>
      <view class="b02-section">
        <text class="b02-section-title">RAM 变量详情</text>
        <view wx:if="{{!b12RamLayout.length}}" style="padding:10px 0;text-align:center;">
          <text style="font-size:10px;color:#484f58;">无RAM数据</text>
        </view>
        <view wx:for="{{b12RamLayout}}" wx:key="range" style="padding:2px 0;border-bottom:1px solid #161b22;">
          <text style="font-size:10px;color:#58a6ff;font-family:monospace;">{{item.range}}</text>
          <text style="font-size:9px;color:#d29922;"> {{item.name}}</text>
          <text style="font-size:9px;color:#8b949e;display:block;">  {{item.desc}}</text>
          <text style="font-size:8px;color:#6e7681;">  asm: {{item.asmRef}}</text>
        </view>
      </view>
      <view class="b02-section">
        <text class="b02-section-title">音序跳转表 ($82E4)</text>
        <text class="b02-note" style="display:block;">8 项指针表: $830E(不变) $832B(+1) $8340(+2) → 循环索引 0-7 → 修改 $07B7/$07BF 频率实现 pitch bend 效果</text>
      </view>
    </scroll-view>
  </view>
</view>
