<!-- Bank 浏览器主页面 -->
<view class="container">
  <!-- 顶栏 -->
  <view class="header">
    <text class="header-title">ROM Bank 浏览器</text>
    <text class="header-sub">PRG {{totalPRG / 1024}}KB + CHR {{totalCHR / 1024}}KB</text>
  </view>

  <!-- 标签切换 -->
  <view class="tab-bar">
    <view class="tab {{activeTab === 'prg' ? 'active' : ''}}" bindtap="onTapTab" data-tab="prg">
      <text class="tab-text">PRG Banks (0-31)</text>
      <text class="tab-count">32</text>
    </view>
    <view class="tab {{activeTab === 'chr' ? 'active' : ''}}" bindtap="onTapTab" data-tab="chr">
      <text class="tab-text">CHR Banks (0-15)</text>
      <text class="tab-count">16</text>
    </view>
  </view>

  <!-- PRG Bank 列表 -->
  <scroll-view wx:if="{{activeTab === 'prg'}}" class="bank-list" scroll-y="true" enhanced="true" show-scrollbar="true">
    <view class="bank-item {{item.code === 0 ? 'pure-data' : ''}} {{item.unaccessed > 4000 ? 'low-use' : ''}} {{item.id >= 30 ? 'fixed-bank' : ''}}"
      wx:for="{{prgBanks}}" wx:key="id"
      bindtap="onTapBank" data-type="PRG" data-id="{{item.id}}">

      <view class="bank-left">
        <view class="bank-id">
          <text class="bank-type-icon">{{item.flags[2] || '⚡'}}</text>
          <text class="bank-label">{{item.label}}</text>
          <text class="bank-name">{{item.name}}</text>
          <text class="bank-cpu">{{item.cpuMap}}</text>
        </view>
        <text class="bank-desc">{{item.description}}</text>

        <!-- 特征标签 -->
        <view class="bank-flags">
          <view class="flag" wx:for="{{item.flags}}" wx:for-item="f" wx:key="*this">{{f}}</view>
        </view>

        <!-- 依赖关系 -->
        <view class="bank-rel" wx:if="{{item.depsStr || item.usedByStr}}">
          <view class="rel-row" wx:if="{{item.depsStr}}">
            <text class="rel-label">使用→</text>
            <text class="rel-value">{{item.depsStr}}</text>
          </view>
          <view class="rel-row" wx:if="{{item.usedByStr}}">
            <text class="rel-label">被←</text>
            <text class="rel-value used-by">{{item.usedByStr}}</text>
          </view>
        </view>
      </view>

      <view class="bank-right">
        <!-- 迷你进度条 -->
        <view class="mini-bar">
          <view class="mini-seg code" wx:if="{{item.code > 0}}" style="width:{{item.codePct}}%">
            <text class="mini-label">{{item.codePct}}%</text>
          </view>
          <view class="mini-seg data" wx:if="{{item.data > 0}}" style="width:{{item.dataPct}}%">
            <text class="mini-label">{{item.dataPct}}%</text>
          </view>
        </view>
        <view class="bank-stats">
          <text class="stat code-stat">C:{{item.code}}</text>
          <text class="stat data-stat">D:{{item.data}}</text>
          <text class="stat unacc-stat" wx:if="{{item.unaccessed > 0}}">U:{{item.unaccessed}}</text>
        </view>
        <text class="bank-arrow">→</text>
      </view>
    </view>
  </scroll-view>

  <!-- CHR Bank 列表 -->
  <scroll-view wx:if="{{activeTab === 'chr'}}" class="bank-list" scroll-y="true" enhanced="true" show-scrollbar="true">
    <view class="bank-item chr-item"
      wx:for="{{chrBanks}}" wx:key="id"
      bindtap="onTapBank" data-type="CHR" data-id="{{item.id}}">

      <view class="bank-left">
        <view class="bank-id">
          <text class="bank-type-icon">🎨</text>
          <text class="bank-label">{{item.label}}</text>
          <text class="bank-name">{{item.name}}</text>
          <text class="bank-cpu">{{item.cpuMap}}</text>
        </view>
        <text class="bank-desc">{{item.description}}</text>

        <view class="bank-flags">
          <view class="flag" wx:for="{{item.flags}}" wx:for-item="f" wx:key="*this">{{f}}</view>
        </view>
      </view>

      <view class="bank-right">
        <view class="chr-preview">
          <text class="chr-preview-num">512 tiles</text>
        </view>
        <text class="bank-arrow">→</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部说明 -->
  <view class="footer">
    <text class="footer-text">C = 代码 (bytes)  D = 数据  U = 未访问 · 点击查看详情</text>
  </view>
</view>
