<!-- Bank 29 详情页 — 球队战术/阵容数据 -->
<view class="container">
  <!-- 页头信息 -->
  <view class="detail-header">
    <view class="header-row">
      <text class="bank-title">{{bankLabel}}</text>
      <text class="bank-name">{{bankName}}</text>
      <text class="bank-cpu">{{cpuMap}}</text>
    </view>
    <text class="bank-desc">{{description}}</text>

    <!-- 数据类型标签 -->
    <view class="data-class-tag {{dataClass === 'render' ? 'class-render' : dataClass === 'game' ? 'class-game' : dataClass === 'text' ? 'class-text' : ''}}">
      <text>{{dataClassLabel}}</text>
    </view>
    <text class="data-class-hint" wx:if="{{dataClassHint}}">{{dataClassHint}}</text>

    <!-- 统计条 -->
    <view class="stats-bar">
      <view class="stat-item data-stat">
        <view class="stat-bar" style="width:{{dataBytes / 81.92}}%"></view>
        <text class="stat-text">数据 {{dataBytes}}B</text>
      </view>
      <view class="stat-item unacc-stat">
        <view class="stat-bar" style="width:{{unaccessed / 81.92}}%"></view>
        <text class="stat-text">未访问 {{unaccessed}}B</text>
      </view>
    </view>
  </view>

  <!-- 视图切换按钮 -->
  <view class="view-tabs">
    <view class="view-tab {{viewMode === 'hex' ? 'active' : ''}}" bindtap="onViewHex">HEX</view>
    <view class="view-tab {{viewMode === 'histogram' ? 'active' : ''}}" bindtap="onViewHistogram">柱状图</view>
    <view class="view-tab {{viewMode === 'records' ? 'active' : ''}}" bindtap="onViewRecords">📋 记录</view>
    <view class="view-tab {{viewMode === 'structure' ? 'active' : ''}}" bindtap="onViewStructure">🏗️ 结构</view>
    <view class="view-tab {{viewMode === 'roster' ? 'active' : ''}}" bindtap="onViewRoster">⚽ 阵容</view>
  </view>

  <!-- ── HEX 视图 ── -->
  <view class="view-content" wx:if="{{viewMode === 'hex'}}">
    <scroll-view class="hex-scroll" scroll-y="true" enhanced="true" show-scrollbar="true">
      <view class="hex-line" wx:for="{{hexLines}}" wx:key="*this" wx:for-index="idx">
        <text class="hex-addr">{{hexAddr[idx]}}:</text>
        <text class="hex-data">{{item}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- ── 柱状图视图 ── -->
  <view class="view-content" wx:if="{{viewMode === 'histogram'}}">
    <view class="histo-wrap">
      <canvas type="2d" id="histoCvs" class="histo-canvas"></canvas>
    </view>
    <text class="histo-hint">字节值 (00–FF) 出现频率分布 · 00 密集 = 块分隔符 · FF 密集 = 0x1D00+ 填充</text>
  </view>

  <!-- ── 记录视图 (战术块) ── -->
  <view class="view-content" wx:if="{{viewMode === 'records'}}">
    <view class="record-modes">
      <view class="rmode-tab {{recordMode === '22byte' ? 'active' : ''}}" data-mode="22byte" bindtap="onRecordModeSwitch">22字节块</view>
      <text class="rmode-auto-label">→ {{recordStats.totalBlocks}} 个战术块 · 平均 {{recordStats.avgBlockSize}}B</text>
    </view>
    <view class="record-stats">
      <text class="rstat">区域: $8000-$9AB1 (offset 0x0000-0x1AB1) · 00 00 分隔</text>
    </view>
    <scroll-view class="record-scroll" scroll-y="true" enhanced="true" show-scrollbar="true">
      <view class="record-item" wx:for="{{tacticalBlocks}}" wx:key="offset">
        <view class="rec-offset">
          <text class="rec-addr">${{item.cpuAddr}}</text>
          <text class="rec-len">({{item.len}}B)</text>
          <text class="rec-ptr">#{{item.idx}}</text>
        </view>
        <view class="rec-hex"><text selectable="true">{{item.hex}}</text></view>
      </view>
    </scroll-view>
  </view>

  <!-- ── 结构视图 ── -->
  <view class="view-content" wx:if="{{viewMode === 'structure'}}">
    <view class="b02-toolbar">
      <text class="b02-hint">Bank 29 纯数据 bank · 结构总览 · 加载方 / 消费方</text>
    </view>
    <scroll-view class="b02-scroll" scroll-y="true" enhanced="true">
      <view class="b02-section" wx:if="{{structureInfo}}">
        <text class="b02-section-title">数据结构布局</text>
        <text class="b02-note" style="display:block;">📦 战术/阵型块: {{structureInfo.blockRange}}</text>
        <text class="b02-note" style="display:block;">📍 指针表: {{structureInfo.ptrTable}}</text>
        <text class="b02-note" style="display:block;">⚽ 阵容区: {{structureInfo.rosterArea}}</text>
        <text class="b02-note" style="display:block;">🗑️ {{structureInfo.ffFill}}</text>
      </view>
      <view class="b02-section">
        <text class="b02-section-title">加载方 (切换 bank 0x1D → $A000 窗口)</text>
        <view class="data-table-item" wx:for="{{structureInfo.loaders}}" wx:key="bank" wx:for-item="ld">
          <text class="data-table-name">Bank {{ld.bank}}: {{ld.pattern}}</text>
          <text class="b02-note" style="font-size:9px;">  → {{ld.desc}}</text>
        </view>
      </view>
      <view class="b02-section">
        <text class="b02-section-title">消费方 (引用 $BAxx-$BExx)</text>
        <view class="data-table-item" wx:for="{{structureInfo.consumers}}" wx:key="bank" wx:for-item="cs">
          <text class="data-table-name">Bank {{cs.bank}}: {{cs.count}} 处 · {{cs.addresses}}</text>
          <text class="b02-note" style="font-size:9px;">  → {{cs.desc}}</text>
        </view>
      </view>
      <view class="b02-section">
        <text class="b02-section-title">指针表 (34 项)</text>
        <view class="data-table-item" wx:for="{{rosterPointers}}" wx:key="idx" wx:for-item="pt">
          <text class="data-table-name">{{pt.cpuAddr}} → {{pt.target}} (offset {{pt.targetOffset}})</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ── 阵容视图 ── -->
  <view class="view-content" wx:if="{{viewMode === 'roster'}}">
    <view class="b02-toolbar">
      <text class="b02-hint">CPU 球队阵容: {{rosterEntries.length}} 队 · GFX 4B + 队标 3B + [位置码,球员ID]×N + $0F</text>
    </view>
    <scroll-view class="b02-scroll" scroll-y="true" enhanced="true">
      <view class="b02-section" wx:for="{{rosterEntries}}" wx:key="idx" wx:for-item="rs">
        <text class="b02-section-title">#{{rs.idx}} {{rs.cpuAddr}} · GFX [{{rs.gfx}}] · 队标 [{{rs.team}}]</text>
        <view class="func-list">
          <view class="func-item" wx:for="{{rs.players}}" wx:key="pos" wx:for-item="pl">
            <text class="func-name">位置码 ${{pl.pos}} → 球员ID ${{pl.player}}</text>
          </view>
        </view>
        <text class="b02-note" style="font-size:9px;word-break:break-all;">{{rs.hex}}</text>
      </view>
    </scroll-view>
  </view>
</view>
