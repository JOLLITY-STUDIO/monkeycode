.game-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0a18;
  overflow: hidden;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 12px;
  background: rgba(0, 0, 0, 0.75);
  flex-shrink: 0;
  min-height: 28px;
}

.status-tag {
  color: #0ff;
  font-size: 11px;
  font-weight: bold;
  background: rgba(0, 255, 255, 0.15);
  padding: 2px 8px;
  border-radius: 4px;
}

.status-text {
  color: #8f8;
  font-size: 11px;
  flex: 1;
  margin-left: 8px;
}

.fps-text {
  color: #f90;
  font-size: 11px;
  margin-right: 10px;
}

.nt-scroll-text {
  color: #0ff;
  font-size: 12px;
  font-family: monospace;
  margin-right: 10px;
}

.data-btn {
  font-size: 12px;
  color: #58a6ff;
  padding: 2px 10px;
  border: 1rpx solid #1f6feb;
  border-radius: 4px;
  background: rgba(31, 111, 235, 0.15);
}

/* ── Canvas 区 ── */

.canvas-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #000;
}

.game-canvas {
  width: 256px;
  height: 240px;
}

/* ── 控制栏 ── */

.control-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 16px;
  background: rgba(0, 0, 0, 0.85);
  flex-shrink: 0;
  gap: 12px;
}

.ctrl-group {
  display: flex;
  gap: 8px;
}

.ctrl-btn {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: linear-gradient(135deg, #1e3a5f, #162447);
  border: 2rpx solid #3a5f9f;
  color: #fff;
  font-size: 14px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}
.ctrl-btn:active {
  background: linear-gradient(135deg, #2e5a8f, #264467);
  transform: scale(0.92);
}

.ctrl-btn.mini {
  width: 36px;
  height: 36px;
  font-size: 16px;
}

.ctrl-btn.active {
  background: linear-gradient(135deg, #1f6f3a, #153a22);
  border-color: #3fb950;
}

.ctrl-switch {
  width: auto;
  padding: 0 14px;
  border-radius: 20px;
  font-size: 13px;
}

/* ── 调试面板 ── */

.debug-panel {
  padding: 8px 12px;
  background: rgba(0, 0, 0, 0.85);
  border-top: 1rpx solid #21262d;
  flex-shrink: 0;
}

.debug-row {
  display: flex;
  gap: 6px;
  align-items: center;
  padding: 2px 0;
}

.debug-label {
  font-size: 10px;
  color: #6e7681;
}

.debug-val {
  font-size: 11px;
  color: #c9d1d9;
  font-family: monospace;
  margin-right: 12px;
}
