/* components/bg-fx/bg-fx.wxss — 全局动态背景层 (Playful Sudoku, V0.49.3)
  欢快糖果风 + 景深 + 数独格纸真实 view 阵列:
  - 糖果渐变底 + 彩色柔光团 (明亮欢快)
  - V0.49.3 整屏平铺数独格纸: 真实 view 横竖线阵列 (深紫 24px 细线 1px
    + 深粉 72px 宫粗线 2px, 位置由 ts 计算, Skyline 兼容)
  - 远景: 满屏大数字 1-9 (深紫色调 + alpha 0.40-0.55, 远而虚, 4 方向深紫描边)
  - 中景: 3×3/4×4/5×5/6×6 小网格方块 (糖果色 + alpha 0.55-0.76, 深色 box-shadow 浮起)
  - 近景: 高亮柔光点 (alpha 0.80-1.00 + 双层光晕, 最近最亮)
  动画层 (.band/.bob/.roll/@keyframes) 必须保持完整 — V0.49.3 曾因孤儿 CSS
  (旧 .fx-grid-fine-v 残留块 + 悬空 }) 把第 3-7 节解析压死, 动画全部消失, 已删。
  skyline 渲染器支持 transform + opacity + animation + box-shadow。
  全项目禁用 rpx, 一律 px。
  层级: 本组件绝对定位填满 .scene-area, z-index 0;
        场景层 (scene-stage) z-index 1/2 浮在其上。
*/

.bg-fx {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background: #fff0f5; /* 兜底: 与 .fx-base 顶部同色, 防加载间隙露白 */
}

/* ===========================================================
 * 1. 糖果渐变底 (粉 → 暖黄 → 天蓝 → 薄荷) + 彩色柔光团
 * =========================================================== */
.fx-base {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background:
    /* 顶部暖粉柔光 */
    radial-gradient(ellipse 70% 45% at 50% 0%,
      rgba(255, 214, 235, 0.85) 0%,
      rgba(255, 214, 235, 0) 70%),
    /* 左上蜜橙光团 */
    radial-gradient(ellipse 42% 36% at 12% 22%,
      rgba(255, 214, 165, 0.7) 0%,
      rgba(255, 214, 165, 0) 70%),
    /* 右中天蓝光团 */
    radial-gradient(ellipse 46% 40% at 88% 46%,
      rgba(183, 224, 255, 0.75) 0%,
      rgba(183, 224, 255, 0) 70%),
    /* 左下薄荷光团 */
    radial-gradient(ellipse 40% 34% at 16% 82%,
      rgba(196, 240, 214, 0.8) 0%,
      rgba(196, 240, 214, 0) 70%),
    /* 底部淡紫收尾 */
    radial-gradient(ellipse 60% 30% at 72% 100%,
      rgba(226, 214, 255, 0.7) 0%,
      rgba(226, 214, 255, 0) 75%),
    /* 主渐变: 奶白 → 粉 → 暖黄 → 天蓝 → 薄荷 (明亮欢快) */
    linear-gradient(180deg,
      #fff6fa 0%,
      #ffe9f2 20%,
      #fff3e0 42%,
      #e6f4ff 66%,
      #e2f7ec 100%);
}

/* ===========================================================
 * 2. 整屏平铺网格线 (V0.49.3 数独格纸感, 真实 view 阵列)
 *    V0.49.2 用 repeating-linear-gradient 在 Skyline 1.4.21 完全静默不渲染,
 *    故 V0.49.3 改成 ts 动态计算每条线 px 位置, wxml 用 wx:for 渲染真实 view。
 *    alpha 高 + 颜色深, 浅渐变底上肉眼清晰可见:
 *      .fx-grid-line-h  1px/2px 横线 (绝对定位, left:0, width:100%)
 *      .fx-grid-line-v  1px/2px 竖线 (绝对定位, top:0, height:100%)
 *    72 = 3 × 24 → 宫线与细线在 (0,0) 天然对齐, 整屏像一张数独格纸。
 * =========================================================== */
.fx-grid {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}

/* 横线: top 由 ts 计算 (0..height), 占满宽 100%, 1px 或 2px 高 */
.fx-grid-line-h {
  position: absolute;
  left: 0;
  width: 100%;
  pointer-events: none;
}
/* 竖线: left 由 ts 计算 (0..width), 占满高 100%, 1px 或 2px 宽 */
.fx-grid-line-v {
  position: absolute;
  top: 0;
  height: 100%;
  pointer-events: none;
}

/* ===========================================================
 * 3. 视差横滚层骨架 (每个 band = 一个视差平面)
 * =========================================================== */
.band {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* 上下缓浮 (让横滚产生斜向走动感) */
.bob {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  animation: band-bob ease-in-out infinite alternate;
  will-change: transform;
}
.bob-1 { animation-duration: 11s; }
.bob-2 { animation-duration: 8.4s; }
.bob-3 { animation-duration: 6.4s; }
@keyframes band-bob {
  from { transform: translate3d(0, -10px, 0); }
  to   { transform: translate3d(0, 12px, 0); }
}

/* 横滚: width:200%, 两个相同 seg 无缝循环 */
.roll {
  position: absolute;
  left: 0;
  top: 0;
  width: 200%;
  height: 100%;
  display: flex;
  animation: roll-x linear infinite;
  will-change: transform;
}
.roll-1 { animation-duration: 90s; }
.roll-2 { animation-duration: 60s; }
.roll-3 { animation-duration: 30s; }
@keyframes roll-x {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(-50%, 0, 0); }
}

/* 每个 seg 占 roll 一半 = 一屏宽, 装饰物相对 seg 定位 */
.seg {
  flex: 0 0 50%;
  width: 50%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

/* ===========================================================
 * 4. 远景装饰: 满屏大数字 1-9 (V0.49.2 深色景深)
 *    远而虚: 深紫/深蓝调色板 + 0.40-0.55 alpha + 深紫描边, "雾里看远处数字"
 * =========================================================== */
.big-num {
  position: absolute;
  font-weight: 800;
  font-family: 'Trebuchet MS', 'Arial Rounded MT Bold', Arial, sans-serif;
  line-height: 1;
  letter-spacing: 0;
  text-shadow:
    /* 4 方向深紫描边 (深而虚, 远处感) */
    0 1px 0 rgba(46, 22, 70, 0.85),
    0 -1px 0 rgba(46, 22, 70, 0.85),
    1px 0 0 rgba(46, 22, 70, 0.85),
    -1px 0 0 rgba(46, 22, 70, 0.85),
    /* 浅色高光在外 (上方一点, 立体感) */
    0 -2px 2px rgba(255, 255, 255, 0.4);
  will-change: transform;
}

/* ===========================================================
 * 5. 中景装饰: 小网格方块 (3×3/4×4/5×5/6×6)
 *    V0.49.2 中景近而实: 糖果色 + alpha 0.55-0.78 (由 ts 给的 o 决定)
 *    + 深色外阴影 + 白色内边框, 让方块"浮起"在网格纸上方
 * =========================================================== */
.mini-grid {
  position: absolute;
  border: 2px solid;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.6);
  box-sizing: border-box;
  box-shadow:
    0 3px 12px rgba(74, 50, 130, 0.28),
    inset 0 0 0 1px rgba(255, 255, 255, 0.5);
}

.mini-cell {
  position: absolute;
  box-sizing: border-box;
  border-right: 1px solid rgba(74, 50, 130, 0.18);
  border-bottom: 1px solid rgba(74, 50, 130, 0.18);
}
.mini-cell-filled {
  border: none;
  border-radius: 2px;
  box-shadow:
    inset 0 0 4px rgba(255, 255, 255, 0.6),
    0 1px 3px rgba(74, 50, 130, 0.25);
}

/* ===========================================================
 * 6. 近景装饰: 彩色柔光点 (V0.49.2 近而亮)
 *    最近最亮: 高 alpha + 大光晕, box-shadow 注入 inline 颜色 (高反差闪光)
 * =========================================================== */
.thought {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 32%,
    rgba(255, 255, 255, 1) 0%,
    rgba(255, 255, 255, 0.78) 38%,
    rgba(255, 255, 255, 0) 100%);
  animation: thought-twinkle 4s ease-in-out infinite alternate;
  will-change: opacity, transform;
}
@keyframes thought-twinkle {
  from { transform: scale(0.92); }
  to   { transform: scale(1.1); }
}

/* ===========================================================
 * 7. 顶部暖白呼吸光 (周期 = pulseMs)
 *    跟场景 BGM 一小节同步, 慢而平缓 (不闪缩)
 * =========================================================== */
.fx-beat {
  position: absolute;
  left: 8%;
  top: 0;
  width: 84%;
  height: 46%;
  background: radial-gradient(ellipse at 50% 20%,
    rgba(255, 228, 240, 0.5) 0%,
    rgba(255, 235, 200, 0.22) 45%,
    transparent 72%);
  animation-name: beat-breath;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  will-change: transform, opacity;
}
@keyframes beat-breath {
  0%   { transform: scale(0.97); opacity: 0.5; }
  50%  { transform: scale(1.05); opacity: 0.9; }
  100% { transform: scale(0.97); opacity: 0.5; }
}
