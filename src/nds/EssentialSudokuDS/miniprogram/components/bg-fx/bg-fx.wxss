/* components/bg-fx/bg-fx.wxss — 全局动态背景层 (Night Study Desk, V0.36)
   暗夜书桌 + 思考主题 (替代 V0.35 明亮天空横版射击风):
   - 深色书桌 + 暖色台灯柔光, 不浮夸不抢戏
   - 漂浮数字方块 (think tiles) 暗示"数独/数字"主题
   - 草稿虚线方块 (drafts) 暗示"练习/推理"主题
   - 思考光点 (thoughts) 是轻盈的细节, 模拟灵感涌现
   skyline 渲染器支持 transform + opacity + animation, 对 filter 兼容性差。
   全项目禁用 rpx, 一律 px。
   层级: 本组件绝对定位填满 .scene-area, z-index 0;
         场景层 (scene-stage) z-index 1/2 浮在其上。
*/

.bg-fx {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background: #11152a; /* 兜底: 与 .fx-base 顶部同色, 防加载间隙露黑 */
}

/* ===========================================================
 * 1. 暗夜书桌底 (蓝紫 → 暖琥珀 → 暗木 + 台灯柔光晕)
 * V0.37 提亮: 主色抬到中调, 暖光增强, 整体不再压抑
 * =========================================================== */
.fx-base {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background:
    /* 台灯柔光晕 (中央偏上, 像一盏灯照在书桌) — 加强 */
    radial-gradient(ellipse 75% 60% at 50% 25%,
      rgba(255, 213, 138, 0.55) 0%,
      rgba(255, 200, 120, 0.32) 35%,
      rgba(255, 180, 100, 0.12) 65%,
      transparent 80%),
    /* 暖光底部反光 — 加强 */
    radial-gradient(ellipse 80% 45% at 30% 95%,
      rgba(255, 180, 120, 0.32) 0%,
      rgba(255, 180, 120, 0) 65%),
    /* 主渐变: 深夜蓝紫 → 暖琥珀 → 暗木 (整体调暖提亮) */
    linear-gradient(180deg,
      #2a2854 0%,
      #3a3060 28%,
      #4a3850 50%,
      #5a4030 72%,
      #2c1d14 100%);
}

/* ===========================================================
 * 2. 视差横滚层骨架 (每个 band = 一个视差平面)
 * =========================================================== */
.band {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* 上下缓浮 (让横滚产生斜向走动感) */
.bob {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  animation: band-bob ease-in-out infinite alternate;
  will-change: transform;
}
.bob-1 { animation-duration: 11s; }
.bob-2 { animation-duration: 8.4s; }
.bob-3 { animation-duration: 6.4s; }
@keyframes band-bob {
  from { transform: translate3d(0, -10px, 0); }
  to   { transform: translate3d(0, 12px, 0); }
}

/* 横滚: width:200%, 两个相同 seg 无缝循环 */
.roll {
  position: absolute;
  left: 0;
  top: 0;
  width: 200%;
  height: 100%;
  display: flex;
  animation: roll-x linear infinite;
  will-change: transform;
}
.roll-1 { animation-duration: 75s; }
.roll-2 { animation-duration: 45s; }
.roll-3 { animation-duration: 22s; }
@keyframes roll-x {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(-50%, 0, 0); }
}

/* 每个 seg 占 roll 一半 = 一屏宽, 装饰物相对 seg 定位 */
.seg {
  flex: 0 0 50%;
  width: 50%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

/* ===========================================================
 * 3. 远景装饰: 漂浮数字小方块 (think tiles)
 *    数字 1-9, 金/蓝双色, 慢速横滚
 * V0.37 提亮: 背景更深一点让数字更显眼, 边框/字色更亮
 * =========================================================== */
.think-tile {
  position: absolute;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5px solid;
  border-radius: 4px;
  background: rgba(20, 24, 44, 0.7);
  font-size: 13px;
  font-weight: 800;
  font-family: monospace;
  letter-spacing: 0;
  box-shadow: 0 0 10px rgba(245, 210, 122, 0.32),
    inset 0 0 4px rgba(255, 220, 160, 0.15);
}

/* ===========================================================
 * 4. 中景装饰: 草稿方块 (虚线格 / 已填一部分)
 *    像练习册的一行/一页, 已填的格子体现"做了一部分"状态
 * V0.37 提亮: 边框/填充色更饱和, 整体可读性更高
 * =========================================================== */
.draft {
  position: absolute;
  border-radius: 4px;
}

.draft-dashed {
  border: 1.5px dashed rgba(245, 210, 122, 0.75);
  background: rgba(20, 24, 44, 0.35);
}

.draft-partial {
  border: 1.5px solid rgba(127, 200, 255, 0.75);
  background: rgba(127, 200, 255, 0.08);
  padding: 4px;
  box-sizing: border-box;
}

.draft-cell {
  position: absolute;
  width: 22%;
  height: 22%;
  background: rgba(127, 200, 255, 0.55);
  border-radius: 2px;
  box-shadow: 0 0 4px rgba(127, 200, 255, 0.4);
}

/* ===========================================================
 * 5. 近景装饰: 思考光点 (柔光圆 + 高光)
 * V0.37 提亮: 中心更白, 整体光晕更大更亮
 * =========================================================== */
.thought {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 32%,
    rgba(255, 250, 230, 1) 0%,
    rgba(255, 235, 180, 0.7) 45%,
    rgba(255, 210, 140, 0.15) 100%);
  box-shadow: 0 0 10px rgba(255, 220, 160, 0.6);
  animation: thought-twinkle 4s ease-in-out infinite alternate;
  will-change: opacity, transform;
}
@keyframes thought-twinkle {
  from { transform: scale(0.92); }
  to   { transform: scale(1.08); }
}

/* ===========================================================
 * 6. 节拍柔光 (台灯余晖呼吸, 周期 = pulseMs)
 *    跟场景 BGM 一小节同步, 周期 = pulseMs, 慢而平缓 (不闪缩)
 *    位置改成台灯下方书桌中央偏右, 跟 fx-base 的台灯光晕呼应
 * =========================================================== */
.fx-beat {
  position: absolute;
  left: 22%;
  top: 8%;
  width: 56%;
  height: 50%;
  background: radial-gradient(ellipse at 50% 30%,
    rgba(255, 213, 138, 0.32) 0%,
    rgba(255, 200, 120, 0.14) 45%,
    transparent 72%);
  animation-name: beat-breath;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  will-change: transform, opacity;
}
@keyframes beat-breath {
  0%   { transform: scale(0.97); opacity: 0.65; }
  50%  { transform: scale(1.06); opacity: 1; }
  100% { transform: scale(0.97); opacity: 0.65; }
}
