<view class="sudoku-page">
  <!-- 顶部: 返回 + 关卡难度 (只读 metadata, 不可切换) + 步数 + 计时 -->
  <view class="game-header">
    <view class="header-left">
      <view
        class="ds-btn return-btn"
        hover-class="ds-btn-hover"
        hover-stay-time="80"
        bindtap="onBackMenu"
      >返回</view>
      <text class="diff-label">{{difficultyLabel}}</text>
    </view>
    <view class="header-right">
      <text class="stat">步数 {{moves}}</text>
      <text class="timer">{{timerText}}</text>
    </view>
  </view>

  <!-- 9x9 数字谜题棋盘 (旧称数独, V0.36 改名为"数字谜题"贴合用户语义) -->
  <view class="sudoku-grid">
    <view
      class="grid-row"
      wx:for="{{grid}}"
      wx:for-item="row"
      wx:key="r"
    >
      <view
        wx:for="{{row}}"
        wx:for-item="cell"
        wx:key="c"
        class="cell {{cell.given ? 'cell-given' : ''}} {{cell.err ? 'cell-err' : ''}} {{cell.sel ? 'cell-sel' : ''}} {{cell.same ? 'cell-same' : ''}} {{cell.c % 3 === 2 && cell.c < 8 ? 'box-r' : ''}} {{cell.r % 3 === 2 && cell.r < 8 ? 'box-b' : ''}}"
        data-r="{{cell.r}}"
        data-c="{{cell.c}}"
        bindtap="onTapCell"
      >
        <text wx:if="{{cell.v}}" class="cell-text">{{cell.v}}</text>
        <text wx:elif="{{cell.candidatesText}}" class="cell-candidates">{{cell.candidatesText}}</text>
      </view>
    </view>
  </view>

  <!-- 数字键盘 1-9 (双态文本按钮) -->
  <view class="number-pad">
    <view class="pad-row">
      <view
        wx:for="{{[1,2,3,4,5,6,7,8,9]}}"
        wx:key="*this"
        class="ds-btn ds-btn-key pad-key {{selectedValue === item ? 'ds-btn-active' : ''}}"
        hover-class="ds-btn-hover"
        hover-stay-time="80"
        data-num="{{item}}"
        bindtap="onTapNumber"
      >{{item}}</view>
    </view>
    <view class="pad-tools">
      <view class="tool-key ds-btn {{canUndo ? '' : 'tool-key-disabled'}}" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onUndo">撤销</view>
      <view class="tool-key ds-btn {{canRedo ? '' : 'tool-key-disabled'}}" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onRedo">重做</view>
      <view class="tool-key ds-btn {{notesMode ? 'ds-btn-active' : ''}}" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onToggleNotesMode">笔记</view>
      <view class="tool-key ds-btn" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onTapClear">清除</view>
      <view class="tool-key ds-btn tool-key-primary" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onTapHint">提示</view>
    </view>
  </view>
</view>
