/* sudoku-scene.wxss — V0.16 DS 化深色主题 (双态文本按钮 + 深蓝底) */
@import '../../../styles/ds-buttons.wxss';

.sudoku-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 20px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

/* 顶部信息栏: 返回按钮图 + 难度 + 步数 + 计时 */
.game-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.header-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

/* 返回按钮 (双态文本) */
.return-btn {
  width: 72px;
  height: 30px;
  padding: 0;
  flex-shrink: 0;
  border-radius: 8px;
  font-size: 13px;
}

.diff-label {
  font-size: 16px;
  font-weight: 700;
  color: #f0f4f8;
  white-space: nowrap;
}

.stat {
  font-size: 13px;
  color: #9aa7b4;
}

.timer {
  font-size: 15px;
  font-weight: 600;
  color: #f0f4f8;
}

/* 难度切换 chips (DS 深色胶囊) */
.diff-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-bottom: 10px;
}

.diff-chip {
  flex: 1;
  text-align: center;
  font-size: 12px;
  padding: 5px 0;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.1);
  color: #c6d2de;
  border: 0.5px solid rgba(255, 255, 255, 0.16);
}

.diff-chip-active {
  background: #2e6fc7;
  color: #ffffff;
  border-color: #3f83e0;
}

/* 9x9 棋盘 — 标准数独网格: 白底 + 深色粗 3x3 分块线 (数独必须清晰, 保持白底) */
.sudoku-grid {
  width: 100%;
  aspect-ratio: 1 / 1;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 1.5px solid #1a2733;
  box-sizing: border-box;
  border-radius: 6px;
  overflow: hidden;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
}

.grid-row {
  flex: 1;
  display: flex;
  flex-direction: row;
}

.cell {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-right: 0.5px solid #d0d8e0;
  border-bottom: 0.5px solid #d0d8e0;
}

.cell.box-r {
  border-right: 1.5px solid #2b3a4a;
}

.cell.box-b {
  border-bottom: 1.5px solid #2b3a4a;
}

.cell-text {
  font-size: 17px;
  color: #2b3a4a;
}

.cell-given .cell-text {
  font-weight: 700;
  color: #1a2733;
}

.cell-sel {
  background: #dbeafe;
}

.cell-sel .cell-text {
  color: #0d47a1;
  font-weight: 700;
}

.cell-same {
  background: #eef4fb;
}

.cell-err .cell-text {
  color: #e5494d;
  font-weight: 700;
}

/* 数字键盘 1-9 (文本双态按钮, 不再用 NBM 图; 与 select-scene/picture 统一) */
.number-pad {
  width: 100%;
  margin-top: 12px;
}

.pad-row {
  display: flex;
  flex-direction: row;
  gap: 6px;
}

.pad-key {
  flex: 1;
  height: 44px;
  border-radius: 9px;
  font-size: 20px;
}

.pad-tools {
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-top: 8px;
}

.tool-key {
  flex: 1;
  height: 38px;
  padding: 0;
  font-size: 13px;
}

.tool-key-primary {
  background: #2e6fc7;
  border-color: #3f83e0;
  color: #ffffff;
}

/* V0.18 候选笔记显示 */
.cell-candidates {
  font-size: 8px;
  line-height: 1.1;
  color: #5a6a7a;
  text-align: center;
  padding: 0 1px;
  word-break: break-all;
}

.tool-key-active {
  background: #2e6fc7;
  color: #ffffff;
  border-color: #3f83e0;
}

.tool-key-disabled {
  opacity: 0.45;
}
