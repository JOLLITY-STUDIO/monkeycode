/* sudoku-scene.wxss — V0.16 数独玩法样式 (迁移自 pages/index/index.wxss) */
.sudoku-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 20px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #f0f4f8;
}

/* 原 DS title.nbm 标题横幅 */
.title-banner {
  width: 100%;
  height: 120px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 8px;
  background: #1a4d2e;
}

.title-image {
  width: 100%;
  height: 100%;
}

/* 顶部信息栏 */
.game-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.header-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.mode-link {
  font-size: 12px;
  color: #8e24aa;
  background: #f3e5f5;
  padding: 4px 9px;
  border-radius: 10px;
  border: 0.5px solid #ce93d8;
  white-space: nowrap;
}

.mode-link-staff {
  color: #1565c0;
  background: #e3f2fd;
  border-color: #90caf9;
}

.mode-link-menu {
  color: #6a1b9a;
  background: #f3e5f5;
  border-color: #ce93d8;
}

.diff-label {
  font-size: 16px;
  font-weight: 700;
  color: #2b3a4a;
}

.stat {
  font-size: 13px;
  color: #6b7a8a;
  margin-left: 10px;
}

.timer {
  font-size: 15px;
  font-weight: 600;
  color: #2b3a4a;
}

/* 难度切换 */
.diff-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-bottom: 10px;
}

.diff-chip {
  flex: 1;
  text-align: center;
  font-size: 12px;
  padding: 5px 0;
  border-radius: 6px;
  background: #ffffff;
  color: #6b7a8a;
  border: 0.5px solid #d0d8e0;
}

.diff-chip-active {
  background: #2b3a4a;
  color: #ffffff;
  border-color: #2b3a4a;
}

/* 9x9 棋盘 — 标准数独网格: 白底 + 深色粗 3x3 分块线 */
.sudoku-grid {
  width: 100%;
  aspect-ratio: 1 / 1;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 1.5px solid #2b3a4a;
  box-sizing: border-box;
  border-radius: 4px;
  overflow: hidden;
}

.grid-row {
  flex: 1;
  display: flex;
  flex-direction: row;
}

.cell {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-right: 0.5px solid #d0d8e0;
  border-bottom: 0.5px solid #d0d8e0;
}

.cell.box-r {
  border-right: 1.5px solid #2b3a4a;
}

.cell.box-b {
  border-bottom: 1.5px solid #2b3a4a;
}

.cell-text {
  font-size: 17px;
  color: #2b3a4a;
}

.cell-given .cell-text {
  font-weight: 700;
  color: #1a2733;
}

.cell-sel {
  background: #dbeafe;
}

.cell-same {
  background: #eef4fb;
}

.cell-err .cell-text {
  color: #e5494d;
  font-weight: 700;
}

/* 数字键盘 */
.number-pad {
  width: 100%;
  margin-top: 12px;
}

.pad-row {
  display: flex;
  flex-direction: row;
  gap: 6px;
}

.pad-key {
  flex: 1;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 7px;
  overflow: hidden;
}

.pad-key-image {
  width: 100%;
  height: 100%;
}

.pad-key-active .pad-key-image {
  filter: brightness(0.92);
}

.pad-tools {
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-top: 8px;
}

.tool-key {
  flex: 1;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #2b3a4a;
  background: #ffffff;
  border-radius: 7px;
  box-shadow: 0 1px 3px rgba(43, 58, 74, 0.08);
}

.tool-key-primary {
  background: #2b3a4a;
  color: #ffffff;
}

.tool-key-clear {
  padding: 0 8px;
}

.tool-key-icon {
  height: 18px;
  width: auto;
  max-width: 100%;
}

/* V0.18 候选笔记显示 */
.cell-candidates {
  font-size: 8px;
  line-height: 1.1;
  color: #5a6a7a;
  text-align: center;
  padding: 0 1px;
  word-break: break-all;
}

.tool-key-active {
  background: #e3f2fd;
  color: #1565c0;
  box-shadow: inset 0 0 0 1px #1565c0, 0 1px 3px rgba(21, 101, 192, 0.12);
}

.tool-key-disabled {
  opacity: 0.45;
}
