<view class="menu-page">
  <!-- 顶部标题横幅 (DS 原版 title.nbm) -->
  <view class="title-banner">
    <image class="title-image" src="/assets/nbm/title.nbm.png" mode="aspectFill" lazy-load></image>
  </view>

  <!-- 主菜单模式选择 -->
  <view class="mode-select-card">
    <view class="menu-label-wrap">
      <view class="menu-label">SELECT MODE</view>
    </view>

    <view class="mode-btn"
          bindtouchstart="onNumberTouchStart"
          bindtouchend="onNumberTouchEnd"
          bindtap="onOpenNumberPuzzle">
      <image class="mode-btn-image"
             src="{{numberPressed ? numberPressedUrl : numberNormalUrl}}"
             mode="widthFix"
             lazy-load></image>
    </view>

    <view class="mode-btn"
          bindtouchstart="onPictureTouchStart"
          bindtouchend="onPictureTouchEnd"
          bindtap="onOpenPicturePuzzle">
      <image class="mode-btn-image"
             src="{{picturePressed ? picturePressedUrl : pictureNormalUrl}}"
             mode="widthFix"
             lazy-load></image>
    </view>
  </view>

  <!-- 底部辅助入口 -->
  <view class="bottom-links">
    <view class="link-btn" bindtap="onBackTitle">返回标题</view>
    <view class="link-btn" bindtap="onOpenTutorial">玩法说明</view>
    <view class="link-btn" bindtap="onOpenStaff">制作人员</view>
    <view class="link-btn" bindtap="onOpenOptions">选项</view>
  </view>
</view>
