<view class="menu-page">
  <!-- 顶部标题横幅 (DS 原版 title.nbm) -->
  <view class="title-banner">
    <image class="title-image" src="/assets/nbm/title.nbm.png" mode="aspectFill" lazy-load></image>
  </view>

  <!-- 主菜单模式选择 (双态文本按钮) -->
  <view class="mode-select-card">
    <view class="menu-label-wrap">
      <view class="menu-label">SELECT MODE</view>
    </view>

    <view
      class="mode-btn ds-btn ds-btn-lg"
      hover-class="ds-btn-hover"
      hover-stay-time="100"
      bindtap="onOpenNumberPuzzle"
    >数字谜题 (数独)</view>

    <view
      class="mode-btn ds-btn ds-btn-lg"
      hover-class="ds-btn-hover"
      hover-stay-time="100"
      bindtap="onOpenPicturePuzzle"
    >图画谜题</view>
  </view>

  <!-- 底部辅助入口 -->
  <view class="bottom-links">
    <view class="link-btn ds-btn-sm ds-btn" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onBackTitle">返回标题</view>
    <view class="link-btn ds-btn-sm ds-btn" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onOpenTutorial">玩法说明</view>
    <view class="link-btn ds-btn-sm ds-btn" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onOpenStaff">制作人员</view>
    <view class="link-btn ds-btn-sm ds-btn" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onOpenOptions">选项</view>
  </view>
</view>
