<view class="menu-page">
  <!-- 顶部标题横幅 (DS 原版 title.nbm) -->
  <view class="title-banner">
    <image class="title-image" src="/assets/nbm/title.nbm.png" mode="aspectFit" lazy-load></image>
  </view>

  <!-- 主视觉: 两个大模式宫格 -->
  <view class="mode-grid">
    <view
      class="mode-card mode-card-numple"
      hover-class="mode-card-press"
      hover-stay-time="120"
      bindtap="onOpenNumberPuzzle"
    >
      <view class="mode-card-icon">9×9</view>
      <view class="mode-card-title">数独</view>
      <view class="mode-card-desc">数字谜题</view>
      <view class="mode-card-hint">1000 题</view>
    </view>

    <view
      class="mode-card mode-card-numclo"
      hover-class="mode-card-press"
      hover-stay-time="120"
      bindtap="onOpenPicturePuzzle"
    >
      <view class="mode-card-icon">15×15</view>
      <view class="mode-card-title">图画谜题</view>
      <view class="mode-card-desc">像素画填色</view>
      <view class="mode-card-hint">1525 题</view>
    </view>
  </view>

  <!-- 底部二级入口 (4 列等宽) -->
  <view class="bottom-links">
    <view class="link-btn ds-btn-sm ds-btn" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onOpenTutorial">玩法说明</view>
    <view class="link-btn ds-btn-sm ds-btn" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onOpenOptions">选项</view>
    <view class="link-btn ds-btn-sm ds-btn" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onOpenStaff">制作人员</view>
    <view class="link-btn ds-btn-sm ds-btn ds-btn-ghost" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onBackTitle">返回标题</view>
  </view>

  <!-- 版权 / 版本信息 -->
  <view class="menu-footer">
    <view class="menu-footer-text">Essential Sudoku DS · H5 复刻版</view>
    <view class="menu-footer-build">v0.30</view>
  </view>
</view>
