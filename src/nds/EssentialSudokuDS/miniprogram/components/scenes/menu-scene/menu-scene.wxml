<view class="menu-page">
  <!-- 顶部标题横幅 -->
  <view class="title-banner">
    <image class="title-image" src="/assets/nbm/title.nbm.png" mode="aspectFill" lazy-load></image>
  </view>

  <!-- 主菜单模式选择 -->
  <view class="mode-select-card">
    <view class="menu-label-wrap">
      <view class="menu-label">SELECT MODE</view>
    </view>
    <view class="select-bg-wrap">
      <image class="select4-bg" src="/assets/nbm/select4.nbm.png" mode="aspectFill"></image>
      <image
        class="mode-cursor"
        src="{{menuCursorUrl}}"
        mode="aspectFit"
        style="top: {{cursorTop}}px;"
        lazy-load
      ></image>
      <view class="mode-buttons">
        <view class="mode-btn number-puzzle {{selectedMode === 'number' ? 'mode-btn-active' : ''}}" bindtap="onOpenNumberPuzzle">
          <text class="mode-btn-text">Number Puzzle</text>
        </view>
        <view class="mode-btn picture-puzzle {{selectedMode === 'picture' ? 'mode-btn-active' : ''}}" bindtap="onOpenPicturePuzzle">
          <text class="mode-btn-text">Picture Puzzle</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部辅助入口 -->
  <view class="bottom-links">
    <view class="link-btn" bindtap="onBackTitle">返回标题</view>
    <view class="link-btn" bindtap="onOpenTutorial">玩法说明</view>
    <view class="link-btn" bindtap="onOpenStaff">制作人员</view>
    <view class="link-btn" bindtap="onOpenOptions">选项</view>
  </view>
</view>
