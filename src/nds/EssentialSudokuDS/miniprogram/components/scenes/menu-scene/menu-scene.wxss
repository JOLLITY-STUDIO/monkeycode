.menu-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #e9eef3;
}

.title-banner {
  width: 100%;
  height: 120px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 12px;
  background: #1a4d2e;
}

.title-image {
  width: 100%;
  height: 100%;
}

.mode-select-card {
  width: 100%;
  background: #ffffff;
  border-radius: 10px;
  padding: 14px 12px 18px;
  box-sizing: border-box;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
  margin-bottom: 12px;
}

.menu-label-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 10px;
}

.menu-label {
  font-size: 16px;
  font-weight: 700;
  color: #3a4a5a;
  text-align: center;
  letter-spacing: 1px;
}

.select-bg-wrap {
  width: 100%;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 10px 0;
  box-sizing: border-box;
}

/* ===== 模式按钮标准: 待机态 / 点击态 =====
   待机态: 高饱和度渐变底 + 明显投影 (立体浮起感)
   点击态: 底色压暗 + 阴影收缩到 0 + 轻微下沉 (物理按压感) */
.mode-btn {
  width: 100%;
  height: 62px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 0.08s ease, box-shadow 0.08s ease, filter 0.08s ease;
}

.mode-btn-number {
  background: linear-gradient(180deg, #4db8ff, #1f8fe8);
  box-shadow: 0 5px 12px rgba(31, 143, 232, 0.45);
}

.mode-btn-picture {
  background: linear-gradient(180deg, #3a5bd6, #2339a8);
  box-shadow: 0 5px 12px rgba(35, 57, 168, 0.45);
}

.mode-btn:active {
  transform: scale(0.97) translateY(2px);
  filter: brightness(0.82);
  box-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.mode-btn-text {
  font-size: 17px;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1.5px;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.bottom-links {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: auto;
}

.link-btn {
  font-size: 12px;
  color: #5a6a7a;
  background: #ffffff;
  padding: 6px 11px;
  border-radius: 13px;
  border: 0.5px solid #d0d8e0;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  white-space: nowrap;
}

.link-btn:active {
  background: #f2f4f6;
}
