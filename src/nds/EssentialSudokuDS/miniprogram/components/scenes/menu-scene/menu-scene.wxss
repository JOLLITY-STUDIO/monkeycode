/* menu-scene.wxss — V0.35 真游戏风: 大蓝胶囊艺术字 (仿 DS Present/VS 风格) + 亮色天空滚动背景
   抛弃 V0.30 的"4 层信息卡堆叠"软件风
   抛弃 V0.31 的"双宫格配色蓝橙对比"过度装饰
   根背景 transparent, 透出 index 层 bg-fx 明亮天空循环背景;
   底部辅助钮改深色玻璃 (亮底上保持可读)
*/

/* ---------- 页面骨架 ---------- */
.menu-page {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  min-height: 100vh;
  padding: 32px 24px 24px;
  box-sizing: border-box;
  background: transparent;
  overflow: hidden;
}

/* ---------- 背景装饰 (柔和光晕) ---------- */
.bg-glow-top {
  position: absolute;
  top: -120px;
  left: -80px;
  width: 480px;
  height: 360px;
  background: radial-gradient(ellipse at center, rgba(77, 184, 255, 0.18) 0%, rgba(77, 184, 255, 0) 70%);
  pointer-events: none;
}

.bg-glow-bottom {
  position: absolute;
  bottom: -100px;
  right: -80px;
  width: 400px;
  height: 320px;
  background: radial-gradient(ellipse at center, rgba(0, 200, 180, 0.12) 0%, rgba(0, 200, 180, 0) 70%);
  pointer-events: none;
}

/* ---------- 顶部 LOGO 横幅 ---------- */
.title-banner {
  width: 100%;
  max-width: 420px;
  height: 168px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36px;
  margin-top: 8px;
}

.title-image {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.5));
}

/* ---------- 主按钮区 (2 个大蓝胶囊) ---------- */
.main-buttons {
  width: 100%;
  max-width: 420px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-bottom: 36px;
}

/* 通用大蓝胶囊按钮 — 仿 DS Present/VS/Options 风格
   设计:
   - 顶部高光 (白色光斑)
   - 中部蓝渐变
   - 底部深蓝边 1px
   - 内文字: 24-26px 大字 + 白字 + 蓝边描边 (4 方向) */
.game-btn {
  position: relative;
  width: 100%;
  height: 70px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  background: linear-gradient(180deg, #5cb6f8 0%, #28a0f0 45%, #1a8ad8 100%);
  border: 1.5px solid #0f5d9e;
  box-shadow: 0 5px 0 #0d4477, 0 7px 14px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.55),
    inset 0 -2px 0 rgba(0, 0, 0, 0.1);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
  overflow: hidden;
}

/* 顶部高光白条 */
.game-btn::before {
  content: '';
  position: absolute;
  top: 2px;
  left: 4px;
  right: 4px;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0) 100%);
  border-radius: 12px 12px 50% 50% / 12px 12px 100% 100%;
  pointer-events: none;
}

.game-btn-numple {
  /* 数独: 蓝青渐变 */
  background: linear-gradient(180deg, #5cb6f8 0%, #28a0f0 45%, #1a8ad8 100%);
}

.game-btn-numclo {
  /* 图画谜题: 紫蓝渐变 (用同色域偏紫突出) */
  background: linear-gradient(180deg, #7d9cf8 0%, #4870d8 45%, #2e50b0 100%);
}

/* 按下: 整体下移, 底色阴影变浅 */
.game-btn-press {
  transform: translateY(4px);
  box-shadow: 0 1px 0 #0d4477, 0 2px 4px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

/* 大字艺术字: 白字 + 4 方向深蓝描边 */
.game-btn-text {
  position: relative;
  font-size: 28px;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 8px;
  line-height: 1;
  text-shadow:
    -1px 0 #0d4477, 0 -1px #0d4477,
    1px 0 #0d4477, 0 1px #0d4477,
    -1px -1px #0d4477, 1px -1px #0d4477,
    -1px 1px #0d4477, 1px 1px #0d4477,
    0 2px 4px rgba(0, 0, 0, 0.3);
  padding-left: 8px;  /* 补偿字距让中文视觉居中 */
}

/* ---------- 中间分隔条 (装饰, 模拟 DS 选项档) ---------- */
.divider {
  width: 100%;
  max-width: 420px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}

.divider-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.2) 50%, rgba(255, 255, 255, 0) 100%);
}

.divider-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(77, 184, 255, 0.6);
  box-shadow: 0 0 6px rgba(77, 184, 255, 0.4);
}

/* ---------- 底部 4 个辅助小按钮 (深色玻璃胶囊, 亮底上保持可读) ---------- */
.bottom-links {
  width: 100%;
  max-width: 420px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-bottom: 28px;
}

.sub-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 38px;
  padding: 0 8px;
  border-radius: 18px;
  background: rgba(22, 42, 66, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #e9eef3;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 2px;
  box-shadow: 0 2px 6px rgba(13, 27, 42, 0.25);
  transition: background 0.08s ease, border-color 0.08s ease, color 0.08s ease, transform 0.08s ease;
}

.sub-btn-press {
  background: rgba(77, 184, 255, 0.65);
  border-color: rgba(255, 255, 255, 0.85);
  color: #ffffff;
  transform: scale(0.96);
}

.sub-btn-back {
  background: rgba(13, 27, 42, 0.4);
  border-color: rgba(255, 255, 255, 0.2);
  color: #d7e3f0;
}

.sub-btn-back.sub-btn-press {
  background: rgba(255, 255, 255, 0.25);
  border-color: rgba(255, 255, 255, 0.6);
  color: #ffffff;
}

/* ---------- 页脚版权 (深色字压在亮底上, 加半透明白字影增加可读) ---------- */
.menu-copyright {
  margin-top: auto;
  font-size: 11px;
  color: #0d4477;
  letter-spacing: 0.5px;
  text-align: center;
  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.7);
}

/* ===========================================================
 * V0.34 入场 + 常流动效 (每帧挂载只播一次入场; 之后光晕/LOGO 持续浮动)
 * 全用 backwards 填充, 动画结束后回落到类样式, 不影响 hover 按压缩放
 * =========================================================== */

/* --- 光晕呼吸漂浮 (持续, 让菜单层不是死的) --- */
.bg-glow-top {
  animation: glow-breathe 3.8s ease-in-out infinite alternate;
}
.bg-glow-bottom {
  animation: glow-breathe 4.6s ease-in-out infinite alternate;
}
@keyframes glow-breathe {
  from { transform: translate3d(0, 0, 0) scale(1); opacity: 0.8; }
  to   { transform: translate3d(14px, 16px, 0) scale(1.18); opacity: 1; }
}

/* --- LOGO 入场下坠 + 常驻轻浮动 --- */
.title-banner {
  animation: menu-drop 0.5s cubic-bezier(0.22, 1.3, 0.36, 1) backwards;
}
.title-image {
  animation: logo-bob 4.6s ease-in-out infinite;
}
@keyframes menu-drop {
  from { opacity: 0; transform: translate3d(0, -30px, 0) scale(0.92); }
  to   { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}
@keyframes logo-bob {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50%      { transform: translate3d(0, -6px, 0); }
}

/* --- 主按钮逐个弹出 (微弹簧) --- */
.main-buttons .game-btn {
  animation: menu-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}
.main-buttons .game-btn-numclo {
  animation-delay: 0.1s;
}
@keyframes menu-pop {
  from { opacity: 0; transform: translate3d(0, 20px, 0) scale(0.9); }
  to   { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

/* --- 分隔条 + 底部辅助按钮错峰上浮 --- */
.divider {
  animation: menu-fadeup 0.4s ease 0.16s backwards;
}
.bottom-links .sub-btn:nth-child(1) { animation: menu-fadeup 0.34s ease 0.22s backwards; }
.bottom-links .sub-btn:nth-child(2) { animation: menu-fadeup 0.34s ease 0.28s backwards; }
.bottom-links .sub-btn:nth-child(3) { animation: menu-fadeup 0.34s ease 0.34s backwards; }
.bottom-links .sub-btn:nth-child(4) { animation: menu-fadeup 0.34s ease 0.40s backwards; }
.menu-copyright {
  animation: menu-fadeup 0.5s ease 0.5s backwards;
}
@keyframes menu-fadeup {
  from { opacity: 0; transform: translate3d(0, 16px, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}
