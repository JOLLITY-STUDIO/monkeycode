/* menu-scene.wxss — V0.36: 暗夜书桌 bg-fx 之上重做菜单
   抛弃 V0.35 明亮天空 + 白色 LOGO 风格, 改为:
   - 顶部 LOGO 区: 纯文字 ESSENTIAL PUZZLE DS + 每日拼图 (替代已损坏的 title.nbm.png)
   - 主按钮 2 个大蓝胶囊 + 描边字 保持原 V0.34 视觉 (蓝色按钮在暗底上仍然清晰)
   - 底部辅助钮改深色玻璃 (深底上可读性更强)
   根背景 transparent, 透出 index 层 bg-fx 暗夜书桌循环背景;
*/

/* ---------- 页面骨架 ---------- */
.menu-page {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  min-height: 100vh;
  padding: 32px 24px 24px;
  box-sizing: border-box;
  background: transparent;
  overflow: hidden;
}

/* ---------- 背景装饰 (柔和光晕, V0.36 暗色版) ---------- */
.bg-glow-top {
  position: absolute;
  top: -120px;
  left: -80px;
  width: 480px;
  height: 360px;
  background: radial-gradient(ellipse at center, rgba(245, 210, 122, 0.14) 0%, rgba(245, 210, 122, 0) 70%);
  pointer-events: none;
}

.bg-glow-bottom {
  position: absolute;
  bottom: -100px;
  right: -80px;
  width: 400px;
  height: 320px;
  background: radial-gradient(ellipse at center, rgba(127, 200, 255, 0.1) 0%, rgba(127, 200, 255, 0) 70%);
  pointer-events: none;
}

/* ---------- 顶部 LOGO 横幅 (V0.36 纯文字, 替代 title.nbm.png) ---------- */
.title-banner {
  width: 100%;
  max-width: 420px;
  min-height: 120px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 32px;
  margin-top: 8px;
  padding: 16px 0;
}

.title-text {
  font-size: 22px;
  font-weight: 800;
  color: #7a3fb0;
  letter-spacing: 4px;
  text-shadow:
    0 0 2px rgba(255, 255, 255, 0.85),
    0 2px 8px rgba(182, 108, 229, 0.35);
}

.title-sub {
  font-size: 14px;
  font-weight: 600;
  color: #5a4a8a;
  letter-spacing: 6px;
  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.9);
}

/* ---------- 主按钮区 (2 个大蓝胶囊) ---------- */
.main-buttons {
  width: 100%;
  max-width: 420px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-bottom: 36px;
}

/* 通用大蓝胶囊按钮 — 仿 DS Present/VS/Options 风格
   - 顶部高光 (白色光斑)
   - 中部蓝渐变
   - 底部深蓝边 1px
   - 内文字: 24-26px 大字 + 白字 + 蓝边描边 (4 方向) */
.game-btn {
  position: relative;
  width: 100%;
  height: 70px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  background: linear-gradient(180deg, #5cb6f8 0%, #28a0f0 45%, #1a8ad8 100%);
  border: 1.5px solid #0f5d9e;
  box-shadow: 0 5px 0 #0d4477, 0 7px 14px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.55),
    inset 0 -2px 0 rgba(0, 0, 0, 0.1);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
  overflow: hidden;
}

/* 顶部高光白条 */
.game-btn::before {
  content: '';
  position: absolute;
  top: 2px;
  left: 4px;
  right: 4px;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0) 100%);
  border-radius: 12px 12px 50% 50% / 12px 12px 100% 100%;
  pointer-events: none;
}

.game-btn-numple {
  /* 数字谜题 (旧称数独): 蓝青渐变 */
  background: linear-gradient(180deg, #5cb6f8 0%, #28a0f0 45%, #1a8ad8 100%);
}

.game-btn-numclo {
  /* 图画谜题: 紫蓝渐变 (用同色域偏紫突出) */
  background: linear-gradient(180deg, #7d9cf8 0%, #4870d8 45%, #2e50b0 100%);
}

/* 按下: 整体下移, 底色阴影变浅 */
.game-btn-press {
  transform: translateY(4px);
  box-shadow: 0 1px 0 #0d4477, 0 2px 4px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

/* 大字艺术字: 白字 + 4 方向深蓝描边 */
.game-btn-text {
  position: relative;
  font-size: 28px;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 8px;
  line-height: 1;
  text-shadow:
    -1px 0 #0d4477, 0 -1px #0d4477,
    1px 0 #0d4477, 0 1px #0d4477,
    -1px -1px #0d4477, 1px -1px #0d4477,
    -1px 1px #0d4477, 1px 1px #0d4477,
    0 2px 4px rgba(0, 0, 0, 0.3);
  padding-left: 8px;  /* 补偿字距让中文视觉居中 */
}

/* ---------- 中间分隔条 (装饰, 模拟 DS 选项档) ---------- */
.divider {
  width: 100%;
  max-width: 420px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}

.divider-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, rgba(182, 108, 229, 0) 0%, rgba(182, 108, 229, 0.45) 50%, rgba(182, 108, 229, 0) 100%);
}

.divider-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(182, 108, 229, 0.8);
  box-shadow: 0 0 6px rgba(182, 108, 229, 0.5);
}

/* ---------- 底部 4 个辅助小按钮 (白玻璃胶囊 + 紫字, 糖果亮底一致)
   V0.37: 改 display:grid; grid-template-columns:repeat(4,1fr) 为 flex 4 等分,
   因 Skyline 渲染器不支持 grid-template-columns (报 warning 还不渲染) */
.bottom-links {
  width: 100%;
  max-width: 420px;
  display: flex;
  gap: 10px;
  margin-bottom: 28px;
}

.sub-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 38px;
  padding: 0 8px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(182, 108, 229, 0.45);
  color: #6a3aa0;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 2px;
  box-shadow: 0 2px 8px rgba(182, 108, 229, 0.16);
  transition: background 0.08s ease, border-color 0.08s ease, color 0.08s ease, transform 0.08s ease;
}

.sub-btn-press {
  background: rgba(182, 108, 229, 0.14);
  border-color: rgba(182, 108, 229, 0.65);
  color: #6a3aa0;
  transform: scale(0.96);
}

.sub-btn-back {
  background: rgba(255, 255, 255, 0.6);
  border-color: rgba(182, 108, 229, 0.3);
  color: #8a5ab8;
}

.sub-btn-back.sub-btn-press {
  background: rgba(182, 108, 229, 0.18);
  border-color: rgba(182, 108, 229, 0.5);
  color: #6a3aa0;
}

/* ---------- 页脚版权 (V0.44 糖果亮底, 深紫灰字) ---------- */
.menu-copyright {
  margin-top: auto;
  font-size: 11px;
  color: rgba(90, 74, 138, 0.75);
  letter-spacing: 0.5px;
  text-align: center;
  text-shadow: 0 1px 1px rgba(255, 255, 255, 0.8);
}

/* ===========================================================
 * V0.34 入场 + 常流动效
 * 全用 backwards 填充, 动画结束后回落到类样式, 不影响 hover 按压缩放
 * =========================================================== */

/* --- 光晕呼吸漂浮 (持续, 让菜单层不是死的) --- */
.bg-glow-top {
  animation: glow-breathe 3.8s ease-in-out infinite alternate;
}
.bg-glow-bottom {
  animation: glow-breathe 4.6s ease-in-out infinite alternate;
}
@keyframes glow-breathe {
  from { transform: translate3d(0, 0, 0) scale(1); opacity: 0.8; }
  to   { transform: translate3d(14px, 16px, 0) scale(1.18); opacity: 1; }
}

/* --- 顶部标题入场下坠 + 常驻轻浮动 --- */
.title-banner {
  animation: menu-drop 0.5s cubic-bezier(0.22, 1.3, 0.36, 1) backwards;
}
.title-text {
  animation: logo-bob 4.6s ease-in-out infinite;
}
@keyframes menu-drop {
  from { opacity: 0; transform: translate3d(0, -30px, 0) scale(0.92); }
  to   { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}
@keyframes logo-bob {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50%      { transform: translate3d(0, -3px, 0); }
}

/* --- 主按钮逐个弹出 (微弹簧) --- */
.main-buttons .game-btn {
  animation: menu-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}
.main-buttons .game-btn-numclo {
  animation-delay: 0.1s;
}
@keyframes menu-pop {
  from { opacity: 0; transform: translate3d(0, 20px, 0) scale(0.9); }
  to   { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

/* --- 分隔条 + 底部辅助按钮错峰上浮 --- */
.divider {
  animation: menu-fadeup 0.4s ease 0.16s backwards;
}
.bottom-links .sub-btn:nth-child(1) { animation: menu-fadeup 0.34s ease 0.22s backwards; }
.bottom-links .sub-btn:nth-child(2) { animation: menu-fadeup 0.34s ease 0.28s backwards; }
.bottom-links .sub-btn:nth-child(3) { animation: menu-fadeup 0.34s ease 0.34s backwards; }
.bottom-links .sub-btn:nth-child(4) { animation: menu-fadeup 0.34s ease 0.40s backwards; }
.menu-copyright {
  animation: menu-fadeup 0.5s ease 0.5s backwards;
}
@keyframes menu-fadeup {
  from { opacity: 0; transform: translate3d(0, 16px, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}
