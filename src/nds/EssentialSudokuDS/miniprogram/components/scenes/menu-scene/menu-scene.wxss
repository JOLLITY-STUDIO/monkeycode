@import '../../../styles/ds-buttons.wxss';

.menu-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  min-height: 100vh;
  padding: 16px 16px 20px;
  box-sizing: border-box;
  background: #0d1b2a;
}

/* 顶部标题横幅 (缩小,不喧宾夺主) */
.title-banner {
  width: 100%;
  max-width: 480px;
  height: 88px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 20px;
  background: transparent;
  box-shadow: none;
}

.title-image {
  width: 100%;
  height: 100%;
}

/* 主视觉宫格 */
.mode-grid {
  width: 100%;
  max-width: 480px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-bottom: 24px;
}

.mode-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 168px;
  padding: 14px 12px;
  box-sizing: border-box;
  border-radius: 14px;
  background: rgba(22, 42, 66, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  transition: transform 0.12s ease, background 0.12s ease, border-color 0.12s ease;
  overflow: hidden;
}

.mode-card-numple {
  background: linear-gradient(160deg, rgba(40, 160, 240, 0.25) 0%, rgba(22, 42, 66, 0.88) 100%);
  border-color: rgba(40, 160, 240, 0.45);
}

.mode-card-numclo {
  background: linear-gradient(160deg, rgba(255, 152, 0, 0.22) 0%, rgba(22, 42, 66, 0.88) 100%);
  border-color: rgba(255, 152, 0, 0.45);
}

.mode-card-press {
  transform: scale(0.97);
  background: rgba(77, 184, 255, 0.18);
  border-color: #4db8ff;
}

.mode-card-icon {
  font-size: 28px;
  font-weight: 800;
  color: #4db8ff;
  letter-spacing: 2px;
  margin-bottom: 8px;
  text-shadow: 0 0 12px rgba(77, 184, 255, 0.35);
}

.mode-card-numclo .mode-card-icon {
  color: #ffb04d;
  text-shadow: 0 0 12px rgba(255, 152, 0, 0.35);
}

.mode-card-title {
  font-size: 19px;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 4px;
  letter-spacing: 1px;
}

.mode-card-desc {
  font-size: 12px;
  color: #c8d5e8;
  margin-bottom: 10px;
}

.mode-card-hint {
  font-size: 11px;
  color: #9fb6d3;
  padding: 3px 10px;
  border-radius: 10px;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

/* 底部二级入口 */
.bottom-links {
  width: 100%;
  max-width: 480px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-bottom: 18px;
}

.link-btn {
  margin: 0;
  white-space: nowrap;
  font-size: 12px;
  padding: 0 4px;
}

.ds-btn-ghost {
  background: transparent;
  border-color: rgba(255, 255, 255, 0.04);
  color: #9fb6d3;
}

/* 版权 / 版本 (页脚) */
.menu-footer {
  width: 100%;
  max-width: 480px;
  margin-top: auto;
  padding-top: 12px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.menu-footer-text {
  font-size: 11px;
  color: #6f86a3;
  letter-spacing: 0.5px;
}

.menu-footer-build {
  font-size: 11px;
  color: #4f6580;
  font-family: monospace;
}
