.menu-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #e9eef3;
}

.title-banner {
  width: 100%;
  height: 120px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 12px;
  background: #1a4d2e;
}

.title-image {
  width: 100%;
  height: 100%;
}

.mode-select-card {
  width: 100%;
  background: #ffffff;
  border-radius: 10px;
  padding: 14px 12px 18px;
  box-sizing: border-box;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
  margin-bottom: 12px;
}

.menu-label {
  font-size: 16px;
  font-weight: 700;
  color: #3a4a5a;
  text-align: center;
  margin-bottom: 10px;
  letter-spacing: 1px;
}

.select-bg-wrap {
  position: relative;
  width: 100%;
  height: 180px;
  border-radius: 8px;
  overflow: hidden;
  background: #00ff00;
}

.select4-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.95;
}

.mode-buttons {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12px;
  padding: 12px 20px;
  box-sizing: border-box;
}

.mode-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 20px;
  border-radius: 7px;
  transition: background 0.15s ease;
}

.mode-btn:active {
  background: rgba(255, 255, 255, 0.18);
}

.mode-btn-text {
  font-size: 17px;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
  letter-spacing: 0.5px;
}

.bottom-links {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: auto;
}

.link-btn {
  font-size: 12px;
  color: #5a6a7a;
  background: #ffffff;
  padding: 6px 11px;
  border-radius: 13px;
  border: 0.5px solid #d0d8e0;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  white-space: nowrap;
}

.link-btn:active {
  background: #f2f4f6;
}
