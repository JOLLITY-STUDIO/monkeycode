.menu-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  min-height: 100vh;
  padding: 12px 16px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #0d1b2a;
}

.title-banner {
  width: 100%;
  height: 120px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 16px;
  background: #162a42;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
}

.title-image {
  width: 100%;
  height: 100%;
}

.mode-select-card {
  width: 100%;
  max-width: 320px;
  background: rgba(22, 42, 66, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 14px 16px 18px;
  box-sizing: border-box;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
  margin-bottom: 16px;
}

.menu-label-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 12px;
}

.menu-label {
  font-size: 15px;
  font-weight: 700;
  color: #9fb6d3;
  text-align: center;
  letter-spacing: 2px;
}

.mode-btn {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
  border-radius: 10px;
  overflow: hidden;
  transition: transform 0.08s ease, filter 0.08s ease;
}

.mode-btn:last-child {
  margin-bottom: 0;
}

.mode-btn-image {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 10px;
}

.mode-btn:active {
  transform: scale(0.98);
  filter: brightness(0.92);
}

.bottom-links {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: auto;
  padding-top: 8px;
}

.link-btn {
  font-size: 12px;
  color: #c8d5e8;
  background: rgba(255, 255, 255, 0.08);
  padding: 7px 13px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  white-space: nowrap;
  transition: background 0.08s ease, transform 0.08s ease;
}

.link-btn:active {
  background: rgba(255, 255, 255, 0.16);
  transform: scale(0.97);
}
