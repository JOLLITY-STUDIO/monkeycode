.about-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  min-height: 100vh;
  padding: 12px 14px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

.scene-bar {
  width: 100%;
  padding: 12px 14px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(182, 108, 229, 0.45);
  border-radius: 10px;
  margin-bottom: 10px;
  box-shadow: 0 2px 10px rgba(182, 108, 229, 0.14);
}

.scene-bar-text {
  font-size: 14px;
  color: #6a3aa0;
  font-weight: 700;
}

.logo-block {
  width: 100%;
  height: 130px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 12px;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(182, 108, 229, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-image {
  width: 100%;
  height: 100%;
}

.license-block {
  width: 100%;
  height: 110px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 12px;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(182, 108, 229, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.license-image {
  width: 100%;
  height: 100%;
}

.about-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(182, 108, 229, 0.35);
  border-radius: 12px;
  padding: 14px;
  box-sizing: border-box;
  box-shadow: 0 3px 14px rgba(182, 108, 229, 0.12);
}

.about-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10px 0;
  border-bottom: 0.5px solid rgba(182, 108, 229, 0.16);
}

.about-row:last-child {
  border-bottom: none;
}

.about-label {
  width: 70px;
  flex-shrink: 0;
  font-size: 13px;
  color: #8f7ba6;
}

.about-value {
  flex: 1;
  font-size: 14px;
  font-weight: 600;
  color: #4a3558;
  text-align: right;
}

.about-footer {
  margin-top: 16px;
}

.about-footer-text {
  font-size: 11px;
  color: rgba(106, 58, 160, 0.65);
}
