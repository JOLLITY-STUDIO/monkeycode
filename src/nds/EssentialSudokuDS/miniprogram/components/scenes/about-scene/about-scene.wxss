.about-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  min-height: 100vh;
  padding: 12px 14px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

.scene-bar {
  width: 100%;
  padding: 12px 14px;
  box-sizing: border-box;
  background: rgba(22, 42, 66, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  margin-bottom: 10px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
}

.scene-bar-text {
  font-size: 14px;
  color: #c8d5e8;
  font-weight: 600;
}

.logo-block {
  width: 100%;
  height: 130px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 12px;
  background: rgba(22, 42, 66, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-image {
  width: 100%;
  height: 100%;
}

.license-block {
  width: 100%;
  height: 110px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 12px;
  background: rgba(22, 42, 66, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.license-image {
  width: 100%;
  height: 100%;
}

.about-card {
  width: 100%;
  background: rgba(22, 42, 66, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 14px;
  box-sizing: border-box;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
}

.about-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10px 0;
  border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
}

.about-row:last-child {
  border-bottom: none;
}

.about-label {
  width: 70px;
  flex-shrink: 0;
  font-size: 13px;
  color: #9fb6d3;
}

.about-value {
  flex: 1;
  font-size: 14px;
  font-weight: 600;
  color: #e9eef3;
  text-align: right;
}

.about-footer {
  margin-top: 16px;
}

.about-footer-text {
  font-size: 11px;
  color: rgba(159, 182, 211, 0.55);
}
