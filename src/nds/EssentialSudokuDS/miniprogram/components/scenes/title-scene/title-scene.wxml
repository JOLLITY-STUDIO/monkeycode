<!--components/scenes/title-scene/title-scene.wxml — 启动标题场景
  V0.42 极简封面 (贴合 DS 原版封面视觉):
  - .cover-bg 深色底 (黑蓝渐变)
  - .bg-num-layer 满屏散落大数字 1-9 (半透明, 微旋转, 数字背景)
  - .board-center 中央一个 9×9 数独网格 (3×3 宫粗线, 格内填数字,
    9 宫各一个 6 色方块格 → "3×3 里嵌 3×3 + 彩色数字方块" 观感)
  - .press-start 底部 Press START 脉冲按钮
  - .copyright 版权两行
  全屏点击 → onTapStart → triggerEvent('start')
-->
<view class="title-page" bindtap="onTapStart">

  <!-- 背景: 深色底 + 中央微光 -->
  <view class="cover-bg"></view>
  <view class="cover-glow"></view>

  <!-- 背景数字层 (满屏散落, 淡淡的) -->
  <view class="bg-num-layer">
    <text
      wx:for="{{bgNums}}"
      wx:key="i"
      class="bg-num"
      style="left: {{item.x}}%; top: {{item.y}}%; font-size: {{item.size}}px; opacity: {{item.o}}; color: {{item.c}}; transform: rotate({{item.rot}}deg);"
    >{{item.n}}</text>
  </view>

  <!-- 中央: 9×9 数独网格 (3×3 宫) -->
  <view class="board-center">
    <view class="board">
      <view
        wx:for="{{sudokuCells}}"
        wx:key="i"
        class="cell"
        style="{{item.pop ? 'background: ' + item.cc + ';' : ''}}"
      >
        <text class="cell-n {{item.pop ? 'cell-n-pop' : ''}}">{{item.n}}</text>
      </view>
    </view>
  </view>

  <!-- 底部: Press START + 版权 -->
  <view class="bottom-area">
    <view class="press-start {{pulse ? 'pulse' : ''}}">
      <text class="press-start-text">Press START</text>
    </view>
    <view class="copyright">
      <text class="copyright-text">© 2006 DIGITALWARE.</text>
      <text class="copyright-text">© 2006 D3 Publisher. All Rights Reserved.</text>
    </view>
  </view>
</view>
