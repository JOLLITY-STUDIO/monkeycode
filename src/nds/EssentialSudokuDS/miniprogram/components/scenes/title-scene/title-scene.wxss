.title-page {
  /* absolute 铺满最近定位祖先 (.scene-stage, absolute inset:0),
     不依赖组件宿主节点高度 (宿主在非 flex 容器内高度 auto, height:100% 会失效) */
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0d1b2a;
  overflow: hidden;
  box-sizing: border-box;
}

.title-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* 透明点击捕获层: 位于 image 之上 (普通 view 事件冒泡可靠) */
.tap-catcher {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.tap-hint-wrap {
  position: absolute;
  bottom: 72px;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 2;
}

.tap-hint {
  padding: 10px 32px;
  border-radius: 22px;
  background: rgba(13, 27, 42, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(2px);
}

.tap-hint-text {
  font-size: 16px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 3px;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.55);
}

.pulse {
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.55; transform: scale(0.96); }
}

.copyright {
  position: absolute;
  bottom: 24px;
  left: 0;
  width: 100%;
  text-align: center;
  z-index: 2;
}

.copyright-text {
  font-size: 10px;
  color: rgba(200, 213, 232, 0.45);
}
