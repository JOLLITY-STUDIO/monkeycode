.title-page {
  position: relative;
  width: 100vw;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0d1b2a;
  overflow: hidden;
  box-sizing: border-box;
  overflow-y: auto;
}

.title-bg {
  width: 76%;
  height: auto;
  max-height: 48vh;
}

.tap-hint {
  margin-top: 18px;
  padding: 8px 28px;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.08);
}

.tap-hint-text {
  font-size: 16px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 3px;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
}

.pulse {
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.55; transform: scale(0.96); }
}

.copyright {
  position: absolute;
  bottom: 24px;
  left: 0;
  width: 100%;
  text-align: center;
}

.copyright-text {
  font-size: 10px;
  color: rgba(255, 255, 255, 0.45);
}
