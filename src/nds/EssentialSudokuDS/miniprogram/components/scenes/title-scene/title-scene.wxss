/* components/scenes/title-scene/title-scene.wxss
   V0.37 纯 WXML/CSS 封面 (替代 V0.36 Canvas 自绘, 因 Skyline 开发者工具不支持
   canvas type="2d" 调试):
   - .cover-bg      暗夜书桌主渐变 (蓝紫 → 暖琥珀 → 暗木)
   - .cover-glow    台灯柔光晕 (中央偏上)
   - .cover-glow-2  暖光底部反光
   - .cover-header  标题 + 装饰线 + 副标题 + 英文
   - .cover-previews 双预览 (数独 + 图画谜题), 中间金色细线分隔
   - .preview-grid  9×9 / 6×6 矩阵 (flex 网格)
   - .scell/.pcell  单格样式 (填充/给定/空)
   - .cover-motto   一格一思
   - .tap-hint      点击开始 (脉冲)
   - .copyright     版权
   全项目禁用 rpx, 一律 px。
*/

.title-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  background: transparent;
  overflow: hidden;
  box-sizing: border-box;
}

/* ===========================================================
 * 1. 暗夜书桌底色 + 双柔光晕 (替代 Canvas 渐变)
 * =========================================================== */
.cover-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg,
    #1a2148 0%,
    #2a2654 28%,
    #3a2e44 50%,
    #4a342a 72%,
    #2c1d14 100%);
  z-index: 0;
}

.cover-glow {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(ellipse 70% 55% at 50% 30%,
    rgba(255, 213, 138, 0.55) 0%,
    rgba(255, 200, 120, 0.28) 35%,
    rgba(255, 180, 100, 0.08) 65%,
    transparent 80%);
  z-index: 1;
}

.cover-glow-2 {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(ellipse 65% 35% at 30% 95%,
    rgba(255, 180, 120, 0.32) 0%,
    rgba(255, 180, 120, 0) 65%);
  z-index: 1;
}

/* ===========================================================
 * 2. 标题区
 * =========================================================== */
.cover-header {
  position: absolute;
  top: 48px;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  z-index: 3;
}

.cover-title {
  font-size: 22px;
  font-weight: 800;
  color: #f5d27a;
  letter-spacing: 4px;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.55);
}

.cover-divider {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
}

.cover-divider-line {
  width: 60px;
  height: 1px;
  background: linear-gradient(90deg, rgba(245, 210, 122, 0) 0%, rgba(245, 210, 122, 0.7) 50%, rgba(245, 210, 122, 0) 100%);
}

.cover-divider-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #f5d27a;
  box-shadow: 0 0 8px rgba(245, 210, 122, 0.55);
}

.cover-subtitle {
  font-size: 16px;
  font-weight: 700;
  color: #f5e4c2;
  letter-spacing: 8px;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  padding-left: 8px;
}

.cover-en {
  font-size: 11px;
  font-weight: 500;
  color: rgba(220, 200, 170, 0.7);
  letter-spacing: 3px;
}

/* ===========================================================
 * 3. 中央双预览区
 * =========================================================== */
.cover-previews {
  position: absolute;
  top: 200px;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 16px;
  z-index: 3;
  padding: 0 24px;
  box-sizing: border-box;
}

.preview-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto;
}

.preview-grid {
  background: rgba(20, 24, 44, 0.7);
  border: 2px solid #f5d27a;
  border-radius: 8px;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4),
    inset 0 0 0 1px rgba(255, 255, 255, 0.05);
}

/* ---- 9×9 数独 ---- */
.sudoku-grid {
  width: 144px;
  height: 144px;
  display: flex;
  flex-wrap: wrap;
  border-color: #f5d27a;
}

.scell {
  width: 16px;
  height: 16px;
  box-sizing: border-box;
  border-right: 1px solid rgba(245, 210, 122, 0.3);
  border-bottom: 1px solid rgba(245, 210, 122, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 去掉最右/最下边框 (grid 自身已包边) */
.scell:nth-child(9n) { border-right: none; }
.scell:nth-child(n+73) { border-bottom: none; }

/* 3×3 粗分割线 */
.scell:nth-child(3n):not(:nth-child(9n)) { border-right-color: #f5d27a; border-right-width: 1.5px; }
.scell:nth-child(n+19):nth-child(-n+27) { border-bottom-color: #f5d27a; border-bottom-width: 1.5px; }
.scell:nth-child(n+46):nth-child(-n+54) { border-bottom-color: #f5d27a; border-bottom-width: 1.5px; }

.scell-filled {
  background: var(--cc, #f5d27a);
  opacity: 0.4;
}

.scell-given {
  background: rgba(245, 210, 122, 0.06);
}

.scell-empty {
  background: transparent;
}

.scell-n {
  font-size: 10px;
  font-weight: 700;
  color: #f5d27a;
  font-family: monospace;
  line-height: 1;
}

/* ---- 6×6 图画谜题 ---- */
.picture-grid {
  width: 144px;
  height: 144px;
  display: flex;
  flex-wrap: wrap;
  border-color: #7fc8ff;
}

.pcell {
  width: 24px;
  height: 24px;
  box-sizing: border-box;
  border-right: 1px solid rgba(127, 200, 255, 0.3);
  border-bottom: 1px solid rgba(127, 200, 255, 0.3);
}

.pcell:nth-child(6n) { border-right: none; }
.pcell:nth-child(n+31) { border-bottom: none; }

.pcell:nth-child(3n):not(:nth-child(6n)) { border-right-color: #7fc8ff; border-right-width: 1.5px; }
.pcell:nth-child(n+13):nth-child(-n+18) { border-bottom-color: #7fc8ff; border-bottom-width: 1.5px; }

.pcell-on {
  background: linear-gradient(180deg, #a8dcff 0%, #5ea3e8 100%);
  box-shadow: inset 0 0 4px rgba(255, 255, 255, 0.4);
}

.pcell-off {
  background: rgba(127, 200, 255, 0.04);
}

/* ---- 中间分隔线 ---- */
.preview-divider {
  width: 1px;
  height: 144px;
  background: linear-gradient(180deg,
    rgba(245, 210, 122, 0) 0%,
    rgba(245, 210, 122, 0.5) 50%,
    rgba(245, 210, 122, 0) 100%);
  margin-top: 6px;
}

.preview-label {
  font-size: 14px;
  font-weight: 700;
  color: #f5e4c2;
  margin-top: 12px;
  letter-spacing: 2px;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
}

.preview-meta {
  font-size: 10px;
  font-weight: 500;
  color: rgba(220, 200, 170, 0.7);
  margin-top: 2px;
  letter-spacing: 1px;
}

/* ===========================================================
 * 4. 宣言 + 底部提示 + 版权
 * =========================================================== */
.cover-motto {
  position: absolute;
  bottom: 140px;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 13px;
  font-weight: 500;
  color: rgba(245, 220, 180, 0.65);
  letter-spacing: 4px;
  z-index: 3;
}

.tap-hint-wrap {
  position: absolute;
  bottom: 72px;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 4;
}

.tap-hint {
  padding: 10px 32px;
  border-radius: 22px;
  background: rgba(245, 210, 122, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.tap-hint-text {
  font-size: 16px;
  font-weight: 800;
  color: #2a1d0c;
  letter-spacing: 4px;
  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.4);
}

.pulse {
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(0.96); }
}

.copyright {
  position: absolute;
  bottom: 24px;
  left: 0;
  width: 100%;
  text-align: center;
  z-index: 4;
}

.copyright-text {
  font-size: 10px;
  color: rgba(200, 213, 232, 0.45);
}