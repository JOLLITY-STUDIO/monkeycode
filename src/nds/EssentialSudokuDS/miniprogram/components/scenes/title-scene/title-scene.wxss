/* components/scenes/title-scene/title-scene.wxss
  V0.48 封面内容全删 (视觉背景交给全局 bg-fx 糖果动态背景):
  - .title-page     全屏透明容器 (column 布局: 品牌顶部 + press 中部 + 版权底部)
  - .brand-en       顶部品牌标题 (糖果渐变文字 + 白描边, 浅背景可读)
  - .press-start    Press START 糖果粉橙渐变胶囊 + 脉冲 (中部偏下, 替代原封面框位置)
  - .copyright      版权两行 (灰蓝, 浅背景可读)
  (V0.48 移除: .board-center/.board/.cell 等中央 9×9 封面框全部样式)
  全项目禁用 rpx, 一律 px。
*/

.title-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  background: transparent; /* 关键: 透出 bg-fx */
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===========================================================
 * 顶部品牌标题
 * =========================================================== */
.brand-wrap {
  position: relative;
  flex: 0 0 auto;
  width: 100%;
  padding-top: 42px;
  display: flex;
  justify-content: center;
  z-index: 3;
}

.brand-en {
  font-size: 30px;
  font-weight: 900;
  letter-spacing: 2px;
  font-family: 'Trebuchet MS', 'Arial Rounded MT Bold', Arial, sans-serif;
  background: linear-gradient(180deg, #ff6b81 0%, #ff9f43 55%, #ffd93d 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 2px 0 rgba(255, 255, 255, 0.55);
  line-height: 1.2;
}

/* ===========================================================
 * Press START
 * =========================================================== */
.press-area {
  position: relative;
  flex: 1 1 auto; /* V0.48: 占满中部留白区, 内部垂直居中 */
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding-bottom: 4px;
  z-index: 4;
}

.press-start {
  padding: 11px 40px;
  border-radius: 26px;
  background: linear-gradient(180deg, #ff6b81 0%, #ff4f6e 60%, #e83c5c 100%);
  border: 1.5px solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 6px 18px rgba(232, 60, 92, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.press-start-text {
  font-size: 15px;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 3px;
  font-family: 'Trebuchet MS', 'Arial Rounded MT Bold', Arial, sans-serif;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
}

.hint-line {
  font-size: 10px;
  font-weight: 600;
  color: rgba(90, 70, 120, 0.6);
  letter-spacing: 2px;
}

.pulse {
  animation: pulse 1.7s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.82; transform: scale(0.97); }
}

/* ===========================================================
 * 版权
 * =========================================================== */
.copyright {
  position: relative;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding-bottom: 14px;
  z-index: 4;
}

.copyright-text {
  font-size: 9px;
  color: rgba(70, 55, 100, 0.55);
  letter-spacing: 0.5px;
}
