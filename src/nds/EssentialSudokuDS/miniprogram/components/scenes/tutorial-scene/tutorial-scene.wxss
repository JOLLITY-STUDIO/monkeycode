.tutorial-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  min-height: 100vh;
  padding: 12px 14px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

.scene-bar {
  width: 100%;
  padding: 12px 14px;
  box-sizing: border-box;
  background: rgba(22, 42, 66, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  margin-bottom: 14px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
}

.scene-bar-text {
  font-size: 14px;
  color: #c8d5e8;
  font-weight: 700;
}

.tut-frame {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6px;
  box-sizing: border-box;
}

.tut-screen {
  width: 100%;
  max-width: 480px;
  aspect-ratio: 256 / 192;
  background: #0d1b2a;
  border-radius: 12px;
  border: 2px solid #1c2c44;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tut-image {
  width: 100%;
  height: 100%;
  image-rendering: pixelated;
}

.tut-cap {
  margin-top: 10px;
  font-size: 12px;
  color: #9fb6d3;
  text-align: center;
}