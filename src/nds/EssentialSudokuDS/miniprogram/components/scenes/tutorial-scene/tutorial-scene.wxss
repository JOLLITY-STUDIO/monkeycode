.tutorial-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  min-height: 100vh;
  padding: 12px 14px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

.scene-bar {
  width: 100%;
  padding: 12px 14px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(182, 108, 229, 0.45);
  border-radius: 10px;
  margin-bottom: 10px;
  box-shadow: 0 2px 10px rgba(182, 108, 229, 0.14);
}

.scene-bar-text {
  font-size: 14px;
  color: #6a3aa0;
  font-weight: 700;
}

.tut-banner {
  width: 100%;
  height: 130px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 12px;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(182, 108, 229, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tut-banner-image {
  width: 100%;
  height: 100%;
}

.tut-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(182, 108, 229, 0.35);
  border-radius: 12px;
  padding: 14px;
  box-sizing: border-box;
  box-shadow: 0 3px 14px rgba(182, 108, 229, 0.12);
}

.tut-section {
  margin-bottom: 4px;
}

.tut-title {
  font-size: 16px;
  font-weight: 800;
  color: #7a3fb0;
  margin-bottom: 6px;
}

.tut-text {
  font-size: 13px;
  line-height: 1.7;
  color: #4a3558;
  margin-bottom: 5px;
  white-space: pre-line;
}

.tut-divider {
  height: 0.5px;
  background: rgba(182, 108, 229, 0.18);
  margin: 10px 0;
}
