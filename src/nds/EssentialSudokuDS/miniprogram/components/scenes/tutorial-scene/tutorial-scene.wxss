.tutorial-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  min-height: 100vh;
  padding: 12px 14px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #0d1b2a;
}

.scene-bar {
  width: 100%;
  padding: 12px 14px;
  box-sizing: border-box;
  background: rgba(22, 42, 66, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  margin-bottom: 10px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
}

.scene-bar-text {
  font-size: 14px;
  color: #c8d5e8;
  font-weight: 600;
}

.tut-banner {
  width: 100%;
  height: 130px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 12px;
  background: rgba(22, 42, 66, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tut-banner-image {
  width: 100%;
  height: 100%;
}

.tut-card {
  width: 100%;
  background: rgba(22, 42, 66, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 14px;
  box-sizing: border-box;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
}

.tut-section {
  margin-bottom: 4px;
}

.tut-title {
  font-size: 16px;
  font-weight: 700;
  color: #4db8ff;
  margin-bottom: 6px;
}

.tut-text {
  font-size: 13px;
  line-height: 1.7;
  color: #c8d5e8;
  margin-bottom: 5px;
  white-space: pre-line;
}

.tut-divider {
  height: 0.5px;
  background: rgba(255, 255, 255, 0.08);
  margin: 10px 0;
}
