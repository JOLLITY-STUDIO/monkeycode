<view class="picture-page">
  <!-- 返回条 -->
  <view class="scene-bar" bindtap="onBack">
    <text class="scene-bar-text">← 返回主菜单</text>
  </view>

  <!-- 顶部图画谜题 banner: 原 DS numclo_00.nbm -->
  <view class="picture-banner">
    <image class="picture-banner-image" src="/assets/nbm/numclo_00.nbm.png" mode="aspectFit" lazy-load></image>
  </view>

  <!-- 顶部: 谜题名 + 通关标记 + 序号 + 计时 -->
  <view class="game-header">
    <view class="header-left">
      <text class="puzzle-name">{{puzzleName}}</text>
      <text wx:if="{{completed}}" class="done-badge">✓ 已通关</text>
      <text class="stat">#{{puzzleIndex + 1}}/{{puzzleCount}}</text>
    </view>
    <text class="timer">{{timerText}}</text>
  </view>

  <!-- 类别 chips (横向滚动) -->
  <scroll-view scroll-x class="cat-scroll" enhanced show-scrollbar="{{false}}">
    <view class="cat-row">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="cat-chip {{currentFile === item.key ? 'cat-chip-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTapCategory"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 谜题导航: 上一题 / 随机 / 下一题 / 跳转 -->
  <view class="nav-row">
    <view class="nav-key" bindtap="onPrev">上一题</view>
    <view class="nav-key nav-key-random" bindtap="onRandom">随机</view>
    <view class="nav-key" bindtap="onNext">下一题</view>
    <view class="nav-key" bindtap="onJumpTo">跳转</view>
  </view>

  <!-- 15x15 彩色网格 + 行列提示 (ナンクロ / Number Cross 每色计数) -->
  <view class="puzzle-area">
    <view class="clue-header">
      <view class="clue-corner"></view>
      <view wx:for="{{colClues}}" wx:key="index" class="col-clue">
        <view
          wx:for="{{item}}"
          wx:key="key"
          wx:for-item="band"
          class="clue-band clue-band-col"
          style="background: {{clueColor(band.color)}};"
        >{{band.count || ''}}</view>
      </view>
    </view>
    <view class="puzzle-body">
      <view class="row-clues">
        <view wx:for="{{rowClues}}" wx:key="index" class="row-clue">
          <view
            wx:for="{{item}}"
            wx:key="key"
            wx:for-item="band"
            class="clue-band clue-band-row"
            style="background: {{clueColor(band.color)}};"
          >{{band.count || ''}}</view>
        </view>
      </view>
      <view class="paint-grid {{showingAnswer ? 'paint-grid-reveal' : ''}}">
        <view
          wx:for="{{cells}}"
          wx:key="i"
          class="paint-cell"
          style="background: {{item.bg}}; border-color: {{item.border}};"
          data-i="{{item.i}}"
          bindtap="onTapCell"
        ></view>
      </view>
    </view>
  </view>

  <!-- 教程模式提示图 (numclo_tu.data) -->
  <view wx:if="{{currentFile === 'numclo_tu.data' && !tutorialClosed}}" class="tutorial-bar">
    <image class="tutorial-image" src="/assets/nbm/tutorial_00.nbm.png" mode="aspectFit" lazy-load></image>
    <view class="tutorial-close" bindtap="onCloseTutorial">×</view>
  </view>

  <!-- 正确进度 -->
  <view class="progress-row">
    <text class="progress-text">已正确 {{correctCount}} / {{cells.length}}</text>
  </view>

  <!-- 调色板 (0=擦除 + 5 画笔色; 使用原 DS numclo_00.nbm 按钮切片) -->
  <view class="palette">
    <view
      wx:for="{{palette}}"
      wx:key="id"
      class="palette-item {{selectedColor === item.id ? 'palette-item-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTapPalette"
    >
      <view class="palette-key" style="background-image: url({{item.imageUrl}});"></view>
      <text wx:if="{{item.id > 0}}" class="palette-need {{paletteNeed[item.id] === 0 ? 'palette-need-zero' : ''}}">{{paletteNeed[item.id]}}</text>
    </view>
  </view>

  <!-- 工具: 显示答案 / 撤销 / 清空画板 -->
  <view class="tool-row">
    <view class="tool-key" bindtap="onToggleAnswer">{{showingAnswer ? '隐藏答案' : '显示答案'}}</view>
    <view class="tool-key" bindtap="onUndo">撤销</view>
    <view class="tool-key tool-key-primary" bindtap="onClearAll">清空画板</view>
  </view>

  <!-- 完成提示条 -->
  <view wx:if="{{complete}}" class="complete-banner">✓ 完成! 点击"下一题"继续</view>

  <!-- 通关庆祝动画 (纯装饰遮罩, 不拦截触摸) -->
  <view wx:if="{{celebrate}}" class="celebrate-mask">
    <view class="celebrate-confetti celebrate-confetti-1"></view>
    <view class="celebrate-confetti celebrate-confetti-2"></view>
    <view class="celebrate-confetti celebrate-confetti-3"></view>
    <view class="celebrate-confetti celebrate-confetti-4"></view>
    <view class="celebrate-confetti celebrate-confetti-5"></view>
    <view class="celebrate-confetti celebrate-confetti-6"></view>
    <view class="celebrate-panel">
      <view class="celebrate-check">✓</view>
      <view class="celebrate-title">通关成功!</view>
      <view class="celebrate-sub">{{puzzleName}} · {{timerText}} · {{moves}} 步</view>
    </view>
  </view>
</view>
