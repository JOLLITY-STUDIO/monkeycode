<view class="picture-page">
  <!-- 返回条 -->
  <view class="scene-bar" bindtap="onBack">
    <text class="scene-bar-text">← 返回主菜单</text>
  </view>

  <!-- 顶部图画谜题 banner: 原 DS numclo_00.nbm -->
  <view class="picture-banner">
    <image class="picture-banner-image" src="/assets/nbm/numclo_00.nbm.png" mode="aspectFit" lazy-load></image>
  </view>

  <!-- 顶部: 谜题名 + 序号 + 计时 -->
  <view class="game-header">
    <view class="header-left">
      <text class="puzzle-name">{{puzzleName}}</text>
      <text class="stat">#{{puzzleIndex + 1}}/{{puzzleCount}}</text>
    </view>
    <text class="timer">{{timerText}}</text>
  </view>

  <!-- 类别 chips (横向滚动) -->
  <scroll-view scroll-x class="cat-scroll" enhanced show-scrollbar="{{false}}">
    <view class="cat-row">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="cat-chip {{currentFile === item.key ? 'cat-chip-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTapCategory"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 谜题导航: 上一题 / 随机 / 下一题 -->
  <view class="nav-row">
    <view class="nav-key" bindtap="onPrev">上一题</view>
    <view class="nav-key nav-key-random" bindtap="onRandom">随机</view>
    <view class="nav-key" bindtap="onNext">下一题</view>
  </view>

  <!-- 15x15 彩色网格 + 行列提示 (ナンクロ / Number Cross 每色计数) -->
  <view class="puzzle-area">
    <view class="clue-header">
      <view class="clue-corner"></view>
      <view wx:for="{{colClues}}" wx:key="index" class="col-clue">
        <view
          wx:for="{{item}}"
          wx:key="key"
          wx:for-item="band"
          class="clue-band clue-band-col"
          style="background: {{clueColor(band.color)}};"
        >{{band.count || ''}}</view>
      </view>
    </view>
    <view class="puzzle-body">
      <view class="row-clues">
        <view wx:for="{{rowClues}}" wx:key="index" class="row-clue">
          <view
            wx:for="{{item}}"
            wx:key="key"
            wx:for-item="band"
            class="clue-band clue-band-row"
            style="background: {{clueColor(band.color)}};"
          >{{band.count || ''}}</view>
        </view>
      </view>
      <view class="paint-grid {{showingAnswer ? 'paint-grid-reveal' : ''}}">
        <image class="waku-bg" src="/assets/nbm/numclo_waku.nbm.png" mode="aspectFill" lazy-load></image>
        <view
          wx:for="{{cells}}"
          wx:key="i"
          class="paint-cell"
          style="background: {{item.bg}}; border-color: {{item.border}};"
          data-i="{{item.i}}"
          bindtap="onTapCell"
        ></view>
      </view>
    </view>
  </view>

  <!-- 正确进度 -->
  <view class="progress-row">
    <text class="progress-text">已正确 {{correctCount}} / {{cells.length}}</text>
  </view>

  <!-- 调色板 (0=擦除 + 5 画笔色) -->
  <view class="palette">
    <view
      wx:for="{{palette}}"
      wx:key="id"
      class="palette-key {{selectedColor === item.id ? 'palette-key-active' : ''}}"
      style="background: {{item.color}}; border-color: {{item.border}};"
      data-id="{{item.id}}"
      bindtap="onTapPalette"
    ><text wx:if="{{item.id === 0}}" class="erase-mark">✕</text></view>
  </view>

  <!-- 工具: 显示答案 / 清空画板 -->
  <view class="tool-row">
    <view class="tool-key" bindtap="onToggleAnswer">{{showingAnswer ? '隐藏答案' : '显示答案'}}</view>
    <view class="tool-key tool-key-primary" bindtap="onClearAll">清空画板</view>
  </view>

  <!-- 完成提示条 -->
  <view wx:if="{{complete}}" class="complete-banner">✓ 完成! 点击"下一题"继续</view>
</view>
