<view class="picture-page">
  <!-- 顶部返回条 -->
  <view class="scene-bar" bindtap="onBack">
    <text class="scene-bar-text">← 返回</text>
  </view>

  <!-- 顶部: 谜题名 + 通关标记 + 序号 + 计时 -->
  <view class="game-header">
    <view class="header-left">
      <text class="puzzle-name">{{puzzleName}}</text>
      <text wx:if="{{completed}}" class="done-badge">✓ 已通关</text>
      <text class="stat">#{{puzzleIndex + 1}}/{{puzzleCount}}</text>
    </view>
    <text class="timer">{{timerText}}</text>
  </view>

  <!-- 类别 chips (横向滚动) -->
  <scroll-view scroll-x class="cat-scroll" enhanced show-scrollbar="{{false}}">
    <view class="cat-row">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="cat-chip {{currentFile === item.key ? 'cat-chip-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTapCategory"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 谜题导航: 上一题 / 随机 / 下一题 / 跳转 (DS 深色胶囊) -->
  <view class="nav-row">
    <view class="nav-key" bindtap="onPrev">上一题</view>
    <view class="nav-key nav-key-accent" bindtap="onRandom">随机</view>
    <view class="nav-key" bindtap="onNext">下一题</view>
    <view class="nav-key" bindtap="onJumpTo">跳转</view>
  </view>

  <!-- 15x15 彩色网格 + 行列提示 (ナンクロ / Number Cross 每色计数) -->
  <view class="puzzle-area">
    <view class="clue-header">
      <view class="clue-corner"></view>
      <view wx:for="{{colClues}}" wx:key="index" class="col-clue">
        <view
          wx:for="{{item}}"
          wx:key="key"
          wx:for-item="band"
          class="clue-band clue-band-col"
          style="background: {{clueColor(band.color)}};"
        >{{band.count || ''}}</view>
      </view>
    </view>
    <view class="puzzle-body">
      <view class="row-clues">
        <view wx:for="{{rowClues}}" wx:key="index" class="row-clue">
          <view
            wx:for="{{item}}"
            wx:key="key"
            wx:for-item="band"
            class="clue-band clue-band-row"
            style="background: {{clueColor(band.color)}};"
          >{{band.count || ''}}</view>
        </view>
      </view>
      <view class="paint-grid {{showingAnswer ? 'paint-grid-reveal' : ''}}">
        <view
          wx:for="{{cells}}"
          wx:key="i"
          class="paint-cell"
          style="background: {{item.bg}}; border-color: {{item.border}};"
          data-i="{{item.i}}"
          bindtap="onTapCell"
        ></view>
      </view>
    </view>
  </view>

  <!-- 教程类别 (numclo_tu.data): 打开玩法图文教程 -->
  <view wx:if="{{currentFile === 'numclo_tu.data'}}" class="tutorial-strip">
    <view class="ds-btn tutorial-open" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onOpenTutorial">
      📖 玩法图文教程
      <view wx:if="{{!tutSeen}}" class="tutorial-dot"></view>
    </view>
    <text class="tutorial-hint">第一次玩？先花 1 分钟学会看行列提示</text>
  </view>

  <!-- 正确进度 -->
  <view class="progress-row">
    <text class="progress-text">已正确 {{correctCount}} / {{cells.length}}</text>
  </view>

  <!-- 调色板 (0=擦除 CSS 斜线 + 5 画笔色 CSS 色块, 选中态蓝框) -->
  <view class="palette">
    <view
      wx:for="{{palette}}"
      wx:key="id"
      class="palette-item {{selectedColor === item.id ? 'palette-item-active' : ''}}"
      hover-class="palette-item-hover"
      hover-stay-time="80"
      data-id="{{item.id}}"
      bindtap="onTapPalette"
    >
      <view
        class="palette-key {{item.id === 0 ? 'palette-key-erase' : ''}}"
        style="background-color: {{item.color}}; border-color: {{item.border}};"
      ></view>
      <text wx:if="{{item.id === 0}}" class="palette-tool-label">擦除</text>
      <text wx:else class="palette-need {{paletteNeed[item.id] === 0 ? 'palette-need-zero' : ''}}">{{paletteNeed[item.id]}}</text>
    </view>
  </view>

  <!-- 工具: 显示答案 / 撤销 / 重做 / 清空画板 (统一 ds-btn 双态) -->
  <view class="tool-row">
    <view class="ds-btn tool-key" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onToggleAnswer">{{showingAnswer ? '隐藏答案' : '显示答案'}}</view>
    <view class="ds-btn tool-key" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onUndo">撤销</view>
    <view class="ds-btn tool-key" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onRedo">重做</view>
    <view class="ds-btn tool-key tool-key-danger" hover-class="ds-btn-hover" hover-stay-time="80" bindtap="onClearAll">清空</view>
  </view>

  <!-- 完成提示条 -->
  <view wx:if="{{complete}}" class="complete-banner">✓ 完成! 点击"下一题"继续</view>

  <!-- 通关庆祝动画 (纯装饰遮罩, 不拦截触摸) -->
  <view wx:if="{{celebrate}}" class="celebrate-mask">
    <view class="celebrate-confetti celebrate-confetti-1"></view>
    <view class="celebrate-confetti celebrate-confetti-2"></view>
    <view class="celebrate-confetti celebrate-confetti-3"></view>
    <view class="celebrate-confetti celebrate-confetti-4"></view>
    <view class="celebrate-confetti celebrate-confetti-5"></view>
    <view class="celebrate-confetti celebrate-confetti-6"></view>
    <view class="celebrate-panel">
      <view class="celebrate-check">✓</view>
      <view class="celebrate-title">通关成功!</view>
      <view class="celebrate-sub">{{puzzleName}} · {{timerText}} · {{moves}} 步</view>
    </view>
  </view>

  <!-- 图文教程弹层 (A): 5 页纯 CSS 自绘教学, 每页示意图 + 要点 -->
  <view wx:if="{{tutOpen}}" class="tut-mask">
    <view class="tut-card">
      <view class="tut-header">
        <text class="tut-header-title">📖 玩法图文教程</text>
        <text class="tut-page-count">{{tutPage + 1}} / {{tutSteps.length}}</text>
        <view class="tut-close" bindtap="onCloseTutorial">×</view>
      </view>

      <scroll-view scroll-y class="tut-body">
        <!-- 页 1: 认识界面 -->
        <block wx:if="{{tutPage === 0}}">
          <view class="tut-demo tut-demo-layout">
            <view class="demo-top-clues">
              <view class="demo-col"><view class="demo-c dot-r">2</view><view class="demo-c dot-y">1</view></view>
              <view class="demo-col"><view class="demo-c dot-r">3</view></view>
              <view class="demo-col"><view class="demo-c dot-y">2</view></view>
            </view>
            <view class="demo-middle">
              <view class="demo-row-clues">
                <view class="demo-c dot-r">3</view>
                <view class="demo-c dot-y">2</view>
              </view>
              <view class="demo-mini-grid">
                <view class="demo-g demo-g-fill-r"></view>
                <view class="demo-g demo-g-fill-r"></view>
                <view class="demo-g demo-g-fill-r"></view>
                <view class="demo-g demo-g-fill-y"></view>
                <view class="demo-g demo-g-fill-y"></view>
                <view class="demo-g"></view>
                <view class="demo-g demo-g-fill-b"></view>
                <view class="demo-g demo-g-fill-b"></view>
                <view class="demo-g"></view>
              </view>
            </view>
          </view>
          <view class="tut-title">1 · 认识对局界面</view>
          <view class="tut-point">• 中间是 15×15 画板：把每一格涂上正确的颜色</view>
          <view class="tut-point">• <text class="dot dot-r"></text> 顶部色条 = 每一列各颜色格数</view>
          <view class="tut-point">• <text class="dot dot-y"></text> 左侧色条 = 每一行各颜色格数</view>
          <view class="tut-point">• 色条数字会告诉你怎么涂，不需要猜</view>
        </block>

        <!-- 页 2: 行列提示读法 -->
        <block wx:if="{{tutPage === 1}}">
          <view class="tut-demo tut-demo-layout">
            <view class="demo-top-clues">
              <view class="demo-col"><view class="demo-c dot-r">3</view><view class="demo-c dot-b">2</view></view>
              <view class="demo-col"><view class="demo-c dot-y">1</view><view class="demo-c dot-b">2</view></view>
            </view>
            <view class="demo-middle">
              <view class="demo-row-clues">
                <view class="demo-c dot-r">2</view>
                <view class="demo-c dot-b">3</view>
              </view>
              <view class="demo-mini-grid">
                <view class="demo-g demo-g-fill-r"></view>
                <view class="demo-g demo-g-fill-r"></view>
                <view class="demo-g demo-g-fill-b"></view>
                <view class="demo-g demo-g-fill-b"></view>
                <view class="demo-g demo-g-fill-b"></view>
                <view class="demo-g demo-g-fill-y"></view>
                <view class="demo-g demo-g-fill-b"></view>
                <view class="demo-g demo-g-fill-r"></view>
                <view class="demo-g"></view>
              </view>
            </view>
          </view>
          <view class="tut-title">2 · 提示怎么读</view>
          <view class="tut-point">• <text class="dot dot-r"></text>红块 3 + <text class="dot dot-y"></text>黄块 2 → 这一行有 3 个红色格、2 个黄色格</view>
          <view class="tut-point">• 提示只按「颜色」计数，不看位置</view>
          <view class="tut-point">• 某色数字 = 0 时不会显示，这行/列就没有该颜色</view>
          <view class="tut-point">• 上下、左右推理着涂，越来越简单</view>
        </block>

        <!-- 页 3: 选色涂色 -->
        <block wx:if="{{tutPage === 2}}">
          <view class="tut-demo tut-demo-palette">
            <view class="demo-pal-row">
              <view class="demo-key demo-key-r"></view>
              <view class="demo-key demo-key-y"></view>
              <view class="demo-key demo-key-b"></view>
              <view class="demo-key demo-key-g"></view>
              <view class="demo-key demo-key-k"></view>
              <view class="demo-erase">擦除</view>
            </view>
            <view class="demo-pal-arrow">▼ 先选颜色</view>
            <view class="demo-mini-grid demo-pal-grid">
              <view class="demo-g demo-g-fill-r demo-g-target"></view>
              <view class="demo-g"></view>
              <view class="demo-g"></view>
            </view>
            <view class="demo-pal-arrow">▲ 再点格子涂上 (手指点哪涂哪)</view>
          </view>
          <view class="tut-title">3 · 涂色操作</view>
          <view class="tut-point">• 先点下方色块「选中」颜色，再点画板格子涂色</view>
          <view class="tut-point">• 色块下的小数字 = 该颜色还剩几格要涂 (变绿 = 涂完)</view>
          <view class="tut-point">• 在已涂的格子上再点一次同一颜色 = 擦除</view>
          <view class="tut-point">• 左下「擦除」可当橡皮用 (选中后点格子擦掉)</view>
        </block>

        <!-- 页 4: 工具 -->
        <block wx:if="{{tutPage === 3}}">
          <view class="tut-demo tut-demo-tools">
            <view class="demo-tool demo-tool-plain">显示答案</view>
            <view class="demo-tool demo-tool-plain">撤销</view>
            <view class="demo-tool demo-tool-plain">重做</view>
            <view class="demo-tool demo-tool-danger">清空</view>
          </view>
          <view class="tut-demo tut-demo-tools">
            <view class="demo-key demo-key-r"></view>
            <view class="demo-key demo-key-y"></view>
            <view class="demo-key demo-key-b"></view>
            <view class="demo-key demo-key-g"></view>
            <view class="demo-key demo-key-k"></view>
            <view class="demo-erase">擦除</view>
          </view>
          <view class="tut-title">4 · 常用工具</view>
          <view class="tut-point">• <b>撤销</b>：涂错了退一步；<b>重做</b>：把撤销找回来</view>
          <view class="tut-point">• <b>清空</b>：整幅画板清掉重来 (步数也归零)</view>
          <view class="tut-point">• <b>显示答案</b>：卡住时直接看完整答案（看完可再点隐藏）</view>
          <view class="tut-point">• 看答案不会扣分，放心用</view>
        </block>

        <!-- 页 5: 通关 -->
        <block wx:if="{{tutPage === 4}}">
          <view class="tut-demo tut-demo-win">
            <view class="demo-mini-grid">
              <view class="demo-g demo-g-fill-r"></view>
              <view class="demo-g demo-g-fill-r"></view>
              <view class="demo-g demo-g-fill-r"></view>
              <view class="demo-g demo-g-fill-y"></view>
              <view class="demo-g demo-g-fill-y"></view>
              <view class="demo-g demo-g-fill-b"></view>
              <view class="demo-g demo-g-fill-b"></view>
              <view class="demo-g demo-g-fill-b"></view>
              <view class="demo-g demo-g-fill-b"></view>
            </view>
            <view class="demo-win-check">✓ 完成!</view>
            <view class="demo-win-beans">
              <view class="demo-win-bean"></view>
              <view class="demo-win-bean"></view>
              <view class="demo-win-bean"></view>
              <view class="demo-win-bean"></view>
              <view class="demo-win-bean"></view>
            </view>
          </view>
          <view class="tut-title">5 · 完成一幅画</view>
          <view class="tut-point">• 所有格子都涂对 → 自动判定通关</view>
          <view class="tut-point">• 会记录你的用时和步数，标题出现 ✓ 已通关</view>
          <view class="tut-point">• 左侧菜单的图库会同步打勾，通关越多越有成就感</view>
          <view class="tut-point">• 涂到一半退出也会自动存档，下次接着涂</view>
        </block>
      </scroll-view>

      <view class="tut-footer">
        <view wx:if="{{tutPage > 0}}" class="ds-btn tut-prev" hover-class="ds-btn-hover" bindtap="onTutPrev">上一步</view>
        <view wx:if="{{tutPage > 0}}" class="ds-btn tut-skip" hover-class="ds-btn-hover" bindtap="onTutSkip">跳过教程</view>
        <view wx:if="{{tutPage < tutSteps.length - 1}}" class="ds-btn tut-next" hover-class="ds-btn-hover" bindtap="onTutNext">下一步</view>
        <view wx:else class="ds-btn tut-next" hover-class="ds-btn-hover" bindtap="onCloseTutorial">开始涂色</view>
      </view>
    </view>
  </view>

  <!-- 首次进入引导 (B): 高亮蒙版挖洞 + 底部步骤卡, 3 步 -->
  <view wx:if="{{guideVisible}}" class="guide-mask">
    <view class="guide-dim" style="top: 0; left: 0; width: 100%; height: {{guideDimTop}}px;"></view>
    <view class="guide-dim" style="top: {{guideRectBottom}}px; left: 0; width: 100%; height: calc(100% - {{guideRectBottom}}px);"></view>
    <view class="guide-dim" style="top: {{guideRectTop}}px; left: 0; width: {{guideRectLeft}}px; height: {{guideRectH}}px;"></view>
    <view class="guide-dim" style="top: {{guideRectTop}}px; left: {{guideRectRight}}px; width: calc(100% - {{guideRectRight}}px); height: {{guideRectH}}px;"></view>
    <view class="guide-spot" style="top: {{guideRectTop}}px; left: {{guideRectLeft}}px; width: {{guideRectW}}px; height: {{guideRectH}}px;">
      <view wx:if="{{guideArrow !== 'none'}}" class="guide-arrow guide-arrow-{{guideArrowPos}}">{{guideArrow === 'up' ? '▲' : '▼'}}</view>
    </view>
    <view class="guide-card">
      <view class="guide-dots">
        <view wx:for="{{guideSteps}}" wx:key="title" class="guide-dot {{index === guideStep ? 'guide-dot-on' : ''}}"></view>
      </view>
      <view class="guide-title">{{guideSteps[guideStep].title}}</view>
      <view class="guide-desc">{{guideSteps[guideStep].desc}}</view>
      <view class="guide-actions">
        <view class="guide-skip" bindtap="onGuideSkip">跳过</view>
        <view wx:if="{{guideStep > 0}}" class="ds-btn guide-prev" hover-class="ds-btn-hover" bindtap="onGuidePrev">上一步</view>
        <view class="ds-btn guide-next" hover-class="ds-btn-hover" bindtap="onGuideNext">{{guideStep < guideSteps.length - 1 ? '下一步' : '开始涂色'}}</view>
      </view>
    </view>
  </view>
</view>
