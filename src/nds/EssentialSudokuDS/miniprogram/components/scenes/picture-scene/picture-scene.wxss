/* picture-scene.wxss — 图画谜题玩法样式 (V0.45 糖果亮底主题 + 双态文本按钮) */
@import '../../../styles/ds-buttons.wxss';

.picture-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  min-height: 100vh;
  padding: 12px 14px 20px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

.scene-bar {
  width: 100%;
  padding: 12px 14px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(182, 108, 229, 0.45);
  border-radius: 10px;
  margin-bottom: 10px;
  box-shadow: 0 2px 10px rgba(182, 108, 229, 0.14);
}

.scene-bar-text {
  font-size: 14px;
  color: #6a3aa0;
  font-weight: 700;
}

/* 顶部信息栏 */
.game-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.puzzle-name {
  font-size: 16px;
  font-weight: 800;
  color: #6a3aa0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 60%;
}

.stat {
  font-size: 12px;
  color: #8f7ba6;
  margin-left: 8px;
  white-space: nowrap;
}

.timer {
  font-size: 15px;
  font-weight: 700;
  color: #a050d0;
  margin-left: 6px;
  white-space: nowrap;
}

/* 类别横向滚动 */
.cat-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8px;
}

.cat-row {
  display: inline-flex;
  flex-direction: row;
  gap: 6px;
  padding: 1px 0;
}

.cat-chip {
  flex-shrink: 0;
  font-size: 12px;
  padding: 5px 13px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.82);
  color: #6a3aa0;
  font-weight: 700;
  border: 1px solid rgba(182, 108, 229, 0.4);
}

.cat-chip-active {
  background: linear-gradient(180deg, #cf8ff5 0%, #b66ce5 60%, #a050d0 100%);
  color: #ffffff;
  border-color: #a050d0;
}

/* 谜题导航 */
.nav-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-bottom: 10px;
}

.nav-key {
  flex: 1;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
  color: #6a3aa0;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 6px;
  border: 1px solid rgba(182, 108, 229, 0.4);
}

.nav-key-accent {
  background: linear-gradient(180deg, #cf8ff5 0%, #b66ce5 60%, #a050d0 100%);
  color: #ffffff;
  border-color: #a050d0;
}

/* 15x15 彩色网格 + ナンクロ 每色计数行列提示
   V0.25 自绘 (原 numclo_waku.nbm.png 整图背景):
   - 深色底 #0d1b2a
   - 红色 1.5px 外框 (border)
   - 5×5 块粗红线 (paint-cell :nth-child 范围选择器)
   - paint-cell 灰细格线 0.5px */
.puzzle-area {
  width: 100%;
  aspect-ratio: 1 / 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  background: #0d1b2a;
  border: 1.5px solid #d83a3a;
  border-radius: 4px;
  overflow: hidden;
  box-sizing: border-box;
}

.clue-header {
  width: 100%;
  height: 32.22%;
  display: flex;
  flex-direction: row;
}

.clue-corner {
  width: 32.22%;
  height: 100%;
  flex-shrink: 0;
}

.col-clue {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: stretch;
  box-sizing: border-box;
}

.puzzle-body {
  width: 100%;
  height: 67.78%;
  display: flex;
  flex-direction: row;
}

.row-clues {
  width: 32.22%;
  height: 100%;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

.row-clue {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: stretch;
  box-sizing: border-box;
}

.clue-band {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 9px;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  text-shadow: 0 0.5px 1px rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}

.clue-band-col {
  flex: 1;
  width: 100%;
  min-height: 0;
  border-top: 0.5px solid rgba(255, 255, 255, 0.35);
}

.clue-band-row {
  flex: 1;
  height: 100%;
  min-width: 0;
  border-left: 0.5px solid rgba(255, 255, 255, 0.35);
}

.paint-grid {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  background: transparent;
  border: none;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.paint-cell {
  width: calc(100% / 15);
  height: calc(100% / 15);
  box-sizing: border-box;
  border-top: 0.5px solid rgba(230, 235, 240, 0.35);
  border-left: 0.5px solid rgba(230, 235, 240, 0.35);
  border-right: 0.5px solid rgba(230, 235, 240, 0.35);
  border-bottom: 0.5px solid rgba(230, 235, 240, 0.35);
}

/* V0.25 5×5 块粗红线 (模拟 DS numclo_waku.nbm 视觉, 每 5 格一块边界) */
/* 第 5/10/15 列 (1-based) 红右线 */
.paint-cell:nth-child(15n+5),
.paint-cell:nth-child(15n+10),
.paint-cell:nth-child(15n) {
  border-right: 1.5px solid #d83a3a;
}
/* 第 5/10/15 行 (1-based) 红下线: 行 5=[61,75], 行 10=[136,150], 行 15=[211,225] */
.paint-grid > .paint-cell:nth-child(n+61):nth-child(-n+75),
.paint-grid > .paint-cell:nth-child(n+136):nth-child(-n+150),
.paint-grid > .paint-cell:nth-child(n+211):nth-child(-n+225) {
  border-bottom: 1.5px solid #d83a3a;
}

/* 显示答案时: 去掉格子线, 纯色块拼图效果 */
.paint-grid-reveal .paint-cell {
  border-color: transparent;
}

/* 调色板 (CSS 色块双态: 0=擦除斜线, 1-5=画笔色, 选中蓝框) */
.palette {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 8px;
  margin-top: 10px;
  justify-content: center;
}

.palette-item {
  width: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.palette-item-hover {
  opacity: 0.85;
}

.palette-key {
  width: 36px;
  height: 28px;
  border-radius: 6px;
  border: 2px solid;
  box-sizing: border-box;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

/* 擦除 = 白色块 + 红色斜线 (纯 CSS, 不再用 NBM 切片) */
.palette-key-erase {
  background-image: linear-gradient(135deg, transparent 44%, #e5494d 44%, #e5494d 56%, transparent 56%);
}

.palette-item-active .palette-key {
  transform: scale(1.1);
  border-color: #b66ce5;
  box-shadow: 0 0 0 2px #b66ce5, 0 1px 4px rgba(0, 0, 0, 0.3);
}

.palette-tool-label {
  margin-top: 4px;
  font-size: 10px;
  color: #6a5a80;
  font-weight: 700;
  line-height: 16px;
  height: 16px;
}

.palette-need {
  margin-top: 4px;
  min-width: 20px;
  height: 18px;
  padding: 0 4px;
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(182, 108, 229, 0.35);
  box-sizing: border-box;
  color: #6a3aa0;
  font-size: 10px;
  font-weight: 800;
  line-height: 16px;
  text-align: center;
}

.palette-need-zero {
  background: #1e8e3e;
  border-color: #1e8e3e;
  color: #ffffff;
}

/* 工具行 (ds-btn 双态文本按钮) */
.tool-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-top: 10px;
}

.tool-key {
  flex: 1;
  height: 38px;
  padding: 0 8px;
  font-size: 13px;
  border-radius: 8px;
}

.tool-key-danger {
  color: #d64545;
  border-color: rgba(214, 69, 69, 0.5);
}

.tool-key-danger.ds-btn-hover {
  background: rgba(214, 69, 69, 0.12);
  border-color: rgba(214, 69, 69, 0.55);
  color: #d64545;
}

/* 教程模式提示图 */
.tutorial-bar {
  width: 100%;
  height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 8px;
  border: 1px solid rgba(182, 108, 229, 0.35);
  margin-top: 8px;
  position: relative;
  overflow: hidden;
}

.tutorial-image {
  height: 100%;
  width: auto;
}

.tutorial-close {
  position: absolute;
  right: 8px;
  top: 8px;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(182, 108, 229, 0.4);
  border-radius: 50%;
}

.tutorial-close-x {
  font-size: 16px;
  color: #6a3aa0;
  font-weight: 700;
  line-height: 1;
}

/* 完成提示条 */
.complete-banner {
  margin-top: 8px;
  font-size: 13px;
  font-weight: 600;
  color: #1e7a3c;
  background: rgba(30, 158, 90, 0.16);
  padding: 6px 14px;
  border-radius: 6px;
  border: 1px solid rgba(30, 158, 90, 0.3);
}

/* 已通关标记 (标题旁) */
.done-badge {
  flex-shrink: 0;
  margin-left: 6px;
  padding: 2px 8px;
  border-radius: 9px;
  background: #1e8e3e;
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  line-height: 16px;
}

/* 通关庆祝遮罩 (fixed 全屏, pointer-events none 不挡操作) */
.celebrate-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 27, 42, 0.55);
  animation: celebrate-fade-in 0.25s ease both;
  pointer-events: none;
}

.celebrate-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28px 40px;
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  animation: celebrate-pop 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.celebrate-check {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: #1e8e3e;
  color: #ffffff;
  font-size: 42px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: celebrate-check-spin 0.7s ease both;
}

.celebrate-title {
  margin-top: 14px;
  font-size: 20px;
  font-weight: 800;
  color: #2b3a4a;
}

.celebrate-sub {
  margin-top: 6px;
  font-size: 13px;
  color: #6b7a8a;
}

/* 彩带小条 (颜色对应 5 画笔色 + 金色) */
.celebrate-confetti {
  position: absolute;
  width: 10px;
  height: 16px;
  border-radius: 2px;
  opacity: 0;
  animation: celebrate-fall 1.5s ease-out both;
}

.celebrate-confetti-1 { background: #f80000; left: 12%; animation-delay: 0.05s; }
.celebrate-confetti-2 { background: #f8f800; left: 26%; animation-delay: 0.15s; }
.celebrate-confetti-3 { background: #4868f8; left: 42%; animation-delay: 0.25s; }
.celebrate-confetti-4 { background: #48b048; left: 58%; animation-delay: 0.1s; }
.celebrate-confetti-5 { background: #181818; left: 74%; animation-delay: 0.2s; }
.celebrate-confetti-6 { background: #ff9800; left: 88%; animation-delay: 0.3s; }

@keyframes celebrate-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes celebrate-pop {
  0% { transform: scale(0.4); opacity: 0; }
  70% { transform: scale(1.06); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes celebrate-check-spin {
  0% { transform: scale(0) rotate(-30deg); }
  60% { transform: scale(1.15) rotate(6deg); }
  100% { transform: scale(1) rotate(0deg); }
}

@keyframes celebrate-fall {
  0% { top: -8%; opacity: 0; transform: rotate(0deg); }
  15% { opacity: 1; }
  100% { top: 105%; opacity: 0; transform: rotate(560deg); }
}
