/* picture-scene.wxss — 图画谜题玩法样式 (迁移自 pages/picture/picture.wxss) */
.picture-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 20px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #f0f4f8;
}

.scene-bar {
  width: 100%;
  padding: 10px 12px;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 7px;
  border: 0.5px solid #d8e0e8;
  margin-bottom: 8px;
}

.scene-bar-text {
  font-size: 14px;
  color: #3a4a5a;
  font-weight: 600;
}

/* 顶部信息栏 */
.game-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.puzzle-name {
  font-size: 16px;
  font-weight: 700;
  color: #2b3a4a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 60%;
}

.stat {
  font-size: 12px;
  color: #6b7a8a;
  margin-left: 8px;
  white-space: nowrap;
}

.timer {
  font-size: 15px;
  font-weight: 600;
  color: #2b3a4a;
  margin-left: 6px;
  white-space: nowrap;
}

/* 类别横向滚动 */
.cat-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8px;
}

.cat-row {
  display: inline-flex;
  flex-direction: row;
  gap: 6px;
  padding: 1px 0;
}

.cat-chip {
  flex-shrink: 0;
  font-size: 12px;
  padding: 5px 13px;
  border-radius: 12px;
  background: #ffffff;
  color: #6b7a8a;
  border: 0.5px solid #d0d8e0;
}

.cat-chip-active {
  background: #2b3a4a;
  color: #ffffff;
  border-color: #2b3a4a;
}

/* 谜题导航 */
.nav-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-bottom: 10px;
}

.nav-key {
  flex: 1;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: #2b3a4a;
  background: #ffffff;
  border-radius: 6px;
  border: 0.5px solid #d0d8e0;
}

.nav-key-random {
  background: #2b3a4a;
  color: #ffffff;
  border-color: #2b3a4a;
}

/* 15x15 彩色网格 + Nonogram 行列提示 */
.puzzle-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.clue-header {
  width: 100%;
  display: flex;
  flex-direction: row;
}

.clue-corner {
  width: 60px;
  height: 60px;
  flex-shrink: 0;
}

.col-clue {
  flex: 1;
  min-width: 0;
  height: 60px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  gap: 1px;
  padding-bottom: 2px;
  box-sizing: border-box;
}

.puzzle-body {
  width: 100%;
  display: flex;
  flex-direction: row;
}

.row-clues {
  width: 60px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

.row-clue {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  gap: 2px;
  padding-right: 4px;
  box-sizing: border-box;
}

.run-chip {
  font-size: 9px;
  font-weight: 600;
  padding: 1px 3px;
  border-radius: 3px;
  border: 0.5px solid;
  line-height: 1;
  white-space: nowrap;
}

.run-chip-empty {
  color: #9aa7b4;
  border-color: transparent;
}

.paint-grid {
  flex: 1;
  aspect-ratio: 1 / 1;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  background: #ffffff;
  border: 1.5px solid #2b3a4a;
  box-sizing: border-box;
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}

.paint-cell {
  width: calc(100% / 15);
  height: calc(100% / 15);
  box-sizing: border-box;
  border: 0.5px solid #e6ebf0;
}

/* 显示答案时: 去掉格子线, 纯色块拼图效果 */
.paint-grid-reveal .paint-cell {
  border-color: transparent;
}

/* 原 DS numclo_waku.nbm 网格外框背景 */
.waku-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.14;
  pointer-events: none;
}

/* 调色板 */
.palette {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 8px;
  margin-top: 12px;
  justify-content: center;
}

.palette-key {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2px solid #ffffff;
  box-shadow: 0 1px 4px rgba(43, 58, 74, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.palette-key-active {
  transform: scale(1.12);
  box-shadow: 0 0 0 2px #2b3a4a, 0 1px 4px rgba(43, 58, 74, 0.25);
}

.erase-mark {
  font-size: 17px;
  color: #9aa7b4;
  font-weight: 700;
}

/* 工具行 */
.tool-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-top: 10px;
}

.tool-key {
  flex: 1;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #2b3a4a;
  background: #ffffff;
  border-radius: 7px;
  border: 0.5px solid #d0d8e0;
}

.tool-key-primary {
  background: #2b3a4a;
  color: #ffffff;
  border-color: #2b3a4a;
}

/* 完成提示条 */
.complete-banner {
  margin-top: 8px;
  font-size: 13px;
  color: #1e8e3e;
  background: #e6f4ea;
  padding: 6px 14px;
  border-radius: 6px;
}

/* 原 DS numclo_00.nbm banner */
.picture-banner {
  width: 100%;
  height: 90px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 8px;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid #e0e6ec;
}

.picture-banner-image {
  width: 100%;
  height: 100%;
}
