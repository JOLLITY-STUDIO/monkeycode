<view class="select-page">
  <!-- 原 DS select1.nbm 横幅 -->
  <view class="select1-banner">
    <image class="select1-image" src="{{bannerUrl}}" mode="aspectFit" lazy-load></image>
  </view>

  <!-- 难度选择: A/B/C/D 原版按钮 -->
  <view class="difficulty-row">
    <view
      wx:for="{{diffButtons}}"
      wx:key="key"
      class="difficulty-key {{difficulty === item.key ? 'difficulty-key-active' : ''}}"
      data-diff="{{item.key}}"
      bindtap="onTapDiff"
    >
      <image class="difficulty-key-image" src="{{item.iconUrl}}" mode="aspectFit" lazy-load></image>
      <text class="difficulty-key-label">{{diffLabels[item.key]}}</text>
    </view>
  </view>

  <!-- 题号选择: 上/下箭头 + 输入框 -->
  <view class="number-row">
    <view
      class="arrow-btn"
      bindtouchstart="onDownTouchStart"
      bindtouchend="onDownTouchEnd"
    >
      <image
        class="arrow-image"
        src="{{downPressed ? downSelectedUrl : downNormalUrl}}"
        mode="aspectFit"
        lazy-load
      ></image>
    </view>
    <view class="number-display">
      <input
        class="number-input"
        type="number"
        maxlength="4"
        value="{{puzzleNo}}"
        bindinput="onNoInput"
      />
    </view>
    <view
      class="arrow-btn"
      bindtouchstart="onUpTouchStart"
      bindtouchend="onUpTouchEnd"
    >
      <image
        class="arrow-image"
        src="{{upPressed ? upSelectedUrl : upNormalUrl}}"
        mode="aspectFit"
        lazy-load
      ></image>
    </view>
  </view>

  <!-- 选中题目预览 -->
  <view class="preview-text" wx:if="{{previewText}}">{{previewText}}</view>

  <!-- 底部操作: Start + Return -->
  <view class="action-row">
    <view
      class="action-btn action-return"
      bindtouchstart="onReturnTouchStart"
      bindtouchend="onReturnTouchEnd"
    >
      <image
        class="action-image"
        src="{{returnPressed ? returnSelectedUrl : returnNormalUrl}}"
        mode="aspectFit"
        lazy-load
      ></image>
    </view>
    <view
      class="action-btn action-start"
      bindtouchstart="onStartTouchStart"
      bindtouchend="onStartTouchEnd"
      bindtap="onStart"
    >
      <image
        class="action-image"
        src="{{startPressed ? startSelectedUrl : startNormalUrl}}"
        mode="aspectFit"
        lazy-load
      ></image>
    </view>
  </view>
</view>
