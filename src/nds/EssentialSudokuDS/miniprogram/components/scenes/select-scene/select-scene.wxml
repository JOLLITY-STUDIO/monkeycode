<view class="select-page">
  <!-- 标题 (文本, 不再使用 NBM 横幅) -->
  <view class="select-header">
    <text class="select-title">数独选题</text>
    <text class="select-subtitle">全局题库 1-1000</text>
  </view>

  <!-- 难度选择: 简单/中等/困难/专家 (双态文本按钮) -->
  <view class="difficulty-row">
    <view
      wx:for="{{diffButtons}}"
      wx:key="key"
      class="ds-btn difficulty-key {{difficulty === item.key ? 'ds-btn-active' : ''}}"
      hover-class="ds-btn-hover"
      hover-stay-time="80"
      data-diff="{{item.key}}"
      bindtap="onTapDiff"
    >{{item.label}}</view>
  </view>

  <!-- 题号选择: − / 输入框 / + -->
  <view class="number-row">
    <view
      class="ds-btn ds-btn-key number-btn"
      hover-class="ds-btn-hover"
      hover-stay-time="80"
      bindtap="onMinus"
    >−</view>
    <view class="number-display">
      <input
        class="number-input"
        type="number"
        maxlength="4"
        value="{{puzzleNo}}"
        bindinput="onNoInput"
      />
    </view>
    <view
      class="ds-btn ds-btn-key number-btn"
      hover-class="ds-btn-hover"
      hover-stay-time="80"
      bindtap="onPlus"
    >+</view>
  </view>

  <!-- 选中题目预览 -->
  <view class="preview-text" wx:if="{{previewText}}">{{previewText}}</view>

  <!-- 底部操作: Return + Start -->
  <view class="action-row">
    <view
      class="ds-btn action-return"
      hover-class="ds-btn-hover"
      hover-stay-time="80"
      bindtap="onBack"
    >返回</view>
    <view
      class="ds-btn action-start"
      hover-class="ds-btn-hover"
      hover-stay-time="80"
      bindtap="onStart"
    >开始</view>
  </view>
</view>
