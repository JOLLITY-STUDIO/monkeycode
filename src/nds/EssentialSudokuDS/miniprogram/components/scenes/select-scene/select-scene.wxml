<view class="select-page">
  <!-- 返回条 -->
  <view class="scene-bar" bindtap="onBack">
    <text class="scene-bar-text">← 返回主菜单</text>
  </view>

  <!-- 原 DS select1 按钮精灵装饰 -->
  <view class="select1-banner">
    <image class="select1-image" src="/assets/nbm/select1.nbm.png" mode="aspectFit" lazy-load></image>
  </view>

  <view class="select-card">
    <!-- 难度选择 -->
    <view class="section-label">难度</view>
    <view class="diff-chips">
      <view
        wx:for="{{diffChips}}"
        wx:key="*this"
        class="diff-chip {{difficulty === item ? 'diff-chip-active' : ''}}"
        data-diff="{{item}}"
        bindtap="onTapDiff"
      >{{diffLabels[item]}}</view>
    </view>

    <!-- 题号输入 -->
    <view class="section-label">题号 (1-1000)</view>
    <view class="num-input-row">
      <input
        class="num-input"
        type="number"
        maxlength="4"
        value="{{puzzleNo}}"
        placeholder="输入 1-1000"
        bindinput="onNoInput"
      />
      <view class="num-actions">
        <view class="num-btn" bindtap="onNoDec">-1</view>
        <view class="num-btn" bindtap="onNoInc">+1</view>
      </view>
    </view>

    <!-- 已选题目预览 -->
    <view class="pick-preview" wx:if="{{previewText}}">{{previewText}}</view>

    <!-- 开始 -->
    <view class="start-btn-wrap">
      <image class="start-btn-bg" src="{{select6Url}}" mode="aspectFill" lazy-load></image>
      <view class="start-btn" bindtap="onStart">开始数独</view>
    </view>
  </view>
</view>
