<view class="select-page">
  <!-- 标题 -->
  <view class="select-header">
    <text class="select-title">数字谜题选题</text>
    <text class="select-subtitle">全局题库 1-1000</text>
  </view>

  <!-- 难度选择: 中文文本双态胶囊 (normal 亮蓝 / selected 深蓝) -->
  <view class="difficulty-row">
    <view
      wx:for="{{diffButtons}}"
      wx:key="key"
      class="diff-btn sel-btn {{difficulty === item.key ? 'sel-btn-active' : ''}}"
      hover-class="sel-btn-hover"
      hover-stay-time="80"
      data-diff="{{item.key}}"
      bindtap="onTapDiff"
    >{{item.label}}</view>
  </view>

  <!-- 题号选择: − / 输入框 / + -->
  <view class="number-row">
    <view class="narrow-btn sel-btn" hover-class="sel-btn-hover" hover-stay-time="80" bindtap="onMinus">−</view>
    <view class="number-display">
      <input
        class="number-input"
        type="number"
        maxlength="4"
        value="{{puzzleNo}}"
        bindinput="onNoInput"
      />
    </view>
    <view class="narrow-btn sel-btn" hover-class="sel-btn-hover" hover-stay-time="80" bindtap="onPlus">＋</view>
  </view>

  <!-- 选中题目预览 -->
  <view class="preview-text" wx:if="{{previewText}}">{{previewText}}</view>

  <!-- 底部 返回 + 开始 -->
  <view class="action-row">
    <view class="act-btn sel-btn" hover-class="sel-btn-hover" hover-stay-time="80" bindtap="onBack">返回</view>
    <view class="act-btn sel-btn sel-btn-primary" hover-class="sel-btn-hover" hover-stay-time="80" bindtap="onStart">开始</view>
  </view>
</view>
