/* select-scene.wxss — 数独选题场景样式
 * PICTURE-V0.29: 全部按钮改 select1.nbm 原版图片 (浅蓝 NORMAL + 深蓝 SELECTED 双态)
 *  - Difficulty A/B/C/D: 常驻 active 用 .ds-img-btn-active (CSS 滤镜 + 描边, NBM 只切了 normal)
 *  - 上下箭头 / Start / Return: touchstart 切 selected 图源 (pressed 状态机)
 */

.select-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #0d1b2a;
}

.select-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  gap: 8px;
  padding: 14px 0;
  margin-bottom: 24px;
  background: rgba(22, 42, 66, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
}

.select-title {
  font-size: 19px;
  font-weight: 700;
  color: #f0f4f8;
}

.select-subtitle {
  font-size: 12px;
  color: #9fb6d3;
}

/* ====== 图片按钮通用 (DS NBM 原版双态) ====== */
.ds-img-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  /* 默认让容器自适应图片尺寸 (不写 width/height, 由子类约束) */
}

.ds-img-btn-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 常驻 active 态: 模拟深蓝高亮 (NBM 没切 DIFF selected, 用 CSS 滤镜 + 描边) */
.ds-img-btn-active .ds-img-btn-img {
  filter: brightness(1.35) saturate(1.6) drop-shadow(0 0 4px rgba(77, 184, 255, 0.85));
  transform: scale(1.06);
  transition: filter 0.08s ease, transform 0.08s ease;
}

/* 触摸按下 → 短暂亮度脉冲 (即使 image 已切到 selected 图也再加强反馈) */
.ds-img-btn:active .ds-img-btn-img {
  filter: brightness(1.2);
}

/* ====== 难度 A/B/C/D (30x30 NBM, NORMAL 与 SELECTED 同图源) ====== */
.difficulty-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 14px;
  width: 100%;
  margin-bottom: 22px;
}

.diff-btn {
  width: 56px;
  height: 56px;
}

.diff-btn .ds-img-btn-img {
  width: 56px;
  height: 56px;
}

/* ====== 题号选择: − / 输入框 / + (20x20 NBM 箭头) ====== */
.number-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 18px;
  width: 100%;
  margin-bottom: 14px;
}

.arrow-btn {
  width: 40px;
  height: 40px;
}

.arrow-btn .ds-img-btn-img {
  width: 40px;
  height: 40px;
}

.number-display {
  min-width: 140px;
  height: 48px;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.25);
}

.number-input {
  width: 100%;
  height: 100%;
  text-align: center;
  font-size: 22px;
  font-weight: 700;
  color: #0d1b2a;
}

.preview-text {
  margin: 0 8px 20px;
  padding: 7px 12px;
  font-size: 12px;
  color: #e0e6ec;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  text-align: center;
}

/* ====== 底部 Return + Start (NBM 56x24 / 88x24 双态长条) ====== */
.action-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  max-width: 320px;
  margin-top: auto;
  padding-top: 16px;
}

.return-btn {
  width: 110px;
  height: 36px;
}

.return-btn .ds-img-btn-img {
  width: 110px;
  height: 36px;
}

.start-btn {
  width: 132px;
  height: 40px;
}

.start-btn .ds-img-btn-img {
  width: 132px;
  height: 40px;
}