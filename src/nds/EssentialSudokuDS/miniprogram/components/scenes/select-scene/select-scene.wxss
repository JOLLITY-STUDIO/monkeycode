.select-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #e9eef3;
}

.scene-bar {
  width: 100%;
  padding: 10px 12px;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 7px;
  border: 0.5px solid #d8e0e8;
  margin-bottom: 8px;
}

.scene-bar-text {
  font-size: 14px;
  color: #3a4a5a;
  font-weight: 600;
}

.select1-banner {
  width: 100%;
  height: 150px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 12px;
  background: #0d1b2a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.select1-image {
  width: 100%;
  height: 100%;
  opacity: 0.9;
}

.select-card {
  width: 100%;
  background: #ffffff;
  border-radius: 10px;
  padding: 14px;
  box-sizing: border-box;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.section-label {
  font-size: 13px;
  font-weight: 600;
  color: #5a6a7a;
  margin-bottom: 7px;
  margin-top: 10px;
}

.diff-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 7px;
}

.diff-chip {
  padding: 7px 14px;
  border-radius: 15px;
  font-size: 13px;
  color: #3a4a5a;
  background: #f2f4f6;
  border: 0.5px solid #d0d8e0;
}

.diff-chip-active {
  color: #ffffff;
  background: #1565c0;
  border-color: #1565c0;
}

.num-input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.num-input {
  flex: 1;
  min-width: 0;
  height: 44px;
  background: #f7f9fb;
  border: 1px solid #c8d2dc;
  border-radius: 7px;
  padding: 0 12px;
  font-size: 20px;
  font-weight: 700;
  color: #2b3a4a;
}

.num-actions {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.num-btn {
  padding: 5px 13px;
  border-radius: 5px;
  font-size: 13px;
  color: #1565c0;
  background: #e3f2fd;
  border: 0.5px solid #90caf9;
  text-align: center;
}

.pick-preview {
  margin-top: 10px;
  font-size: 12px;
  color: #8e24aa;
  background: #f3e5f5;
  border-radius: 5px;
  padding: 7px 10px;
}

.start-btn-wrap {
  position: relative;
  margin-top: 16px;
  height: 48px;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 3px 8px rgba(21, 101, 192, 0.3);
}

.start-btn-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.25;
  z-index: 1;
}

.start-btn {
  position: relative;
  z-index: 2;
  height: 48px;
  border-radius: 24px;
  background: rgba(21, 101, 192, 0.75);
  color: #ffffff;
  font-size: 16px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.start-btn:active {
  opacity: 0.85;
}
