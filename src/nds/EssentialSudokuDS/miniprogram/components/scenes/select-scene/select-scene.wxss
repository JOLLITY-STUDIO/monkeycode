.select-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #0d1b2a;
}

.select1-banner {
  width: 100%;
  height: 140px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 16px;
  background: #e9eef3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.select1-image {
  width: 100%;
  height: 100%;
  opacity: 0.95;
}

/* 难度 A-D 按钮行 */
.difficulty-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  width: 100%;
  margin-bottom: 18px;
}

.difficulty-key {
  position: relative;
  width: 54px;
  height: 54px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2px;
  box-sizing: border-box;
  border-radius: 8px;
}

.difficulty-key-active {
  background: rgba(255, 255, 255, 0.18);
}

.difficulty-key-image {
  width: 40px;
  height: 40px;
}

.difficulty-key-label {
  position: absolute;
  bottom: 2px;
  font-size: 10px;
  color: #ffffff;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

/* 题号选择: 箭头 + 输入框 */
.number-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  margin-bottom: 14px;
}

.arrow-btn {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-image {
  width: 32px;
  height: 32px;
}

.number-display {
  min-width: 120px;
  height: 48px;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.25);
}

.number-input {
  width: 100%;
  height: 100%;
  text-align: center;
  font-size: 22px;
  font-weight: 700;
  color: #0d1b2a;
}

.preview-text {
  margin: 0 8px 20px;
  padding: 7px 12px;
  font-size: 12px;
  color: #e0e6ec;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  text-align: center;
}

/* 底部 Start + Return */
.action-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-top: auto;
  padding-top: 16px;
}

.action-btn {
  width: 96px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-image {
  width: 100%;
  height: 100%;
}

.action-start {
  width: 120px;
  height: 48px;
}
