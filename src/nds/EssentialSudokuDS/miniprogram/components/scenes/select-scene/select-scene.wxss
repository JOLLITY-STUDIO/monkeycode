@import '../../../styles/ds-buttons.wxss';

.select-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #0d1b2a;
}

.select-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  gap: 8px;
  padding: 14px 0;
  margin-bottom: 16px;
  background: rgba(22, 42, 66, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
}

.select-title {
  font-size: 19px;
  font-weight: 700;
  color: #f0f4f8;
}

.select-subtitle {
  font-size: 12px;
  color: #9fb6d3;
}

/* 难度 按钮行 (双态文本) */
.difficulty-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  width: 100%;
  margin-bottom: 18px;
}

.difficulty-key {
  width: 68px;
  height: 36px;
  padding: 0;
}

/* 题号选择: − / 输入框 / + */
.number-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  margin-bottom: 14px;
}

.number-btn {
  width: 42px;
  height: 42px;
}

.number-display {
  min-width: 120px;
  height: 48px;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.25);
}

.number-input {
  width: 100%;
  height: 100%;
  text-align: center;
  font-size: 22px;
  font-weight: 700;
  color: #0d1b2a;
}

.preview-text {
  margin: 0 8px 20px;
  padding: 7px 12px;
  font-size: 12px;
  color: #e0e6ec;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  text-align: center;
}

/* 底部 Return + Start (双态文本) */
.action-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  max-width: 280px;
  margin-top: auto;
  padding-top: 16px;
}

.action-return {
  width: 96px;
  height: 44px;
}

.action-start {
  width: 120px;
  height: 48px;
  font-size: 17px;
  background: rgba(77, 184, 255, 0.22);
  border-color: #4db8ff;
  color: #ffffff;
}
