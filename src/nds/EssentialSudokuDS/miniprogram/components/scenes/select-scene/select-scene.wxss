/* select-scene.wxss — 数独选题场景样式
 * PICTURE-V0.30: 全部按钮改中文文本双态胶囊 (纯中文版 UI)
 *   - normal   = #28A0F0 亮蓝渐变 + 白字 (select1.nbm NORMAL 帧取色)
 *   - selected = #2060D0 深蓝渐变 + 白字 (select1.nbm SELECTED 帧取色)
 *   - 按下瞬态 = .sel-btn-hover (hover-class)
 */

.select-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #0d1b2a;
}

.select-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  gap: 8px;
  padding: 14px 0;
  margin-bottom: 24px;
  background: rgba(22, 42, 66, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
}

.select-title {
  font-size: 19px;
  font-weight: 700;
  color: #f0f4f8;
}

.select-subtitle {
  font-size: 12px;
  color: #9fb6d3;
}

/* ====== 中文文本双态胶囊按钮 (select1 取色) ====== */
.sel-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 0;
  border-radius: 999px;
  color: #ffffff;
  font-weight: 700;
  text-align: center;
  background: linear-gradient(180deg, #45b4f8 0%, #28a0f0 55%, #1e8fe8 100%);
  box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.28),
    inset 0 -2px 0 rgba(0, 0, 30, 0.15),
    0 3px 8px rgba(0, 0, 0, 0.3);
  transition: background 0.08s ease, box-shadow 0.08s ease, transform 0.08s ease;
}

/* 按下瞬态 → 深蓝 */
.sel-btn-hover {
  background: linear-gradient(180deg, #2870e0 0%, #2060d0 55%, #1853b8 100%);
  box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.18),
    inset 0 -2px 0 rgba(0, 0, 30, 0.25),
    0 2px 6px rgba(0, 0, 0, 0.35);
  transform: translateY(1px);
}

/* 常驻 selected (难度选中 / 主操作) → 深蓝 */
.sel-btn-active {
  background: linear-gradient(180deg, #2870e0 0%, #2060d0 55%, #1853b8 100%);
  box-shadow: 0 0 0 2px rgba(77, 184, 255, 0.55),
    inset 0 2px 0 rgba(255, 255, 255, 0.18),
    inset 0 -2px 0 rgba(0, 0, 30, 0.25),
    0 3px 10px rgba(0, 0, 0, 0.35);
}

/* ====== 难度 4 按钮 ====== */
.difficulty-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 14px;
  width: 100%;
  margin-bottom: 22px;
}

.diff-btn {
  width: 76px;
  height: 44px;
  font-size: 17px;
  letter-spacing: 1px;
}

/* ====== 题号选择: − / 输入框 / ＋ ====== */
.number-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 14px;
  width: 100%;
  margin-bottom: 14px;
}

.narrow-btn {
  width: 56px;
  height: 46px;
  font-size: 24px;
  font-weight: 700;
}

.number-display {
  min-width: 150px;
  height: 48px;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.25);
}

.number-input {
  width: 100%;
  height: 100%;
  text-align: center;
  font-size: 22px;
  font-weight: 700;
  color: #0d1b2a;
}

.preview-text {
  margin: 0 8px 20px;
  padding: 7px 12px;
  font-size: 12px;
  color: #e0e6ec;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  text-align: center;
}

/* ====== 底部 返回 + 开始 ====== */
.action-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 18px;
  width: 100%;
  max-width: 340px;
  margin-top: auto;
  padding-top: 16px;
}

.act-btn {
  height: 48px;
  padding: 0 34px;
  font-size: 18px;
  letter-spacing: 4px;
}

/* 开始 = 主操作, 常驻深蓝 */
.sel-btn-primary {
  background: linear-gradient(180deg, #2870e0 0%, #2060d0 55%, #1853b8 100%);
  box-shadow: 0 0 0 2px rgba(77, 184, 255, 0.4),
    inset 0 2px 0 rgba(255, 255, 255, 0.18),
    inset 0 -2px 0 rgba(0, 0, 30, 0.25),
    0 3px 10px rgba(0, 0, 0, 0.35);
}
