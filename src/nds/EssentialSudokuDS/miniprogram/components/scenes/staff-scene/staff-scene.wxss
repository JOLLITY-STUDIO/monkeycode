.staff-page {
  height: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-y: auto;
  padding: 12px 14px 20px;
  background: transparent;
}

.scene-bar {
  width: 100%;
  padding: 12px 14px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(182, 108, 229, 0.45);
  border-radius: 10px;
  margin-bottom: 10px;
  box-shadow: 0 2px 10px rgba(182, 108, 229, 0.14);
}

.scene-bar-text {
  font-size: 14px;
  color: #6a3aa0;
  font-weight: 700;
}

.staff-scroll {
  height: calc(100% - 70px);
  width: 100%;
}

.staff-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.staff-image {
  width: 100%;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(182, 108, 229, 0.35);
}

.staff-footer {
  text-align: center;
  font-size: 12px;
  color: rgba(106, 58, 160, 0.65);
  padding: 20px 0 30px;
}
