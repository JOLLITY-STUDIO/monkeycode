.staff-page {
  height: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-y: auto;
  padding: 12px 14px 20px;
  background: #0d1b2a;
}

.scene-bar {
  width: 100%;
  padding: 12px 14px;
  box-sizing: border-box;
  background: rgba(22, 42, 66, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  margin-bottom: 10px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
}

.scene-bar-text {
  font-size: 14px;
  color: #c8d5e8;
  font-weight: 600;
}

.staff-scroll {
  height: calc(100% - 70px);
  width: 100%;
}

.staff-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.staff-image {
  width: 100%;
  border-radius: 10px;
  background: rgba(22, 42, 66, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.staff-footer {
  text-align: center;
  font-size: 12px;
  color: rgba(159, 182, 211, 0.55);
  padding: 20px 0 30px;
}
