.staff-page {
  height: 100%;
  box-sizing: border-box;
  overflow-y: auto;
  padding: 8px 12px 20px;
  background: #0a0a0a;
}

.scene-bar {
  width: 100%;
  padding: 10px 12px;
  box-sizing: border-box;
  background: #1a1a1a;
  border-radius: 7px;
  border: 0.5px solid #2a2a2a;
  margin-bottom: 8px;
}

.scene-bar-text {
  font-size: 14px;
  color: #dddddd;
  font-weight: 600;
}

.staff-scroll {
  height: calc(100% - 70px);
  width: 100%;
}

.staff-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.staff-image {
  width: 100%;
  border-radius: 6px;
  background: #1a1a1a;
}

.staff-footer {
  text-align: center;
  font-size: 12px;
  color: #777;
  padding: 20px 0 30px;
}
