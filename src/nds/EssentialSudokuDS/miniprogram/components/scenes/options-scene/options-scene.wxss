.options-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  min-height: 100vh;
  padding: 12px 16px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #0d1b2a;
}

.scene-bar {
  width: 100%;
  padding: 12px 14px;
  box-sizing: border-box;
  background: rgba(22, 42, 66, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  margin-bottom: 14px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
}

.scene-bar-text {
  font-size: 14px;
  color: #c8d5e8;
  font-weight: 600;
}

.options-card {
  width: 100%;
  background: rgba(22, 42, 66, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 16px 16px 8px;
  box-sizing: border-box;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
}

.option-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
}

.option-label-icon {
  flex-shrink: 0;
  height: 18px;
  width: auto;
  max-width: 120px;
}

.option-slider {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.option-value {
  width: 36px;
  flex-shrink: 0;
  text-align: right;
  font-size: 14px;
  color: #4db8ff;
  font-weight: 700;
}

.option-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
  margin: 8px 0 6px;
}

.option-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 4px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  transition: background 0.08s ease;
}

.option-action:last-child {
  border-bottom: none;
}

.option-action-hover {
  background: rgba(255, 255, 255, 0.06);
}

.option-action-icon {
  flex-shrink: 0;
  height: 18px;
  width: auto;
  max-width: 120px;
}

.option-action-icon-missing {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 20px;
  padding: 0 12px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.1);
  font-size: 11px;
  font-weight: 700;
  color: #9fb6d3;
  letter-spacing: 0.5px;
}

.option-action-hint {
  flex: 1;
  text-align: right;
  font-size: 13px;
  color: #8a9bb0;
}
