.options-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  background: #e9eef3;
}

.scene-bar {
  width: 100%;
  padding: 10px 12px;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 7px;
  border: 0.5px solid #d8e0e8;
  margin-bottom: 8px;
}

.scene-bar-text {
  font-size: 14px;
  color: #3a4a5a;
  font-weight: 600;
}

.select3-banner {
  width: 100%;
  height: 140px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 12px;
  background: #0d1b2a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.select3-image {
  width: 100%;
  height: 100%;
  opacity: 0.9;
}

.options-card {
  width: 100%;
  background: #ffffff;
  border-radius: 10px;
  padding: 14px 14px 6px;
  box-sizing: border-box;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.option-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding: 8px 0;
}

.option-label {
  width: 90px;
  flex-shrink: 0;
  font-size: 14px;
  font-weight: 600;
  color: #3a4a5a;
}

.option-slider {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.option-value {
  width: 36px;
  flex-shrink: 0;
  text-align: right;
  font-size: 14px;
  color: #1565c0;
  font-weight: 700;
}

.option-divider {
  height: 0.5px;
  background: #eef1f4;
  margin: 8px 0 4px;
}

.option-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12px 4px;
  border-bottom: 0.5px solid #f2f4f6;
}

.option-action:active {
  background: #f5f7f9;
}

.option-action-text {
  font-size: 15px;
  font-weight: 600;
  color: #2b3a4a;
}

.option-action-hint {
  font-size: 12px;
  color: #9aa7b4;
}
