.options-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #e9eef3;
}

.scene-bar {
  width: 100%;
  padding: 10px 12px;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 7px;
  border: 0.5px solid #d8e0e8;
  margin-bottom: 8px;
}

.scene-bar-text {
  font-size: 14px;
  color: #3a4a5a;
  font-weight: 600;
}

.setu-banner {
  width: 100%;
  height: 180px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 12px;
  background: #0d1b2a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.setu-image {
  width: 100%;
  height: 100%;
  opacity: 0.95;
}

.options-card {
  width: 100%;
  background: #ffffff;
  border-radius: 10px;
  padding: 14px 14px 6px;
  box-sizing: border-box;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.option-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding: 8px 0;
}

.option-label-icon {
  flex-shrink: 0;
  height: 16px;
  width: auto;
  max-width: 110px;
}

.option-slider {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.option-value {
  width: 36px;
  flex-shrink: 0;
  text-align: right;
  font-size: 14px;
  color: #1565c0;
  font-weight: 700;
}

.option-divider {
  height: 0.5px;
  background: #eef1f4;
  margin: 8px 0 4px;
}

.option-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 12px 4px;
  border-bottom: 0.5px solid #f2f4f6;
}

.option-action-hover {
  background: #f5f7f9;
}

.option-action-icon {
  flex-shrink: 0;
  height: 16px;
  width: auto;
  max-width: 110px;
}

.option-action-icon-missing {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 18px;
  padding: 0 10px;
  border-radius: 3px;
  background: #e9eef3;
  font-size: 11px;
  font-weight: 700;
  color: #5a6a7a;
  letter-spacing: 0.5px;
}

.option-action-hint {
  flex: 1;
  text-align: right;
  font-size: 12px;
  color: #9aa7b4;
}
