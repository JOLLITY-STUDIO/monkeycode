.options-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  min-height: 100vh;
  padding: 12px 16px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

.scene-bar {
  width: 100%;
  padding: 12px 14px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(182, 108, 229, 0.45);
  border-radius: 10px;
  margin-bottom: 14px;
  box-shadow: 0 2px 10px rgba(182, 108, 229, 0.14);
}

.scene-bar-text {
  font-size: 14px;
  color: #6a3aa0;
  font-weight: 700;
}

.options-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(182, 108, 229, 0.35);
  border-radius: 12px;
  padding: 16px 16px 8px;
  box-sizing: border-box;
  box-shadow: 0 3px 14px rgba(182, 108, 229, 0.12);
}

.option-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
}

.option-label-text {
  flex-shrink: 0;
  width: 64px;
  font-size: 14px;
  font-weight: 600;
  color: #6a5a80;
}

.option-slider {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.option-value {
  width: 36px;
  flex-shrink: 0;
  text-align: right;
  font-size: 14px;
  color: #a050d0;
  font-weight: 800;
}

.option-divider {
  height: 1px;
  background: rgba(182, 108, 229, 0.2);
  margin: 8px 0 6px;
}

.option-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 4px;
  border-bottom: 1px solid rgba(182, 108, 229, 0.14);
  transition: background 0.08s ease;
}

.option-action:last-child {
  border-bottom: none;
}

.option-action-hover {
  background: rgba(182, 108, 229, 0.12);
}

.option-action-hint {
  flex: 1;
  text-align: right;
  font-size: 15px;
  font-weight: 600;
  color: #4a3558;
}
