<view class="options-page">
  <!-- 顶部返回条 -->
  <view class="scene-bar" bindtap="onBack">
    <text class="scene-bar-text">← 返回主菜单</text>
  </view>

  <view class="options-card">
    <!-- BGM 音量 -->
    <view class="option-row">
      <text class="option-label-text">背景音乐音量</text>
      <slider class="option-slider" min="0" max="100" value="{{bgmVolume}}" bindchanging="onBgmVolumeChange" bindchange="onBgmVolumeChange" activeColor="#b66ce5" block-color="#ffffff" block-size="20" />
      <text class="option-value">{{bgmVolume}}</text>
    </view>

    <!-- SE 音量 -->
    <view class="option-row">
      <text class="option-label-text">音效音量</text>
      <slider class="option-slider" min="0" max="100" value="{{seVolume}}" bindchanging="onSeVolumeChange" bindchange="onSeVolumeChange" activeColor="#ff8a65" block-color="#ffffff" block-size="20" />
      <text class="option-value">{{seVolume}}</text>
    </view>

    <view class="option-divider"></view>

    <!-- 清除数据 -->
    <view class="option-action" hover-class="option-action-hover" hover-stay-time="80" bindtap="onClearData">
      <text class="option-action-hint">清除进度与设置</text>
    </view>

    <!-- 评分 -->
    <view class="option-action" hover-class="option-action-hover" hover-stay-time="80" bindtap="onRate">
      <text class="option-action-hint">评价本应用</text>
    </view>

    <!-- 制作人员 -->
    <view class="option-action" hover-class="option-action-hover" hover-stay-time="80" bindtap="onCredits">
      <text class="option-action-hint">制作人员名单</text>
    </view>

    <!-- 关于 -->
    <view class="option-action" hover-class="option-action-hover" hover-stay-time="80" bindtap="onAbout">
      <text class="option-action-hint">版权与版本信息</text>
    </view>
  </view>
</view>
