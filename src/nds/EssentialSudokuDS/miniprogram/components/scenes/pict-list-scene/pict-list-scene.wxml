<view class="pict-list-page">
  <!-- 标题 (文本, 不再使用 NBM 横幅) -->
  <view class="pict-header">
    <text class="pict-title">图画谜题</text>
    <text class="pict-subtitle">选择类别 · {{totalPuzzles}} 题</text>
    <text wx:if="{{totalCompleted > 0}}" class="list-done">已通关 {{totalCompleted}}</text>
  </view>

  <!-- 类别列表 -->
  <view class="list-card">
    <view class="list-label">谜题类别</view>
    <scroll-view class="cat-scroll" scroll-y>
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="cat-row {{selectedKey === item.key ? 'cat-row-active' : ''}}"
        hover-class="cat-row-hover"
        hover-stay-time="80"
        data-key="{{item.key}}"
        bindtap="onTapCategory"
      >
        <view wx:if="{{selectedKey === item.key}}" class="cat-dot"></view>
        <text class="cat-label">{{item.label}}</text>
        <text wx:if="{{item.completed > 0}}" class="cat-done {{item.completed === item.count ? 'cat-done-full' : ''}}">✓ {{item.completed}}/{{item.count}}</text>
        <text wx:else class="cat-count">{{item.count}} 题</text>
        <text class="cat-arrow">›</text>
      </view>
    </scroll-view>
  </view>

  <!-- 底部 Return (双态文本按钮) -->
  <view class="action-row">
    <view
      class="ds-btn return-btn"
      hover-class="ds-btn-hover"
      hover-stay-time="80"
      bindtap="onBack"
    >返回</view>
  </view>
</view>
