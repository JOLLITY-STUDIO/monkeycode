.pict-list-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #e9eef3;
}

.scene-bar {
  width: 100%;
  padding: 10px 12px;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 7px;
  border: 0.5px solid #e0e6ec;
  margin-bottom: 8px;
}

.scene-bar-text {
  font-size: 14px;
  color: #1565c0;
  font-weight: 600;
}

.list-banner {
  width: 100%;
  height: 90px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 12px;
  background: #ffffff;
  border: 0.5px solid #e0e6ec;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-banner-image {
  width: 100%;
  height: 100%;
}

.list-card {
  width: 100%;
  background: #ffffff;
  border-radius: 10px;
  padding: 12px;
  box-sizing: border-box;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.list-label {
  font-size: 14px;
  font-weight: 700;
  color: #3a4a5a;
  margin-bottom: 8px;
}

.cat-scroll {
  max-height: 450px;
  width: 100%;
}

.cat-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 11px 8px;
  border-bottom: 0.5px solid #f2f4f6;
}

.cat-row:active {
  background: #f5f7f9;
}

.cat-row-active {
  background: #e8f0fe;
  border-radius: 6px;
}

.cat-arrow-icon {
  width: 16px;
  height: 16px;
  margin-right: 8px;
  flex-shrink: 0;
}

.cat-label {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  font-weight: 600;
  color: #2b3a4a;
}

.cat-count {
  font-size: 12px;
  color: #9aa7b4;
  margin-right: 6px;
}

.cat-arrow {
  font-size: 18px;
  color: #c0c8d0;
}
