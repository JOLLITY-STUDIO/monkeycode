/* pict-list-scene.wxss — 图画谜题类别列表 (V0.45 糖果亮底主题 + 双态文本按钮) */
@import '../../../styles/ds-buttons.wxss';

.pict-list-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 20px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

.pict-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6px;
  padding: 14px 0;
  margin-bottom: 12px;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(182, 108, 229, 0.45);
  border-radius: 10px;
  box-shadow: 0 2px 10px rgba(182, 108, 229, 0.14);
}

.pict-title {
  font-size: 20px;
  font-weight: 800;
  color: #6a3aa0;
}

.pict-subtitle {
  font-size: 13px;
  color: #8f7ba6;
}

.list-card {
  width: 100%;
  flex: 1;
  min-height: 0;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(182, 108, 229, 0.35);
  border-radius: 12px;
  padding: 10px 12px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 3px 14px rgba(182, 108, 229, 0.12);
}

.list-label {
  font-size: 14px;
  font-weight: 700;
  color: #6a3aa0;
  margin-bottom: 6px;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.list-done {
  margin-left: 8px;
  font-size: 11px;
  font-weight: 700;
  color: #1e7a3c;
  background: rgba(30, 158, 90, 0.16);
  border: 1px solid rgba(30, 158, 90, 0.3);
  padding: 2px 8px;
  border-radius: 9px;
}

.cat-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.cat-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 11px 8px;
  border-bottom: 0.5px solid rgba(182, 108, 229, 0.18);
}

.cat-row-hover {
  background: rgba(182, 108, 229, 0.12);
}

.cat-row-active {
  background: rgba(182, 108, 229, 0.2);
  border-radius: 6px;
}

/* 选中标记 (CSS 圆点, 不再使用 pazl_yajirusi 图) */
.cat-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #b66ce5;
  margin-right: 8px;
  flex-shrink: 0;
}

.cat-label {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  font-weight: 600;
  color: #4a3558;
}

.cat-count {
  font-size: 12px;
  color: #8f7ba6;
  margin-right: 6px;
}

/* 完成标记: 有通关记录显示绿字 n/m, 全通关加深底色 */
.cat-done {
  font-size: 12px;
  font-weight: 700;
  color: #1e7a3c;
  background: rgba(30, 158, 90, 0.16);
  border: 1px solid rgba(30, 158, 90, 0.3);
  padding: 2px 8px;
  border-radius: 9px;
  margin-right: 6px;
}

.cat-done-full {
  background: #1e8e3e;
  color: #ffffff;
}

.cat-arrow {
  font-size: 18px;
  color: #b66ce5;
}

/* 底部 Return (双态文本按钮) */
.action-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin-top: 10px;
}

.return-btn {
  width: 96px;
  height: 36px;
  padding: 0;
  border-radius: 8px;
  font-size: 14px;
}
