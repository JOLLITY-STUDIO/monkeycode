/* pict-list-scene.wxss — 图画谜题类别列表 (双态文本按钮 + 深色主题) */
@import '../../../styles/ds-buttons.wxss';

.pict-list-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 20px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

.pict-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6px;
  padding: 14px 0;
  margin-bottom: 12px;
  background: rgba(22, 42, 66, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
}

.pict-title {
  font-size: 20px;
  font-weight: 700;
  color: #f0f4f8;
}

.pict-subtitle {
  font-size: 13px;
  color: #9fb6d3;
}

.list-card {
  width: 100%;
  flex: 1;
  min-height: 0;
  background: rgba(255, 255, 255, 0.08);
  border: 0.5px solid rgba(255, 255, 255, 0.14);
  border-radius: 10px;
  padding: 10px 12px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.list-label {
  font-size: 14px;
  font-weight: 700;
  color: #e0e6ec;
  margin-bottom: 6px;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.list-done {
  margin-left: 8px;
  font-size: 11px;
  font-weight: 700;
  color: #7ce89a;
  background: rgba(30, 142, 62, 0.35);
  padding: 2px 8px;
  border-radius: 9px;
}

.cat-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.cat-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 11px 8px;
  border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
}

.cat-row-hover {
  background: rgba(255, 255, 255, 0.1);
}

.cat-row-active {
  background: rgba(255, 255, 255, 0.14);
  border-radius: 6px;
}

/* 选中标记 (CSS 圆点, 不再使用 pazl_yajirusi 图) */
.cat-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #4db8ff;
  margin-right: 8px;
  flex-shrink: 0;
}

.cat-label {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  font-weight: 600;
  color: #f0f4f8;
}

.cat-count {
  font-size: 12px;
  color: #9aa7b4;
  margin-right: 6px;
}

/* 完成标记: 有通关记录显示绿字 n/m, 全通关加深底色 */
.cat-done {
  font-size: 12px;
  font-weight: 700;
  color: #7ce89a;
  background: rgba(30, 142, 62, 0.35);
  padding: 2px 8px;
  border-radius: 9px;
  margin-right: 6px;
}

.cat-done-full {
  background: rgba(30, 142, 62, 0.85);
  color: #ffffff;
}

.cat-arrow {
  font-size: 18px;
  color: #7c8a9a;
}

/* 底部 Return (双态文本按钮) */
.action-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin-top: 10px;
}

.return-btn {
  width: 96px;
  height: 36px;
  padding: 0;
  border-radius: 8px;
  font-size: 14px;
}
