/* picture-mode-scene.wxss — 图画谜题子模式选择 (2 个真实模式按钮, 深色玻璃主题) */
.picture-mode-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

.scene-bar {
  width: 100%;
  padding: 10px 12px;
  box-sizing: border-box;
  background: rgba(22, 42, 66, 0.85);
  border-radius: 7px;
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  margin-bottom: 16px;
}

.scene-bar-text {
  font-size: 14px;
  color: #4db8ff;
  font-weight: 600;
}

/* 2 个按钮纵向列表 */
.mode-list {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  max-width: 280px;
  gap: 12px;
  margin-top: 10px;
}

/* normal 态: 半透明深色胶囊 + 白 8% 细边 */
.mode-button {
  position: relative;
  padding: 14px 16px;
  box-sizing: border-box;
  background: rgba(22, 42, 66, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  transition: background 0.08s ease, border-color 0.08s ease;
}

/* hover (按下瞬态) */
.mode-button-hover {
  background: rgba(77, 184, 255, 0.12);
  border-color: rgba(77, 184, 255, 0.4);
}

/* selected 态: 蓝边 + 蓝底 + 亮起箭头 */
.mode-button-active {
  background: rgba(77, 184, 255, 0.22);
  border-color: #4db8ff;
  box-shadow: 0 0 0 1px #4db8ff, 0 3px 10px rgba(0, 0, 0, 0.3);
}

.mode-main {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.mode-button-label {
  font-size: 18px;
  font-weight: 700;
  color: #e9eef3;
  line-height: 1.2;
}

.mode-button-desc {
  font-size: 12px;
  color: #9fb6d3;
  line-height: 1.3;
}

.mode-button-active .mode-button-label {
  color: #ffffff;
}

.mode-button-active .mode-button-desc {
  color: #cfe4ff;
}

/* selected 时右侧小蓝三角箭头 */
.mode-button-arrow {
  width: 0;
  height: 0;
  border-top: 7px solid transparent;
  border-bottom: 7px solid transparent;
  border-left: 11px solid #4db8ff;
}

.hint-text {
  margin-top: 20px;
  font-size: 13px;
  color: #cfe0f5;
  background: rgba(22, 42, 66, 0.55);
  border-radius: 8px;
  padding: 8px 14px;
  line-height: 1.5;
}
