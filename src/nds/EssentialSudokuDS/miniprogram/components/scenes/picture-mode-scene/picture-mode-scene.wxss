/* picture-mode-scene.wxss — 原 DS 图画谜题子模式选择菜单 */
.picture-mode-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: #e9eef3;
}

.scene-bar {
  width: 100%;
  padding: 10px 12px;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 7px;
  border: 0.5px solid #e0e6ec;
  margin-bottom: 12px;
}

.scene-bar-text {
  font-size: 14px;
  color: #1565c0;
  font-weight: 600;
}

/* 原 DS 菜单图容器 (图片 128x256, 比例 1:2) */
.menu-panel {
  position: relative;
  width: 100%;
  max-width: 200px;
  border-radius: 10px;
  overflow: hidden;
  background: #ffffff;
  border: 0.5px solid #e0e6ec;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.menu-image {
  display: block;
  width: 100%;
  height: auto;
}

/* 热区层: 覆盖菜单文字行, 基于 256 高菜单的目测文字位置 */
.menu-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.mode-hit {
  position: absolute;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-left: 10%;
  box-sizing: border-box;
}

.mode-hit-hover {
  background: rgba(21, 101, 192, 0.12);
}

.mode-hit-active {
  background: rgba(21, 101, 192, 0.08);
}

.mode-hit-active .mode-arrow,
.mode-hit-hover .mode-arrow {
  opacity: 1;
}

/* 右侧小三角箭头 */
.mode-arrow {
  width: 0;
  height: 0;
  border-top: 6px solid transparent;
  border-bottom: 6px solid transparent;
  border-left: 10px solid #1565c0;
  opacity: 0;
  transition: opacity 0.08s ease;
}

/* 5 项按实际文字位置定位 */
.mode-hit-nankuro {
  top: 8%;
  height: 14%;
}

.mode-hit-nukuro {
  top: 24%;
  height: 13%;
}

.mode-hit-card {
  top: 42%;
  height: 13%;
}

.mode-hit-population {
  top: 58%;
  height: 17%;
}

.mode-hit-tutorial {
  top: 79%;
  height: 13%;
}

.hint-text {
  margin-top: 14px;
  font-size: 13px;
  color: #6b7a8a;
}
