/* picture-mode-scene.wxss — 图画谜题子模式选择 (2 个真实模式按钮, 深色玻璃主题) */
.picture-mode-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 8px 12px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  background: transparent;
}

.scene-bar {
  width: 100%;
  padding: 10px 12px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 7px;
  border: 1px solid rgba(182, 108, 229, 0.45);
  box-shadow: 0 2px 10px rgba(182, 108, 229, 0.14);
  margin-bottom: 16px;
}

.scene-bar-text {
  font-size: 14px;
  color: #6a3aa0;
  font-weight: 700;
}

/* 2 个按钮纵向列表 */
.mode-list {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  max-width: 280px;
  gap: 12px;
  margin-top: 10px;
}

/* normal 态: 白玻璃胶囊 + 紫边 (糖果亮底) */
.mode-button {
  position: relative;
  padding: 14px 16px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(182, 108, 229, 0.45);
  border-radius: 12px;
  box-shadow: 0 2px 10px rgba(182, 108, 229, 0.14);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  transition: background 0.08s ease, border-color 0.08s ease;
}

/* hover (按下瞬态) */
.mode-button-hover {
  background: rgba(182, 108, 229, 0.14);
  border-color: rgba(182, 108, 229, 0.65);
}

/* selected 态: 糖果紫实底 + 白字 + 亮起箭头 */
.mode-button-active {
  background: linear-gradient(180deg, #cf8ff5 0%, #b66ce5 60%, #a050d0 100%);
  border-color: #a050d0;
  box-shadow: 0 0 0 2px rgba(182, 108, 229, 0.5), 0 2px 10px rgba(182, 108, 229, 0.25);
}

.mode-main {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.mode-button-label {
  font-size: 18px;
  font-weight: 800;
  color: #6a3aa0;
  line-height: 1.2;
}

.mode-button-desc {
  font-size: 12px;
  color: #8f7ba6;
  line-height: 1.3;
}

.mode-button-active .mode-button-label {
  color: #ffffff;
}

.mode-button-active .mode-button-desc {
  color: rgba(255, 255, 255, 0.9);
}

/* selected 时右侧小三角箭头 (糖果紫) */
.mode-button-arrow {
  width: 0;
  height: 0;
  border-top: 7px solid transparent;
  border-bottom: 7px solid transparent;
  border-left: 11px solid #b66ce5;
}

.mode-button-active .mode-button-arrow {
  border-left-color: #ffffff;
}

.hint-text {
  margin-top: 20px;
  font-size: 13px;
  color: #5a4a80;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(182, 108, 229, 0.3);
  border-radius: 8px;
  padding: 8px 14px;
  line-height: 1.5;
}
