<view class="picture-mode-page">
  <!-- 返回条 -->
  <view class="scene-bar" bindtap="onBack">
    <text class="scene-bar-text">← 返回主菜单</text>
  </view>

  <!-- 原 DS pazl_select.nbm 子模式菜单 -->
  <view class="menu-panel">
    <image class="menu-image" src="{{menuUrl}}" mode="widthFix" lazy-load></image>
    <view class="menu-hit">
      <view
        class="mode-hit mode-hit-nankuro {{selectedId === 'nankuro' ? 'mode-hit-active' : ''}}"
        hover-class="mode-hit-hover"
        hover-stay-time="80"
        data-id="nankuro"
        bindtap="onTapMode"
      >
        <view class="mode-arrow"></view>
      </view>
      <view
        class="mode-hit mode-hit-nukuro {{selectedId === 'nukuro' ? 'mode-hit-active' : ''}}"
        hover-class="mode-hit-hover"
        hover-stay-time="80"
        data-id="nukuro"
        bindtap="onTapMode"
      >
        <view class="mode-arrow"></view>
      </view>
      <view
        class="mode-hit mode-hit-card {{selectedId === 'card' ? 'mode-hit-active' : ''}}"
        hover-class="mode-hit-hover"
        hover-stay-time="80"
        data-id="card"
        bindtap="onTapMode"
      >
        <view class="mode-arrow"></view>
      </view>
      <view
        class="mode-hit mode-hit-population {{selectedId === 'population' ? 'mode-hit-active' : ''}}"
        hover-class="mode-hit-hover"
        hover-stay-time="80"
        data-id="population"
        bindtap="onTapMode"
      >
        <view class="mode-arrow"></view>
      </view>
      <view
        class="mode-hit mode-hit-tutorial {{selectedId === 'tutorial' ? 'mode-hit-active' : ''}}"
        hover-class="mode-hit-hover"
        hover-stay-time="80"
        data-id="tutorial"
        bindtap="onTapMode"
      >
        <view class="mode-arrow"></view>
      </view>
    </view>
  </view>

  <view class="hint-text">请选择图画谜题模式</view>
</view>
