<view class="picture-mode-page">
  <!-- 返回条 -->
  <view class="scene-bar" bindtap="onBack">
    <text class="scene-bar-text">← 返回主菜单</text>
  </view>

  <!-- 2 个真实子模式文本按钮 (normal + selected 两态) -->
  <view class="mode-list">
    <view
      wx:for="{{modes}}"
      wx:key="id"
      class="mode-button {{selectedId === item.id ? 'mode-button-active' : ''}}"
      hover-class="mode-button-hover"
      hover-stay-time="80"
      data-id="{{item.id}}"
      bindtap="onTapMode"
    >
      <view class="mode-main">
        <text class="mode-button-label">{{item.label}}</text>
        <text class="mode-button-desc">{{item.desc}}</text>
      </view>
      <view wx:if="{{selectedId === item.id}}" class="mode-button-arrow"></view>
    </view>
  </view>

  <view class="hint-text">看行列的颜色计数提示，把隐藏图案一格一格涂出来</view>
</view>
