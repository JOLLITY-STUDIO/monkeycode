.pict-list-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 16rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: #e9eef3;
}

.list-banner {
  width: 100%;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e0e6ec;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-banner-image {
  width: 100%;
  height: 100%;
}

.list-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.list-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a4a5a;
  margin-bottom: 16rpx;
}

.cat-scroll {
  max-height: 900rpx;
  width: 100%;
}

.cat-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 16rpx;
  border-bottom: 1rpx solid #f2f4f6;
}

.cat-row:active {
  background: #f5f7f9;
}

.cat-label {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #2b3a4a;
}

.cat-count {
  font-size: 24rpx;
  color: #9aa7b4;
  margin-right: 12rpx;
}

.cat-arrow {
  font-size: 36rpx;
  color: #c0c8d0;
}