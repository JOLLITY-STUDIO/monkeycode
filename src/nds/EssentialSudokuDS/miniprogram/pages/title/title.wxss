.title-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0d1b2a;
  overflow: hidden;
  box-sizing: border-box;
}

.title-bg {
  width: 86%;
  height: auto;
  max-height: 70vh;
}

.tap-hint {
  margin-top: 48rpx;
  padding: 16rpx 56rpx;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.08);
}

.tap-hint-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.pulse {
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.55; transform: scale(0.96); }
}

.copyright {
  position: absolute;
  bottom: 48rpx;
  left: 0;
  width: 100%;
  text-align: center;
}

.copyright-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
}