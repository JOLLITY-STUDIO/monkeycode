.tutorial-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 16rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: #e9eef3;
}

.tut-banner {
  width: 100%;
  height: 260rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e0e6ec;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tut-banner-image {
  width: 100%;
  height: 100%;
}

.tut-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.tut-section {
  margin-bottom: 8rpx;
}

.tut-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b3a4a;
  margin-bottom: 12rpx;
}

.tut-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #5a6a7a;
  margin-bottom: 10rpx;
  white-space: pre-line;
}

.tut-divider {
  height: 1rpx;
  background: #eef1f4;
  margin: 20rpx 0;
}