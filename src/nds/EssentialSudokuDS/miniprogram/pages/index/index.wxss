/* pages/index/index.wxss — 单页场景控制器: 顶部广告位 + 场景过渡动画
   布局: page-root flex column → top-ad (状态栏留白+banner) + scene-area (flex:1 场景舞台)
   过渡: 旧场景 (leaving) 播放离场动画, 新场景 (entering) 播放进场动画,
         动画结束后 (index.ts 定时器) 才移除 leaving 层。
   只用 transform + opacity (GPU 友好, skyline 渲染器支持)。 */

/* 页面底色: V0.44 糖果提亮 (透出 bg-fx 亮背景; fade 交叉瞬间露出浅色更自然) */
page {
  background: #fff0f5;
}

/* 根容器: 全屏 flex 纵向 */
.page-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #fff0f5;
}

/* ---------- 顶部广告位 (V0.44: 半透明亮玻璃, 配糖果背景) ---------- */

.top-ad {
  flex-shrink: 0;
  padding: 8px 12px;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0.12) 100%);
}

/* banner 广告位: 亮玻璃占位 (V0.44 配糖果主题) */
.ad-slot {
  height: 10vh;
  min-height: 56px;
  max-height: 96px;
  border-radius: 10px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.68) 100%);
  border: 1px solid rgba(182, 108, 229, 0.35);
  box-shadow: 0 3px 12px rgba(255, 107, 129, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ad-slot-text {
  color: #b66ce5;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
}

/* ---------- 场景舞台 ---------- */

.scene-area {
  flex: 1;
  min-height: 0;
  position: relative;
  overflow: hidden;
}

/* 场景舞台: 填满场景区域, 两层叠加 */
.scene-stage {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

/* V0.49.4 兜底: 让所有 scene Component host 强制 absolute fill .scene-stage
   Skyline 下 Component 默认 inline-block / position:static,
   内部 height:100% 失效导致 flex:1/absolute 定位无法撑满 → 按钮/内容看不见 */
.scene-stage > title-scene,
.scene-stage > menu-scene,
.scene-stage > picture-mode-scene,
.scene-stage > select-scene,
.scene-stage > options-scene,
.scene-stage > tutorial-scene,
.scene-stage > staff-scene,
.scene-stage > about-scene,
.scene-stage > pict-list-scene,
.scene-stage > sudoku-scene,
.scene-stage > picture-scene {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* 离场场景浮在上层 */
.stage-leave-fade,
.stage-leave-forward,
.stage-leave-back,
.stage-leave-drill,
.stage-leave-retreat {
  z-index: 2;
}

/* 进场场景在下层 */
.stage-enter-fade,
.stage-enter-forward,
.stage-enter-back,
.stage-enter-drill,
.stage-enter-retreat {
  z-index: 1;
}

/* ---------- 关键帧 ---------- */

/* fade: 平级/启动切换, 交叉淡入淡出 */
@keyframes scene-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes scene-fade-out {
  from { opacity: 1; }
  to   { opacity: 0; }
}

/* forward (进入下级): 新场景整屏从右滑入, 旧场景向左 30% 淡出 */
@keyframes scene-slide-in-right {
  from { transform: translate3d(100%, 0, 0); opacity: 0.4; }
  to   { transform: translate3d(0, 0, 0); opacity: 1; }
}
@keyframes scene-slide-out-left {
  from { transform: translate3d(0, 0, 0); opacity: 1; }
  to   { transform: translate3d(-30%, 0, 0); opacity: 0; }
}

/* back (返回上级): 新场景从左 30% 滑入, 旧场景整屏向右滑出 */
@keyframes scene-slide-in-left {
  from { transform: translate3d(-30%, 0, 0); opacity: 0; }
  to   { transform: translate3d(0, 0, 0); opacity: 1; }
}
@keyframes scene-slide-out-right {
  from { transform: translate3d(0, 0, 0); opacity: 1; }
  to   { transform: translate3d(100%, 0, 0); opacity: 0.4; }
}

/* drill (下钻进对局): 新场景整屏从下滑入, 旧场景向上 30% 淡出 */
@keyframes scene-slide-in-up {
  from { transform: translate3d(0, 100%, 0); opacity: 0.4; }
  to   { transform: translate3d(0, 0, 0); opacity: 1; }
}
@keyframes scene-slide-out-up {
  from { transform: translate3d(0, 0, 0); opacity: 1; }
  to   { transform: translate3d(0, -30%, 0); opacity: 0; }
}

/* retreat (退出对局): 新场景从上 30% 滑入, 旧场景整屏向下滑出 */
@keyframes scene-slide-in-down {
  from { transform: translate3d(0, -30%, 0); opacity: 0; }
  to   { transform: translate3d(0, 0, 0); opacity: 1; }
}
@keyframes scene-slide-out-down {
  from { transform: translate3d(0, 0, 0); opacity: 1; }
  to   { transform: translate3d(0, 100%, 0); opacity: 0.4; }
}

/* ---------- 动画绑定 ---------- */

.stage-enter-fade {
  animation: scene-fade-in 0.28s ease both;
}
.stage-enter-forward {
  animation: scene-slide-in-right 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
.stage-enter-back {
  animation: scene-slide-in-left 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
.stage-enter-drill {
  animation: scene-slide-in-up 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
.stage-enter-retreat {
  animation: scene-slide-in-down 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.stage-leave-fade {
  animation: scene-fade-out 0.28s ease both;
}
.stage-leave-forward {
  animation: scene-slide-out-left 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
.stage-leave-back {
  animation: scene-slide-out-right 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
.stage-leave-drill {
  animation: scene-slide-out-up 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
.stage-leave-retreat {
  animation: scene-slide-out-down 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
