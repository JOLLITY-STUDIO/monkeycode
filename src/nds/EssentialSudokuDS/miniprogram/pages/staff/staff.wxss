/* pages/staff/staff.wxss - Staff 制作人员名单 */
page {
  background: #0a0a0a;
  height: 100%;
}

.staff-page {
  height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 24rpx 40rpx;
}

.staff-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.staff-image {
  width: 100%;
  border-radius: 12rpx;
  background: #1a1a1a;
}

.staff-footer {
  text-align: center;
  font-size: 24rpx;
  color: #777;
  padding: 40rpx 0 60rpx;
}
