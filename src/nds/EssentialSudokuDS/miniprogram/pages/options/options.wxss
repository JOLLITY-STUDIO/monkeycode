.options-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 16rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: #e9eef3;
}

.select3-banner {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #0d1b2a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.select3-image {
  width: 100%;
  height: 100%;
  opacity: 0.9;
}

.options-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 12rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.option-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.option-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #3a4a5a;
}

.option-slider {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.option-value {
  width: 72rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 28rpx;
  color: #1565c0;
  font-weight: 700;
}

.option-divider {
  height: 1rpx;
  background: #eef1f4;
  margin: 16rpx 0 8rpx;
}

.option-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #f2f4f6;
}

.option-action:active {
  background: #f5f7f9;
}

.option-action-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b3a4a;
}

.option-action-hint {
  font-size: 24rpx;
  color: #9aa7b4;
}