/* pages/index —— 还原 NDS 原版 Picross DS 风格（黄/白/黑） */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fffdf0;
  box-sizing: border-box;
  padding: 16rpx 20rpx 20rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  padding: 0;
  background: #ffd800;
  color: #111111;
  font-size: 40rpx;
  font-weight: 700;
  border-radius: 12rpx;
  border: 2rpx solid #111111;
  flex-shrink: 0;
}

.back-btn::after {
  border: none;
}

.back-btn.pressed {
  background: #ffb700;
}

.select-btn {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  background: #ffd800;
  color: #111111;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: 2rpx solid #111111;
  margin-right: 12rpx;
}

.select-btn::after {
  border: none;
}

.select-btn.pressed {
  background: #ffb700;
  color: #111111;
}

.title {
  color: #111111;
  font-size: 32rpx;
  font-weight: 700;
}

.stat {
  color: #333333;
  font-size: 26rpx;
  font-weight: 600;
}

.progress-wrap {
  height: 12rpx;
  background: #e0e0e0;
  border: 1rpx solid #999999;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 100%;
  background: #ffd800;
  border-radius: 6rpx;
  transition: width 0.2s;
}

.progress-bar.done {
  background: #ffb700;
}

/* G5: 失败进度条 */
.progress-bar.fail {
  background: #e60000;
}

/* 下屏 4:3 满屏（NDS 256x192 逻辑分辨率），渲染器内部整数缩放居中 */
.board {
  width: 100%;
  aspect-ratio: 4 / 3;
  max-height: 62vh;
  border-radius: 12rpx;
  margin: 0 auto;
}

/* F1: 失误红闪反馈 */
.board.flash {
  animation: flashRed 0.5s ease-out;
  box-shadow: 0 0 0 4rpx rgba(230, 0, 0, 0.6);
}

@keyframes flashRed {
  0% { box-shadow: 0 0 0 6rpx rgba(230, 0, 0, 0.9); }
  100% { box-shadow: 0 0 0 4rpx rgba(230, 0, 0, 0); }
}

.pressed {
  opacity: 0.75;
  transform: scale(0.97);
}

.toolbar {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.tool-btn {
  flex: 1;
  margin: 0 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #ffd800;
  color: #111111;
  border: 2rpx solid #111111;
  border-radius: 12rpx;
  line-height: 2.4;
}

.tool-btn::after {
  border: none;
}

.tool-btn.active {
  background: #111111;
  color: #ffd800;
}

.solved-mask {
  position: fixed;
  inset: 0;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.solved-card {
  width: 520rpx;
  background: #fffdf0;
  border: 4rpx solid #111111;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 0 #ffd800;
}

.pop-in {
  animation: popIn 0.35s ease-out;
}

@keyframes popIn {
  from { transform: scale(0.6); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.stars {
  display: flex;
  margin: 20rpx 0 4rpx;
}

.star {
  font-size: 64rpx;
  color: #d0d0d0;
  margin: 0 12rpx;
  animation: starIn 0.4s ease-out backwards;
}

.star.on {
  color: #ffd800;
}

.star.s1 { animation-delay: 0.25s; }
.star.s2 { animation-delay: 0.45s; }
.star.s3 { animation-delay: 0.65s; }

@keyframes starIn {
  from { transform: scale(0) rotate(-90deg); opacity: 0; }
  to { transform: scale(1) rotate(0); opacity: 1; }
}

.solved-title {
  color: #111111;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
}

/* G5: 失败卡片 */
.fail-card {
  border-color: #e60000;
  box-shadow: 0 8rpx 0 #e60000;
}

.fail-title {
  color: #e60000;
}

.solved-sub {
  color: #333333;
  font-size: 26rpx;
  margin: 16rpx 0 24rpx;
}

.btn-primary {
  background: #ffd800;
  color: #111111;
  border: 2rpx solid #111111;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  width: 80%;
  margin-bottom: 16rpx;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: #ffffff;
  color: #111111;
  border: 2rpx solid #111111;
  border-radius: 16rpx;
  font-size: 26rpx;
  width: 80%;
}

.btn-ghost::after {
  border: none;
}
