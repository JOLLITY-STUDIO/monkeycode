.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0f0f1a;
  box-sizing: border-box;
  padding: 16rpx 20rpx 20rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  padding: 0;
  background: #24243a;
  color: #e8ecf2;
  font-size: 40rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.back-btn::after {
  border: none;
}

.back-btn.pressed {
  background: #3b6fd4;
}

.title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.stat {
  color: #9aa3b8;
  font-size: 26rpx;
}

.progress-wrap {
  height: 12rpx;
  background: #24243a;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 100%;
  background: #3b6fd4;
  border-radius: 6rpx;
  transition: width 0.2s;
}

.progress-bar.done {
  background: #4caf50;
}

.board {
  flex: 1;
  width: 100%;
  min-height: 0;
  border-radius: 12rpx;
}

/* F1: 失误红闪反馈 */
.board.flash {
  animation: flashRed 0.5s ease-out;
  box-shadow: 0 0 0 4rpx rgba(210, 59, 59, 0.6);
}

@keyframes flashRed {
  0% { box-shadow: 0 0 0 6rpx rgba(210, 59, 59, 0.9); }
  100% { box-shadow: 0 0 0 4rpx rgba(210, 59, 59, 0); }
}

.pressed {
  opacity: 0.75;
  transform: scale(0.97);
}

.toolbar {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.tool-btn {
  flex: 1;
  margin: 0 6rpx;
  font-size: 24rpx;
  background: #24243a;
  color: #e8ecf2;
  border-radius: 12rpx;
  line-height: 2.6;
}

.tool-btn::after {
  border: none;
}

.tool-btn.active {
  background: #3b6fd4;
  color: #ffffff;
}

.solved-mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 10, 20, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.solved-card {
  width: 520rpx;
  background: #1c1c33;
  border: 1rpx solid #3b6fd4;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pop-in {
  animation: popIn 0.35s ease-out;
}

@keyframes popIn {
  from { transform: scale(0.6); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.stars {
  display: flex;
  margin: 20rpx 0 4rpx;
}

.star {
  font-size: 64rpx;
  color: #3a3a55;
  margin: 0 12rpx;
  animation: starIn 0.4s ease-out backwards;
}

.star.on {
  color: #ffd54f;
}

.star.s1 { animation-delay: 0.25s; }
.star.s2 { animation-delay: 0.45s; }
.star.s3 { animation-delay: 0.65s; }

@keyframes starIn {
  from { transform: scale(0) rotate(-90deg); opacity: 0; }
  to { transform: scale(1) rotate(0); opacity: 1; }
}

.solved-title {
  color: #4caf50;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.solved-sub {
  color: #9aa3b8;
  font-size: 26rpx;
  margin: 16rpx 0 24rpx;
}

.btn-primary {
  background: #3b6fd4;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  width: 80%;
  margin-bottom: 16rpx;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #9aa3b8;
  border-radius: 16rpx;
  font-size: 26rpx;
  width: 80%;
}

.btn-ghost::after {
  border: 1rpx solid #3a3a55;
}
