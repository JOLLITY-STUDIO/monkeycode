<view class="page">
  <!-- 顶部状态栏（F1：返回按钮 / 选关 / 计时 / 失误） -->
  <view class="topbar">
    <button class="back-btn" bindtap="onBack" hover-class="pressed">‹</button>
    <button class="select-btn" bindtap="onGoSelect" hover-class="pressed">{{t.selectBtn||'选择'}}</button>
    <text class="title">{{puzzleName}}</text>
    <text class="stat">⏱ {{timeText}}</text>
    <text class="stat">✕ {{mistakes}}/{{maxMistakes}}</text>
  </view>

  <!-- 进度条 -->
  <view class="progress-wrap">
    <view class="progress-bar {{solved ? 'done' : (failed ? 'fail' : '')}}" style="width: {{progress}}%;"></view>
  </view>

  <!-- 游戏画布（type=2d，触摸绘制） -->
  <canvas
    type="2d"
    id="board"
    class="board {{flashError ? 'flash' : ''}}"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
  ></canvas>

  <!-- 完成遮罩（E2：星级结算 + 动画） -->
  <view class="solved-mask" wx:if="{{solved}}">
    <view class="solved-card pop-in">
      <text class="solved-title">{{t.solvedTitle}}</text>
      <view class="stars">
        <text class="star {{stars >= 1 ? 'on' : ''}} s1">★</text>
        <text class="star {{stars >= 2 ? 'on' : ''}} s2">★</text>
        <text class="star {{stars >= 3 ? 'on' : ''}} s3">★</text>
      </view>
      <text class="solved-sub">{{t.timeLabel}} {{timeText}} · {{t.mistakeLabel}} {{mistakes}}</text>
      <button class="btn-primary" bindtap="onNext">{{t.nextBtn}}</button>
      <button class="btn-ghost" bindtap="onBack">{{t.backBtn}}</button>
    </view>
  </view>

  <!-- 失败遮罩（G5：5 次失误游戏结束） -->
  <view class="solved-mask" wx:if="{{failed}}">
    <view class="solved-card pop-in fail-card">
      <text class="solved-title fail-title">{{t.failedTitle}}</text>
      <text class="solved-sub">{{t.failedSub}}</text>
      <text class="solved-sub">{{t.timeLabel}} {{timeText}} · {{t.mistakeLabel}} {{mistakes}}/{{maxMistakes}}</text>
      <button class="btn-primary" bindtap="onReset">{{t.retryBtn}}</button>
      <button class="btn-ghost" bindtap="onBack">{{t.backBtn}}</button>
    </view>
  </view>

  <!-- 底部工具栏（F1：按压反馈） -->
  <view class="toolbar">
    <button class="tool-btn" bindtap="onPrev" hover-class="pressed">‹ {{t.prevBtn}}</button>
    <button
      class="tool-btn {{markMode === 'cross' ? 'active' : ''}}"
      bindtap="onToggleMark"
      hover-class="pressed"
    >{{markMode === 'cross' ? '✕ ' + t.markCross : '● ' + t.markFill}}</button>
    <button class="tool-btn" bindtap="onReset" hover-class="pressed">{{t.resetBtn}}</button>
    <button class="tool-btn" bindtap="onNext" hover-class="pressed">{{t.nextBtn}} ›</button>
  </view>
</view>
