<view class="page">
  <view class="header">
    <view class="title-row">
      <text class="title">Picross</text>
      <text class="sub">{{t.appTitle||'Picross DS'}}</text>
    </view>
    <view class="lang-row">
      <text class="lang-btn {{index === langIdx ? 'active' : ''}}"
            wx:for="{{langLabels}}" wx:key="*this" wx:for-index="index"
            data-idx="{{index}}" bindtap="onSwitchLang">{{item}}</text>
    </view>
  </view>

  <view class="cards">
    <view class="diff-card easy" data-diff="0" bindtap="onPick" hover-class="pressed">
      <text class="diff-name">{{diffs[0]}}</text>
      <text class="diff-meta">★ {{cleared[0]}}/{{totals[0]}}</text>
    </view>
    <view class="diff-card normal" data-diff="1" bindtap="onPick" hover-class="pressed">
      <text class="diff-name">{{diffs[1]}}</text>
      <text class="diff-meta">★ {{cleared[1]}}/{{totals[1]}}</text>
    </view>
    <view class="diff-card free" data-diff="2" bindtap="onPick" hover-class="pressed">
      <text class="diff-name">{{diffs[2]}}</text>
      <text class="diff-meta">★ {{cleared[2]}}/{{totals[2]}}</text>
    </view>
  </view>

  <view class="bottom-row">
    <button class="howto-btn" bindtap="onTutorial" hover-class="pressed">{{t.howtoTitle||'HOW TO PLAY'}}</button>
    <button class="progress-btn" bindtap="onProgress" hover-class="pressed">{{t.resumeBtn||'继续'}}</button>
  </view>
</view>
