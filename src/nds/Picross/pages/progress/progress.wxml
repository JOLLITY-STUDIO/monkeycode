<view class="page">
  <view class="header">
    <text class="title">{{t.resumeBtn||'继续'}} · Progress</text>
    <text class="sub">{{items.length}} in-progress</text>
  </view>

  <view class="empty" wx:if="{{empty}}">
    <text class="empty-icon">📭</text>
    <text>暂无保存的进度</text>
  </view>

  <view class="list" wx:else>
    <view class="row" wx:for="{{items}}" wx:key="puzzleId" wx:for-item="p">
      <view class="row-head">
        <text class="row-name">{{p.name}} #{{p.puzzleId}}</text>
        <text class="row-diff">{{p.diffLabel}}</text>
      </view>
      <view class="row-meta">
        <text>⏱ {{p.elapsedText}}  •  {{p.marksCount}}/{{p.totalCount}} cells</text>
        <text class="when">{{p.whenText}}</text>
      </view>
      <view class="row-actions">
        <button class="resume-btn" data-id="{{p.puzzleId}}" bindtap="onResume" hover-class="pressed">{{t.resumeBtn||'继续'}}</button>
        <button class="clear-btn" data-id="{{p.puzzleId}}" bindtap="onClear" hover-class="pressed">删除</button>
      </view>
    </view>
    <button class="clear-all" bindtap="onClearAll" hover-class="pressed">清空全部进度</button>
  </view>
</view>
