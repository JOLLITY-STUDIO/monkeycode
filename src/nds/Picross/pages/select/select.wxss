/* E1 拼图选择界面 —— 还原 NDS 原版 Picross DS 风格（黄/白/黑） */
.page {
  min-height: 100vh;
  background: #fffdf0;
  padding: 24rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.btn-group {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.play-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  background: #ffd800;
  color: #111111;
  font-size: 26rpx;
  font-weight: 700;
  border: 2rpx solid #111111;
  border-radius: 12rpx;
}

.play-btn::after,
.howto-btn::after {
  border: none;
}

.play-btn.pressed,
.howto-btn.pressed {
  opacity: 0.85;
  transform: scale(0.97);
}

/* How to Play 教程入口（白底黑描边） */
.howto-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  background: #ffffff;
  color: #111111;
  font-size: 24rpx;
  font-weight: 700;
  border: 2rpx solid #111111;
  border-radius: 12rpx;
}

.lang-row {
  display: flex;
  gap: 12rpx;
}

.lang-btn {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #333333;
  font-size: 24rpx;
  border: 2rpx solid #111111;
}

.lang-btn.active {
  background: #111111;
  color: #ffd800;
}

.title {
  color: #111111;
  font-size: 44rpx;
  font-weight: 800;
}

.sub {
  color: #333333;
  font-size: 26rpx;
  margin-top: 4rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.stat-chip {
  color: #111111;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.stat-bar {
  flex: 1;
  height: 16rpx;
  background: #e0e0e0;
  border: 2rpx solid #111111;
  border-radius: 6rpx;
  overflow: hidden;
}

.stat-fill {
  height: 100%;
  background: #ffd800;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.group-head {
  color: #111111;
  font-size: 28rpx;
  font-weight: 800;
  margin: 24rpx 0 12rpx;
  padding-left: 12rpx;
  border-left: 8rpx solid #ffd800;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.puzzle-card {
  width: calc((100% - 32rpx) / 3);
  background: #ffffff;
  border: 2rpx solid #111111;
  border-radius: 12rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.puzzle-card.cleared {
  border-color: #ffd800;
  box-shadow: 0 4rpx 0 #ffd800;
}

/* 拼图缩略图（ROM 真实解法位图） */
.p-thumb {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #111111;
  background: #ffffff;
}

.p-name {
  color: #111111;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.p-size {
  color: #666666;
  font-size: 20rpx;
  margin-top: 6rpx;
}

.p-stars {
  font-size: 20rpx;
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

.star {
  color: #d0d0d0;
}

.star.on {
  color: #ffd800;
}
