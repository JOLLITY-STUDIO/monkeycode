/* E1 拼图选择界面 —— 还原 NDS 原版 Picross DS 风格（黄/白/黑） */
.page {
  min-height: 100vh;
  background: #fffdf0;
  padding: 24rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.btn-group {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.play-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  background: #ffd800;
  color: #111111;
  font-size: 26rpx;
  font-weight: 700;
  border: 2rpx solid #111111;
  border-radius: 12rpx;
}

.play-btn::after,
.howto-btn::after {
  border: none;
}

.play-btn.pressed,
.howto-btn.pressed {
  opacity: 0.85;
  transform: scale(0.97);
}

/* How to Play 教程入口（白底黑描边） */
.howto-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  background: #ffffff;
  color: #111111;
  font-size: 24rpx;
  font-weight: 700;
  border: 2rpx solid #111111;
  border-radius: 12rpx;
}

.lang-row {
  display: flex;
  gap: 12rpx;
}

.lang-btn {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #333333;
  font-size: 24rpx;
  border: 2rpx solid #111111;
}

.lang-btn.active {
  background: #111111;
  color: #ffd800;
}

.title {
  color: #111111;
  font-size: 44rpx;
  font-weight: 800;
}

.sub {
  color: #333333;
  font-size: 26rpx;
  margin-top: 4rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.stat-chip {
  color: #111111;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.stat-bar {
  flex: 1;
  height: 16rpx;
  background: #e0e0e0;
  border: 2rpx solid #111111;
  border-radius: 6rpx;
  overflow: hidden;
}

.stat-fill {
  height: 100%;
  background: #ffd800;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* U1：分组标题 + 难度级进度条 */
.group-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 32rpx 0 12rpx;
  padding: 8rpx 12rpx;
  background: #fff8c8;
  border-left: 8rpx solid #ffd800;
  border-radius: 6rpx;
}

.gh-label {
  color: #111111;
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.gh-progress {
  color: #555;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.gh-bar {
  flex: 1;
  height: 12rpx;
  background: #e0e0e0;
  border: 1rpx solid #111;
  border-radius: 6rpx;
  overflow: hidden;
}

.gh-fill {
  height: 100%;
  background: #ffd800;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.puzzle-card {
  width: calc((100% - 32rpx) / 3);
  background: #ffffff;
  border: 2rpx solid #111111;
  border-radius: 12rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.puzzle-card.cleared {
  border-color: #ffd800;
  box-shadow: 0 4rpx 0 #ffd800;
}

/* U1：锁定卡片视觉（灰阶 + 锁遮罩 + 不可点状） */
.puzzle-card.locked {
  background: #f0f0f0;
  border-color: #b0b0b0;
  filter: grayscale(0.45);
  opacity: 0.92;
}

.puzzle-card.locked .p-name {
  color: #888;
}

/* 拼图缩略图（ROM 真实解法位图） */
.p-thumb {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #111111;
  background: #ffffff;
}

.p-thumb.lock-blur {
  filter: blur(4rpx) grayscale(0.8);
}

/* U1：锁遮罩：缩略图区中央放锁图标 */
.lock-overlay {
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.18);
  border-radius: 8rpx;
  pointer-events: none;
}

.lock-icon {
  font-size: 56rpx;
  color: #fff;
  text-shadow: 0 2rpx 0 #111;
}

.p-name {
  color: #111111;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.p-size {
  color: #666666;
  font-size: 20rpx;
  margin-top: 6rpx;
}

.p-stars {
  font-size: 20rpx;
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

.p-locked-hint {
  color: #888;
  font-size: 18rpx;
  margin-top: 6rpx;
  text-align: center;
}

.star {
  color: #d0d0d0;
}

.star.on {
  color: #ffd800;
}
