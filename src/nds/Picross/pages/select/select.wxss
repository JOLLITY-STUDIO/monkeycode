/* E1 拼图选择界面样式（TODO: 完整配色） */
.page {
  min-height: 100vh;
  background: #0f0f1a;
  padding: 24rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.lang-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.lang-btn {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #1c1c33;
  color: #9aa3b8;
  font-size: 24rpx;
}

.lang-btn.active {
  background: #3b6fd4;
  color: #ffffff;
}

.title {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
}

.sub {
  color: #9aa3b8;
  font-size: 26rpx;
  margin-top: 4rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.stat-chip {
  color: #ffd54f;
  font-size: 24rpx;
  flex-shrink: 0;
}

.stat-bar {
  flex: 1;
  height: 12rpx;
  background: #24243a;
  border-radius: 6rpx;
  overflow: hidden;
}

.stat-fill {
  height: 100%;
  background: linear-gradient(90deg, #3b6fd4, #4caf50);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.group-head {
  color: #3b6fd4;
  font-size: 28rpx;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.puzzle-card {
  width: calc((100% - 32rpx) / 3);
  background: #1c1c33;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.puzzle-card.cleared {
  border: 1rpx solid #3b6fd4;
}

.p-name {
  color: #e8ecf2;
  font-size: 24rpx;
  text-align: center;
}

.p-size {
  color: #9aa3b8;
  font-size: 20rpx;
  margin-top: 6rpx;
}

.p-stars {
  font-size: 20rpx;
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

.star {
  color: #3a3a55;
}

.star.on {
  color: #ffd54f;
}
