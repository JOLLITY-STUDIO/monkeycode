/* 教程页 —— 原版黄/白/黑主题，逐步交互教程 */
.page {
  min-height: 100vh;
  background: #fffdf0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

/* 顶部黄色标签条 */
.topbar {
  width: 100%;
  background: #ffd800;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 4rpx solid #111;
  margin: 0 -24rpx;
}
.topbar .title {
  font-size: 34rpx;
  font-weight: 900;
  color: #111;
  letter-spacing: 2rpx;
}
.skip-btn {
  background: transparent;
  color: #111;
  font-size: 26rpx;
  font-weight: 700;
  border: 3rpx solid #111;
  border-radius: 10rpx;
  padding: 6rpx 26rpx;
  line-height: 1.6;
}
.skip-btn.pressed { background: #ffb700; }

/* 教程进度条 */
.progress-row {
  width: 100%;
  height: 12rpx;
  background: #e0e0e0;
  border: 2rpx solid #999;
  border-radius: 6rpx;
  margin: 20rpx 0 8rpx;
  overflow: hidden;
  box-sizing: border-box;
}
.progress-fill {
  height: 100%;
  background: #ffd800;
  transition: width .3s ease;
}

/* 笔 / 叉 工具栏（原版左上角） */
.toolbar {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0 6rpx;
}
.mode-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  color: #111;
  font-size: 26rpx;
  font-weight: 800;
  border: 4rpx solid #111;
  border-radius: 12rpx;
  padding: 10rpx 24rpx;
  line-height: 1.4;
}
.mode-btn.active { background: #ffd800; }
.mode-btn.pressed { background: #ffb700; }
.pen-icon { font-size: 30rpx; line-height: 1; }
.x-icon { color: #e60000; font-size: 30rpx; font-weight: 900; line-height: 1; }
.mode-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 700;
  margin-left: auto;
}

/* 棋盘 */
.board-wrap {
  position: relative;
  width: 540rpx;
  margin-top: 10rpx;
}
.board {
  width: 540rpx;
  height: 540rpx;
  background: #fff;
  border: 4rpx solid #111;
  touch-action: none;
  box-sizing: border-box;
}

/* 完成遮罩 */
.solved-mask {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.solved-card {
  background: #fff;
  border: 4rpx solid #111;
  border-radius: 16rpx;
  padding: 30rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  max-width: 88%;
  box-sizing: border-box;
}
.solved-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #111;
  letter-spacing: 4rpx;
}
.solved-msg {
  font-size: 26rpx;
  color: #111;
  line-height: 1.6;
  text-align: center;
}
.btn-primary {
  background: #ffd800;
  color: #111;
  font-size: 30rpx;
  font-weight: 900;
  border: 4rpx solid #111;
  border-radius: 12rpx;
  padding: 12rpx 60rpx;
  line-height: 1.8;
}
.btn-primary.pressed { background: #ffb700; }
.pop-in { animation: pop .25s ease-out; }
@keyframes pop {
  0% { transform: scale(.7); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 错误提示 */
.err-box {
  width: 100%;
  margin-top: 14rpx;
  background: #ffe9e9;
  border: 4rpx solid #e60000;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  box-sizing: border-box;
  animation: shake .3s ease;
}
.err-text {
  color: #c00;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.6;
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}

/* ROM 教程文本消息框 */
.msg-box {
  width: 100%;
  margin-top: 14rpx;
  background: #fff;
  border: 4rpx solid #111;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.msg-scroll {
  height: 220rpx;
  width: 100%;
}
.msg-text {
  font-size: 28rpx;
  color: #111;
  line-height: 1.65;
  word-break: break-word;
}
.ok-btn {
  background: #ffd800;
  color: #111;
  font-size: 28rpx;
  font-weight: 900;
  border: 4rpx solid #111;
  border-radius: 12rpx;
  padding: 8rpx 70rpx;
  line-height: 1.8;
  min-width: 200rpx;
}
.ok-btn.pressed { background: #ffb700; }
