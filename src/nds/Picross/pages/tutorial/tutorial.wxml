<!-- 教程页（How to Play）—— 原版 Picross DS 交互式逐步教程（ROM 消息驱动） -->
<view class="page">
  <!-- 顶部黄色标签条 -->
  <view class="topbar">
    <text class="title">{{t.howtoTitle}}</text>
    <button class="skip-btn" bindtap="onSkip" hover-class="pressed">{{t.skipBtn}}</button>
  </view>

  <!-- 教程进度条 -->
  <view class="progress-row">
    <view class="progress-fill" style="width: {{stepIdx / totalSteps * 100}}%;"></view>
  </view>

  <!-- 笔 / 叉 工具栏（原版左上角） -->
  <view class="toolbar">
    <button class="mode-btn {{penMode ? 'active' : ''}}" bindtap="onSetPen" hover-class="pressed">
      <text class="pen-icon">✏</text><text>{{t.tutPen}}</text>
    </button>
    <button class="mode-btn {{!penMode ? 'active' : ''}}" bindtap="onSetX" hover-class="pressed">
      <text class="x-icon">✕</text><text>{{t.tutX}}</text>
    </button>
    <text class="mode-label">{{penMode ? t.tutPenMode : t.tutXMode}}</text>
  </view>

  <!-- 棋盘（5x5 原版教程拼图） -->
  <view class="board-wrap">
    <canvas
      type="2d"
      id="board"
      class="board"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    ></canvas>

    <!-- 完成遮罩 -->
    <view class="solved-mask" wx:if="{{solved}}">
      <view class="solved-card pop-in">
        <text class="solved-title">CLEAR!</text>
        <text class="solved-msg">{{solvedText}}</text>
        <button class="btn-primary" bindtap="onOk" hover-class="pressed">{{t.tutOk}}</button>
      </view>
    </view>
  </view>

  <!-- 错误提示（ROM 原文） -->
  <view class="err-box" wx:if="{{errText}}">
    <text class="err-text">{{errText}}</text>
  </view>

  <!-- ROM 教程文本消息框 -->
  <view class="msg-box">
    <scroll-view scroll-y class="msg-scroll">
      <text class="msg-text">{{msgText}}</text>
    </scroll-view>
    <button class="ok-btn" wx:if="{{showOk}}" bindtap="onOk" hover-class="pressed">{{t.tutOk}}</button>
  </view>
</view>
